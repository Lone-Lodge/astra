# astra_run — the single front door: source → Outcome.
#
# `run(source, name, args)` finds the plain rule named `name` and
# evaluates it.  `dispatch(source, event, args)` finds every `on Event`
# handler and merges their effects — the reactive entry point cubsy
# uses to wire user input to .astra scripts. `tick(source, ctx, prev)`
# fires every `when EXPR: body` rule on the false→true edge.
#
# Pure helper `fn` definitions live in the parser's function table and
# are forwarded to eval transparently — rules call them via expression
# `Call(name, args)` without any runtime ceremony.

use astra_value
use astra_outcome
use astra_ast
use astra_lexer
use astra_parser
use astra_eval
use log

pub extern fn orion_arena_active() -> int
pub extern fn orion_arena_on() -> int
pub extern fn orion_arena_off() -> int
pub extern fn orion_arena_reset() -> int
pub extern fn orion_persist_on() -> int
pub extern fn orion_persist_off() -> int

# What `compile` produces — rules, helper functions, evaluated consts
# and component declarations (the ECS auto-pack schema).
data Compiled: rules: [Rule], functions: [Function], consts: [Binding], components: [ComponentDecl]

# Lex + parse + (MVP: skip check) + evaluate the first rule by NAME.
# Errors at any stage collapse to an empty Outcome — atlas pipes silent
# refusals through, exactly how the Rust impl handles failed guards.
pub fn run(source: Text, rule_name: Text, args: [Value]) -> Outcome:
    c = compile(source)
    target = find_named_rule(c.rules, rule_name)
    if len(target.name) == 0:
        return empty()
    run_rule_args_ctx(target, args, c.consts, c.functions)

# Dispatch — fire every `on Event(...)` handler in `source` matching
# `event`. Merges all effects (order = source order).
# Invoke a pure helper `fn` by name with args; return its Value result.
# Lets Orion-side hosts call into astra-defined helpers for pixel math,
# piece catalog lookups, etc. — single source of truth in the .astra
# file, host stays a thin invoker.
pub fn eval_fn(source: Text, fn_name: Text, args: [Value]) -> Value:
    c = compile(source)
    f = find_fn(c.functions, fn_name)
    if f.name == "":
        NoneV
    else:
        env = bind_call_params(f.params, args, 0, c.consts)
        eval_in_env(f.body, env, c.functions)

fn find_fn(funcs: [Function], name: Text) -> Function:
    n = len(funcs)
    mut found = Function{name: "", params: [], return_type: "", body: LitInt(0)}
    for i in 0..<n:
        f = at(funcs, i)
        if f.name == name:
            found = f
    found

fn bind_call_params(params: [Param], args: [Value], i: int, acc: [Binding]) -> [Binding]:
    if i >= len(params):
        acc
    else:
        p = at(params, i)
        v = if i < len(args) then at(args, i) else NoneV
        bind_call_params(params, args, i + 1, push(acc, Binding{name: p.name, value: v}))

pub fn dispatch(source: Text, event: Text, args: [Value]) -> Outcome:
    dispatch_ctx(source, event, args, [])

# Dispatch with extra ctx bindings the handler body can reference as
# free names (e.g. `tray`, `blocks`). atlas_astra::astra_event_ctx
# auto-injects `tick`.
pub fn dispatch_ctx(source: Text, event: Text, args: [Value], ctx: [Binding]) -> Outcome:
    dispatch_with(compile(source), event, args, ctx)

# Short-key twin: dispatch-hot callers pass a stable bundle id so
# the cache lookup is a ~15-byte compare instead of rebuilding and
# comparing the whole source per call (6us/hit on a big bundle —
# a double-digit share of a dirty sims frame across the fixpoint).
pub fn dispatch_ctx_c(cid: Text, source: Text, event: Text, args: [Value], ctx: [Binding]) -> Outcome:
    dispatch_with(compile_c(cid, source), event, args, ctx)

fn dispatch_with(c: Compiled, event: Text, args: [Value], ctx: [Binding]) -> Outcome:
    full_ctx = merge_bindings(c.consts, ctx)
    # effects is owned (fresh []) until returned — in-place merge.
    mut effects = []
    for r in c.rules:
        if r.trigger == event:
            outcome = run_rule_args_ctx(r, args, full_ctx, c.functions)
            for e in outcome.effects:
                effects = push_mut(effects, e)
    Outcome{effects: effects, reads: []}

# Start from a fresh list — `mut out = a` would alias the cached consts
# and an in-place push would then append arena-lived ctx bindings INTO
# the compile cache. That was the wandering dangling-cache crash.
# push_mut is audited here BECAUSE out starts owned from [].
fn merge_bindings(a: [Binding], b: [Binding]) -> [Binding]:
    mut out = []
    for binding in a:
        out = push_mut(out, binding)
    for binding in b:
        out = push_mut(out, binding)
    out

# Result of a reactive tick. `truths` is parallel to the `when` rules in
# source order — true means "condition currently holds". The host stores
# this between ticks and passes it back as `prev_truths` so we can
# detect the false→true edge that fires the body.
pub data TickOutcome: outcome: Outcome, truths: [bool]

# Evaluate every `when EXPR: body` rule in `source` against the supplied
# context bindings. Fires the body on the false→true edge only —
# `prev_truths` carries last tick's per-rule state. First call should
# pass an empty list; subsequent calls pass the previous TickOutcome's
# `truths` so milestones don't re-fire every tick.
#
# Out-of-bounds prev_truths entries default to `false` (cold start), so
# any condition that's true on first tick fires once.
pub fn tick(source: Text, ctx: [Binding], prev_truths: [bool]) -> TickOutcome:
    tick_with(compile(source), ctx, prev_truths)

pub fn tick_c(cid: Text, source: Text, ctx: [Binding], prev_truths: [bool]) -> TickOutcome:
    tick_with(compile_c(cid, source), ctx, prev_truths)

fn tick_with(c: Compiled, ctx: [Binding], prev_truths: [bool]) -> TickOutcome:
    full_ctx = merge_bindings(c.consts, ctx)
    mut effects = []
    mut truths = []
    mut idx = 0
    for r in c.rules:
        if r.trigger == "$when":
            v = eval_in_env(r.condition, full_ctx, c.functions)
            now = value_is_truthy(v)
            was = prev_truth_at(prev_truths, idx)
            truths = push_mut(truths, now)
            if now and not was:
                outcome = run_rule_env(r, full_ctx, c.functions)
                for e in outcome.effects:
                    effects = push_mut(effects, e)
            idx = idx + 1
    TickOutcome{outcome: Outcome{effects: effects, reads: []}, truths: truths}

fn prev_truth_at(prev: [bool], i: int) -> bool:
    if i < 0 or i >= len(prev):
        false
    else:
        at(prev, i)

# Expose parse result so hosts can inspect component/entity declarations
# without depending directly on astra_lexer / astra_parser.
pub fn compile_parse_result(source: Text) -> ParseResult:
    lex_result = lex(source)
    if not lex_result.ok:
        return ParseResult{rules: [], functions: [], entities: [], consts: [], components: [], uses: [], ok: false, error: ParseError{message: lex_result.error.message, line: lex_result.error.line}}
    parse(lex_result.tokens)

pub extern fn orion_ledger_tag(name: Text) -> int
pub extern fn orion_ledger_off() -> int

pub fn compile(source: Text) -> Compiled:
    # Memoise on source text — the same script bundle is dispatched
    # every frame (60Hz) so lex+parse dominates without a cache.
    # Slot map keys on source directly; the runtime hashes the String
    # once per lookup, which is O(N) but a single memcmp vs re-lexing.
    # slot_has instead of type_of-probing — identical semantics
    # interpreted and native (native values carry no type tags).
    cache_key = "astra:compiled_v1:" + source
    if slot_has(cache_key):
        return slot_get(cache_key)
    # Compile INSIDE an arena epoch: tokens and parse garbage die at
    # the reset. Only the live tree is evacuated to persist below,
    # with the arena OFF (the arena outranks the persist scope while
    # on). Persisting the whole compile cost 4.4MB of permanent heap
    # for cubsy's 10KB of scripts; the live tree is a fraction of it.
    was_on = orion_arena_active()
    if was_on == 0:
        orion_arena_on()
    fresh = compile_fresh(source)
    orion_arena_off()
    orion_persist_on()
    orion_ledger_tag("astra-evac")
    safe = compiled_copy(fresh)
    slot_set(cache_key, safe)
    orion_ledger_off()
    orion_persist_off()
    if was_on == 1:
        orion_arena_on()
    if was_on == 0:
        # We owned the epoch: reclaim the garbage now. Arena content is
        # dead whenever the arena is off (epochs reset when they close).
        orion_arena_reset()
    safe

fn compiled_copy(c: Compiled) -> Compiled:
    Compiled{rules: ast_copy_rules(c.rules), functions: ast_copy_functions(c.functions), consts: copy_bindings(c.consts), components: ast_copy_components(c.components)}

fn copy_bindings(bs: [Binding]) -> [Binding]:
    n = len(bs)
    mut out = []
    for i in 0..<n:
        b = binding_at(bs, i)
        out = push_mut(out, Binding{name: "" + b.name, value: value_copy(b.value)})
    out

fn binding_at(bs: [Binding], i: int) -> Binding:
    at(bs, i)

# A bundle that fails to compile becomes an EMPTY program (rules just
# stop firing) — say WHY on the error channel instead of silently
# rendering nothing. astra_check gates hot reload the same way.
fn compile_fresh(source: Text) -> Compiled:
    lex_result = lex(source)
    if not lex_result.ok:
        le = lex_result.error
        lmsg = le.message
        lline = le.line
        log_error("astra", "lex failed line {lline}: {lmsg}")
        return Compiled{rules: [], functions: [], consts: [], components: []}
    parse_result = parse(lex_result.tokens)
    if not parse_result.ok:
        pe = parse_result.error
        pmsg = pe.message
        pline = pe.line
        log_error("astra", "parse failed line {pline}: {pmsg}")
        return Compiled{rules: [], functions: [], consts: [], components: []}
    consts = eval_consts(parse_result.consts, parse_result.functions, 0, [])
    Compiled{rules: parse_result.rules, functions: parse_result.functions, consts: consts, components: parse_result.components}

# Component declarations from the memoized compile — the ECS auto-pack
# path must not re-parse the bundle per dispatch.
pub fn compiled_components(source: Text) -> [ComponentDecl]:
    c = compile(source)
    c.components

fn eval_consts(decls: [ConstDecl], funcs: [Function], i: int, acc: [Binding]) -> [Binding]:
    if i >= len(decls):
        acc
    else:
        d = at(decls, i)
        v = eval_in_env(d.value, acc, funcs)
        eval_consts(decls, funcs, i + 1, push(acc, Binding{name: d.name, value: v}))

# Find first plain rule (no trigger) by name. Sentinel: empty Rule.
fn find_named_rule(rules: [Rule], name: Text) -> Rule:
    n = len(rules)
    mut found = empty_sentinel()
    for i in 0..<n:
        r = at(rules, i)
        if r.name == name and len(r.trigger) == 0:
            found = r
    found

fn empty_sentinel() -> Rule:
    Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}

# Warm the compile cache. compile() owns its epoch/evacuation dance —
# safe to call from anywhere (load, reload poll, mid-dispatch).
pub fn astra_warm(source: Text) -> int:
    c = compile(source)
    len(c.rules)

# ---- Short-key cache layer ----
# The content cache stays correct but its key IS the source: every
# lookup rebuilds and compares a bundle-sized string. Hot callers
# bind bundle -> tree ONCE under a short stable id; (re)load is the
# invalidation point — astra_warm_c recompiles by CONTENT (an edit
# misses the content cache) and rebinds the short key.
pub fn compile_c(cid: Text, source: Text) -> Compiled:
    tkey = "astra:t:" + cid
    if slot_has(tkey):
        return slot_get(tkey)
    c = compile(source)
    store_tree(tkey, c)
    c

pub fn astra_warm_c(cid: Text, source: Text) -> int:
    c = compile(source)
    store_tree("astra:t:" + cid, c)
    len(c.rules)

# The store runs with the arena OFF — the arena outranks persist,
# and a slot key copied into an open epoch is the wandering
# dangling-cache crash all over again.
fn store_tree(tkey: Text, c: Compiled):
    was_on = orion_arena_active()
    if was_on == 1:
        orion_arena_off()
    orion_persist_on()
    slot_set("" + tkey, c)
    orion_persist_off()
    if was_on == 1:
        orion_arena_on()

pub fn compiled_components_c(cid: Text, source: Text) -> [ComponentDecl]:
    c = compile_c(cid, source)
    c.components
