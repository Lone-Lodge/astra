# astra_run — the single front door: source → Outcome.
#
# `run(source, name, args)` finds the plain rule named `name` and
# evaluates it.  `dispatch(source, event, args)` finds every `on Event`
# handler and merges their effects — the reactive entry point a game
# uses to wire user input to .astra scripts. `tick(source, ctx, prev)`
# fires every `when EXPR: body` rule on the false→true edge.
#
# Pure helper `fn` definitions live in the parser's function table and
# are forwarded to eval transparently — rules call them via expression
# `Call(name, args)` without any runtime ceremony.

use log

public external define orion_arena_active() -> int
public external define orion_arena_on() -> int
public external define orion_arena_off() -> int
public external define orion_arena_reset() -> int
public external define orion_persist_on() -> int
public external define orion_persist_off() -> int

# What `compile` produces — rules, helper functions, evaluated consts
# and component declarations (the ECS auto-pack schema).
type Compiled: rules: [Rule], functions: [Function], consts: [Binding], components: [ComponentDecl], tests: [TestCase], enum_states: [EnumState]

# Lex + parse + (MVP: skip check) + evaluate the first rule by NAME.
# Errors at any stage collapse to an empty Outcome — atlas pipes silent
# refusals through, exactly how the Rust impl handles failed guards.
public define run(source: text, rule_name: text, args: [Value]) -> Outcome:
    c = compile(source)
    target = find_named_rule(c.rules, rule_name)
    if length(target.name) is 0:
        return empty()
    run_rule_args_ctx(target, args, c.consts, c.functions)

# Dispatch — fire every `on Event(...)` handler in `source` matching
# `event`. Merges all effects (order = source order).
# Invoke a pure helper `fn` by name with args; return its Value result.
# Lets Orion-side hosts call into astra-defined helpers for pixel math,
# piece catalog lookups, etc. — single source of truth in the .astra
# file, host stays a thin invoker.
public define eval_fn(source: text, fn_name: text, args: [Value]) -> Value:
    c = compile(source)
    f = find_fn(c.functions, fn_name)
    if f.name is "":
        NoneV
    else:
        env = bind_call_params(f.params, args, 0, c.consts)
        eval_in_env(f.body, env, c.functions)

define find_fn(funcs: [Function], name: text) -> Function:
    n = length(funcs)
    edit found = Function{name: "", params: [], return_type: "", body: LitInt(0)}
    loop i in 0 until n:
        f = funcs[i]
        if f.name is name:
            found = f
    found

define bind_call_params(params: [Param], args: [Value], i: number, acc: [Binding]) -> [Binding]:
    if i >= length(params):
        acc
    else:
        p = params[i]
        v = if i < length(args) then args[i] else NoneV
        bind_call_params(params, args, i + 1, append(acc, Binding{name: p.name, value: v}))

public define dispatch(source: text, event: text, args: [Value]) -> Outcome:
    dispatch_ctx(source, event, args, [])

# Dispatch with extra ctx bindings the handler body can reference as
# free names (e.g. `tray`, `blocks`). atlas_astra::astra_event_ctx
# auto-injects `tick`.
public define dispatch_ctx(source: text, event: text, args: [Value], ctx: [Binding]) -> Outcome:
    dispatch_with(compile(source), "", event, args, ctx)

# Short-key twin: dispatch-hot callers pass a stable bundle id so
# the cache lookup is a ~15-byte compare instead of rebuilding and
# comparing the whole source per call (6us/hit on a big bundle —
# a double-digit share of a dirty sims frame across the fixpoint).
public define dispatch_ctx_c(cid: text, source: text, event: text, args: [Value], ctx: [Binding]) -> Outcome:
    dispatch_with(compile_c(cid, source), cid, event, args, ctx)

define dispatch_with(c: Compiled, cid: text, event: text, args: [Value], ctx: [Binding]) -> Outcome:
    full_ctx = merge_bindings(c.consts, ctx)
    q_on = slot_has("astra:quar_on")
    # effects is owned (fresh []) until returned — in-place merge.
    edit effects = []
    edit ri = 0
    loop r in c.rules:
        if r.trigger is event:
            rid = rule_id(cid, r.name, event, ri)
            ri = ri + 1
            if not (q_on and slot_has("astra:quar:" + rid)):
                orion_crumb_rule(rid)
                outcome = run_rule_args_ctx(r, args, full_ctx, c.functions)
                loop e in outcome.effects:
                    effects = append(effects, e)
    Outcome{effects: effects, reads: []}

# A rule's identity for crumbs and quarantine: its own name when it
# has one, else its position among same-trigger rules (source order —
# stable per compile; shifts on script edits, which a session-lived
# quarantine tolerates). The parser stores the trigger AS the name for
# the `on Event():` form, so name is trigger means anonymous too.
define rule_id(cid: text, name: text, trig: text, i: number) -> text:
    if name is "" or name is trig then "{cid}/{trig}#{i}" else "{cid}/{name}"

# Start from a fresh list — `mut out = a` would alias the cached consts
# and an in-place push would then append arena-lived ctx bindings INTO
# the compile cache. That was the wandering dangling-cache crash.
# push_mut is audited here BECAUSE out starts owned from [].
define merge_bindings(a: [Binding], b: [Binding]) -> [Binding]:
    edit out = []
    loop binding in a:
        out = append(out, binding)
    loop binding in b:
        out = append(out, binding)
    out

# Result of a reactive tick. `truths` is parallel to the `when` rules in
# source order — true means "condition currently holds". The host stores
# this between ticks and passes it back as `prev_truths` so we can
# detect the false→true edge that fires the body.
public type TickOutcome: outcome: Outcome, truths: [truth]

# Evaluate every `when EXPR: body` rule in `source` against the supplied
# context bindings. Fires the body on the false→true edge only —
# `prev_truths` carries last tick's per-rule state. First call should
# pass an empty list; subsequent calls pass the previous TickOutcome's
# `truths` so milestones don't re-fire every tick.
#
# Out-of-bounds prev_truths entries default to `false` (cold start), so
# any condition that's true on first tick fires once.
public define tick(source: text, ctx: [Binding], prev_truths: [truth]) -> TickOutcome:
    tick_with(compile(source), "", ctx, prev_truths)

public define tick_c(cid: text, source: text, ctx: [Binding], prev_truths: [truth]) -> TickOutcome:
    tick_with(compile_c(cid, source), cid, ctx, prev_truths)

define tick_with(c: Compiled, cid: text, ctx: [Binding], prev_truths: [truth]) -> TickOutcome:
    full_ctx = merge_bindings(c.consts, ctx)
    q_on = slot_has("astra:quar_on")
    edit effects = []
    edit truths = []
    edit idx = 0
    loop r in c.rules:
        # A view/derive is a standing definition, not an event: recompute
        # it every pass with no edge test and no truths slot (the truths
        # bitmask is indexed by `$when` order — `idx` must not advance).
        if r.trigger is "$derive":
            outcome = run_rule_env(r, full_ctx, c.functions)
            loop e in outcome.effects:
                effects = append(effects, e)
        if r.trigger is "$when":
            v = eval_in_env(r.condition, full_ctx, c.functions)
            now = value_is_truthy(v)
            was = prev_truth_at(prev_truths, idx)
            truths = append(truths, now)
            if now and not was:
                rid = rule_id(cid, r.name, "$when", idx)
                # Cross-bundle patches: if this is a `cmd:X` and any
                # bundle declared `patch command X`, atlas set
                # `atlas:patched:X` at boot — skip the base fire.
                shadowed = rule_name_starts_with_local(r.name, "cmd:") and slot_has("atlas:patched:" + rule_name_strip_prefix_local(r.name, "cmd:"))
                if not shadowed and not (q_on and slot_has("astra:quar:" + rid)):
                    orion_crumb_rule(rid)
                    outcome = run_rule_env(r, full_ctx, c.functions)
                    loop e in outcome.effects:
                        effects = append(effects, e)
            idx = idx + 1
    TickOutcome{outcome: Outcome{effects: effects, reads: []}, truths: truths}

define prev_truth_at(prev: [truth], i: number) -> truth:
    if i < 0 or i >= length(prev):
        false
    else:
        prev[i]

# Expose parse result so hosts can inspect component/entity declarations
# without depending directly on astra_lexer / astra_parser.
public define compile_parse_result(source: text) -> ParseResult:
    lex_result = lex(source)
    if not lex_result.ok:
        return ParseResult{rules: [], functions: [], entities: [], consts: [], components: [], uses: [], tests: [], sources: [], ok: false, error: ParseError{message: lex_result.error.message, line: lex_result.error.line}}
    parse(lex_result.tokens)

public external define orion_ledger_tag(name: text) -> int
public external define orion_ledger_off() -> int
public external define orion_crumb_rule(rule: text)

public define compile(source: text) -> Compiled:
    # Memoise on source text — the same script bundle is dispatched
    # every frame (60Hz) so lex+parse dominates without a cache.
    # Slot map keys on source directly; the runtime hashes the String
    # once per lookup, which is O(N) but a single memcmp vs re-lexing.
    # slot_has instead of type_of-probing — identical semantics
    # interpreted and native (native values carry no type tags).
    cache_key = "astra:compiled_v1:" + source
    if slot_has(cache_key):
        return slot_get(cache_key)
    # Compile INSIDE an arena epoch: tokens and parse garbage die at
    # the reset. Only the live tree is evacuated to persist below,
    # with the arena OFF (the arena outranks the persist scope while
    # on). Persisting the whole compile cost 4.4MB of permanent heap
    # for a game's 10KB of scripts; the live tree is a fraction of it.
    was_on = orion_arena_active()
    if was_on is 0:
        orion_arena_on()
    fresh = compile_fresh(source)
    orion_arena_off()
    orion_persist_on()
    orion_ledger_tag("astra-evac")
    safe = compiled_copy(fresh)
    slot_set(cache_key, safe)
    orion_ledger_off()
    orion_persist_off()
    if was_on is 1:
        orion_arena_on()
    if was_on is 0:
        # We owned the epoch: reclaim the garbage now. Arena content is
        # dead whenever the arena is off (epochs reset when they close).
        orion_arena_reset()
    safe

define compiled_copy(c: Compiled) -> Compiled:
    Compiled{rules: ast_copy_rules(c.rules), functions: ast_copy_functions(c.functions), consts: copy_bindings(c.consts), components: ast_copy_components(c.components), tests: ast_copy_tests(c.tests), enum_states: c.enum_states}

define copy_bindings(bs: [Binding]) -> [Binding]:
    n = length(bs)
    edit out = []
    loop i in 0 until n:
        b = binding_at(bs, i)
        out = append(out, Binding{name: "" + b.name, value: value_copy(b.value)})
    out

define binding_at(bs: [Binding], i: number) -> Binding:
    bs[i]

# A bundle that fails to compile becomes an EMPTY program (rules just
# stop firing) — say WHY on the error channel instead of silently
# rendering nothing. astra_check gates hot reload the same way.
define compile_fresh(source: text) -> Compiled:
    lex_result = lex(source)
    if not lex_result.ok:
        le = lex_result.error
        lmsg = le.message
        lline = le.line
        error("astra", "lex failed line {lline}: {lmsg}")
        return Compiled{rules: [], functions: [], consts: [], components: [], tests: [], enum_states: []}
    parse_result = parse(lex_result.tokens)
    if not parse_result.ok:
        pe = parse_result.error
        pmsg = pe.message
        pline = pe.line
        error("astra", "parse failed line {pline}: {pmsg}")
        return Compiled{rules: [], functions: [], consts: [], components: [], tests: [], enum_states: []}
    # Templates desugar to functions — same shape (name, params, body Expr),
    # only the decl keyword differs. Merging them into `functions` lets
    # `eval_user_call` invoke templates without a separate registry.
    all_functions = template_functions_merged(parse_result.functions, parse_result.templates)
    consts = eval_consts(parse_result.consts, all_functions, 0, [])
    Compiled{rules: parse_result.rules, functions: all_functions, consts: consts, components: parse_result.components, tests: parse_result.tests, enum_states: parse_result.enum_states}

define template_functions_merged(fns: [Function], tmpls: [TemplateDecl]) -> [Function]:
    edit out = fns
    loop i in 0 until length(tmpls):
        t = template_at_local(tmpls, i)
        out = append(out, Function{name: t.name, params: t.params, return_type: "", body: t.body})
    out

define template_at_local(xs: [TemplateDecl], i: number) -> TemplateDecl:
    xs[i]

# Component declarations from the memoized compile — the ECS auto-pack
# path must not re-parse the bundle per dispatch.
public define compiled_components(source: text) -> [ComponentDecl]:
    c = compile(source)
    c.components

# Source declarations — extracted from a raw parse (bypasses the
# Compiled cache which drops them). Called once per bundle at boot.
# Text copies keep names/paths persistent past the arena reset.
public define compiled_sources(source: text) -> [SourceDecl]:
    pr = compile_parse_result(source)
    n = length(pr.sources)
    edit out = []
    loop i in 0 until n:
        s = source_at(pr.sources, i)
        out = append(out, SourceDecl{name: "" + s.name, kind: "" + s.kind, path: "" + s.path, refresh_ms: s.refresh_ms})
    out

define source_at(xs: [SourceDecl], i: number) -> SourceDecl:
    xs[i]

# Animation declarations — same evacuation pattern as sources.
public define compiled_animations(source: text) -> [AnimationDecl]:
    pr = compile_parse_result(source)
    n = length(pr.animations)
    edit out = []
    loop i in 0 until n:
        a = animation_at(pr.animations, i)
        out = append(out, AnimationDecl{name: "" + a.name, from_val: a.from_val, to_val: a.to_val, duration_ms: a.duration_ms, trigger_name: "" + a.trigger_name, trigger_value: a.trigger_value, easing: "" + a.easing})
    out

define animation_at(xs: [AnimationDecl], i: number) -> AnimationDecl:
    xs[i]

# Rule list from the memoized compile — atlas uses this at boot to
# scan for `patch:X` names and populate the cross-bundle patch index.
public define compiled_rules(source: text) -> [Rule]:
    c = compile(source)
    c.rules

# Asset declarations — same evacuation pattern.
public define compiled_assets(source: text) -> [AssetDecl]:
    pr = compile_parse_result(source)
    n = length(pr.assets)
    edit out = []
    loop i in 0 until n:
        a = asset_at(pr.assets, i)
        out = append(out, AssetDecl{name: "" + a.name, kind: "" + a.kind, path: "" + a.path})
    out

define asset_at(xs: [AssetDecl], i: number) -> AssetDecl:
    xs[i]

# Type→traits mapping: for each `type X uses A, B, C` in this bundle,
# the (X, [A, B, C]) pair. Atlas aggregates across bundles to answer
# trait-queries (`each e in Movable`).
public define compiled_type_traits(source: text) -> [TypeTraits]:
    pr = compile_parse_result(source)
    n = length(pr.type_traits)
    edit out = []
    loop i in 0 until n:
        tt = type_traits_at(pr.type_traits, i)
        edit copied_traits = []
        loop tname in tt.traits:
            copied_traits = append(copied_traits, "" + tname)
        out = append(out, TypeTraits{type_name: "" + tt.type_name, traits: copied_traits})
    out

define type_traits_at(xs: [TypeTraits], i: number) -> TypeTraits:
    xs[i]

# Template declarations — parameterised fragments. Atlas registers
# each by name; runtime callers (`items:` on Panel) invoke by name and
# bind args positionally. Body Expr is kept live for eval-time expansion.
public define compiled_templates(source: text) -> [TemplateDecl]:
    pr = compile_parse_result(source)
    n = length(pr.templates)
    edit out = []
    loop i in 0 until n:
        t = template_at(pr.templates, i)
        edit copied_params = []
        loop param in t.params:
            copied_params = append(copied_params, Param{name: "" + param.name, type_name: "" + param.type_name})
        out = append(out, TemplateDecl{name: "" + t.name, params: copied_params, body: t.body})
    out

define template_at(xs: [TemplateDecl], i: number) -> TemplateDecl:
    xs[i]

# Design-token blocks — `tokens NS: key: value, ...`. Atlas resolver
# joins `namespace + key` (e.g. `color.bg`) when a widget consumes
# `style:` or `layout:` attributes. Values are Expr — resolved lazily
# by the resolver so token refs can chain (`layout.card.padding: md`).
public define compiled_token_blocks(source: text) -> [TokensDecl]:
    pr = compile_parse_result(source)
    n = length(pr.token_blocks)
    edit out = []
    loop i in 0 until n:
        tb = token_block_at(pr.token_blocks, i)
        edit copied_entries = []
        loop entry in tb.entries:
            copied_entries = append(copied_entries, TokenEntry{key: "" + entry.key, value: entry.value})
        out = append(out, TokensDecl{namespace: "" + tb.namespace, entries: copied_entries})
    out

define token_block_at(xs: [TokensDecl], i: number) -> TokensDecl:
    xs[i]

# Style prop-bundles — `style NAME:` then indented `key: value`. Atlas
# loads these globally and merges them into a create's payload at spawn,
# so a style declared in one bundle styles a widget in another.
public define compiled_styles(source: text) -> [StyleDecl]:
    pr = compile_parse_result(source)
    n = length(pr.styles)
    edit out = []
    loop i in 0 until n:
        s = pr.styles[i]
        out = append(out, StyleDecl{name: "" + s.name, fields: s.fields})
    out

# Local byte-comparison helpers — astra_run's Orbit.toml doesn't pull
# in `text`, and the byte primitives are already reachable through the
# lexer chain. Kept locally so a later `use text` won't shadow.
define rule_name_starts_with_local(name: text, prefix: text) -> truth:
    name_bytes = bytes_of(name)
    prefix_bytes = bytes_of(prefix)
    name_len = length(name_bytes)
    prefix_len = length(prefix_bytes)
    if prefix_len > name_len:
        false
    else:
        edit equal_so_far = true
        loop ci in 0 until prefix_len:
            if name_bytes[ci] is not prefix_bytes[ci]:
                equal_so_far = false
        equal_so_far

define rule_name_strip_prefix_local(name: text, prefix: text) -> text:
    name_bytes = bytes_of(name)
    prefix_bytes = bytes_of(prefix)
    name_len = length(name_bytes)
    prefix_len = length(prefix_bytes)
    if prefix_len > name_len:
        name
    else:
        edit equal_so_far = true
        loop ci in 0 until prefix_len:
            if name_bytes[ci] is not prefix_bytes[ci]:
                equal_so_far = false
        if not equal_so_far:
            name
        else:
            edit suffix = []
            loop ci in prefix_len until name_len:
                suffix = append(suffix, name_bytes[ci])
            text_of(suffix)

define eval_consts(decls: [ConstDecl], funcs: [Function], i: number, acc: [Binding]) -> [Binding]:
    if i >= length(decls):
        acc
    else:
        d = decls[i]
        v = eval_in_env(d.value, acc, funcs)
        eval_consts(decls, funcs, i + 1, append(acc, Binding{name: d.name, value: v}))

# Find first plain rule (no trigger) by name. Sentinel: empty Rule.
define find_named_rule(rules: [Rule], name: text) -> Rule:
    n = length(rules)
    edit found = empty_sentinel()
    loop i in 0 until n:
        r = rules[i]
        if r.name is name and length(r.trigger) is 0:
            found = r
    found

define empty_sentinel() -> Rule:
    Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}

# Warm the compile cache. compile() owns its epoch/evacuation dance —
# safe to call from anywhere (load, reload poll, mid-dispatch).
public define astra_warm(source: text) -> number:
    c = compile(source)
    length(c.rules)

# ---- Short-key cache layer ----
# The content cache stays correct but its key IS the source: every
# lookup rebuilds and compares a bundle-sized string. Hot callers
# bind bundle -> tree ONCE under a short stable id; (re)load is the
# invalidation point — astra_warm_c recompiles by CONTENT (an edit
# misses the content cache) and rebinds the short key.
public define compile_c(cid: text, source: text) -> Compiled:
    tkey = "astra:t:" + cid
    if slot_has(tkey):
        return slot_get(tkey)
    c = compile(source)
    store_tree(tkey, c)
    c

public define astra_warm_c(cid: text, source: text) -> number:
    c = compile(source)
    store_tree("astra:t:" + cid, c)
    length(c.rules)

# The store runs with the arena OFF — the arena outranks persist,
# and a slot key copied into an open epoch is the wandering
# dangling-cache crash all over again.
define store_tree(tkey: text, c: Compiled):
    was_on = orion_arena_active()
    if was_on is 1:
        orion_arena_off()
    orion_persist_on()
    slot_set("" + tkey, c)
    orion_persist_off()
    if was_on is 1:
        orion_arena_on()

public define compiled_components_c(cid: text, source: text) -> [ComponentDecl]:
    c = compile_c(cid, source)
    c.components

# ---- Facts: rules as data (H2 — one machinery, three fruits) ----
# Per rule: what it reads (free names), writes (set targets), emits
# (channels), spawns (kinds), calls (helper fns). This IS the static
# footprint (deterministic parallelism), the AI query surface
# ("which rules write score?"), and the substrate for field-law
# linting. Locals (params, let, foreach vars) are subtracted.

public type RuleFacts: rule_name: text, trigger: text, reads: [text], writes: [text], emits: [text], spawns: [text], calls: [text]

type FAcc: reads: [text], writes: [text], emits: [text], spawns: [text], calls: [text], bound: [text]

public define astra_facts_c(cid: text, source: text) -> [RuleFacts]:
    c = compile_c(cid, source)
    # A rule's effect is not just its own body — it inherits everything
    # the helper functions it calls read and write. Without this, a
    # resource touched only inside a helper (a game's tray_x_end, read in
    # pixel_to_tray_slot) looks unread, and the scheduler would call two
    # rules independent when they clash through a shared helper. So:
    # facts each function, close them over the call graph, then fold the
    # called functions' closed facts into every rule.
    fnames = fn_names(c.functions)
    fbase = fn_facts_all(c.functions)
    fclosed = close_facts(fnames, fbase)
    n = length(c.rules)
    edit out = []
    loop i in 0 until n:
        rf = rule_facts(frule_at(c.rules, i))
        out = append(out, merge_callees(rf, fnames, fclosed))
    out

define frule_at(rs: [Rule], i: number) -> Rule:
    rs[i]

define ffn_at(fs: [Function], i: number) -> Function:
    fs[i]

define fn_names(fs: [Function]) -> [text]:
    n = length(fs)
    edit out = []
    loop i in 0 until n:
        out = append(out, ffn_at(fs, i).name)
    out

# Facts for one function body (params are bound, so not reads).
define fn_facts_of(f: Function) -> RuleFacts:
    edit bound = []
    np = length(f.params)
    loop i in 0 until np:
        bound = append(bound, fparam_at(f.params, i).name)
    a = expr_facts(f.body, FAcc{reads: [], writes: [], emits: [], spawns: [], calls: [], bound: bound})
    RuleFacts{rule_name: f.name, trigger: "fn", reads: a.reads, writes: a.writes, emits: a.emits, spawns: a.spawns, calls: a.calls}

define fn_facts_all(fs: [Function]) -> [RuleFacts]:
    n = length(fs)
    edit out = []
    loop i in 0 until n:
        out = append(out, fn_facts_of(ffn_at(fs, i)))
    out

define facts_idx(names: [text], name: text) -> number:
    n = length(names)
    loop i in 0 until n:
        if text_item(names, i) is name:
            return i
    0 - 1

define union_into(dst: [text], src: [text]) -> [text]:
    edit out = dst
    n = length(src)
    loop i in 0 until n:
        out = f_add(out, text_item(src, i))
    out

# Fold b's sets into a (union), keeping a's identity.
define merge_facts(a: RuleFacts, b: RuleFacts) -> RuleFacts:
    RuleFacts{rule_name: a.rule_name, trigger: a.trigger, reads: union_into(a.reads, b.reads), writes: union_into(a.writes, b.writes), emits: union_into(a.emits, b.emits), spawns: union_into(a.spawns, b.spawns), calls: union_into(a.calls, b.calls)}

# One propagation step: each fn absorbs its direct callees' facts.
define close_once(names: [text], facts: [RuleFacts]) -> [RuleFacts]:
    n = length(facts)
    edit out = []
    loop i in 0 until n:
        edit f = ffacts_at(facts, i)
        nc = length(f.calls)
        loop k in 0 until nc:
            ci = facts_idx(names, text_item(f.calls, k))
            if ci >= 0:
                f = merge_facts(f, ffacts_at(facts, ci))
        out = append(out, f)
    out

define ffacts_at(fs: [RuleFacts], i: number) -> RuleFacts:
    fs[i]

# Transitive closure by repeated propagation. Union is monotonic and
# the name set finite, so length(names) passes reach the fixpoint (cycles
# converge — union is idempotent).
define close_facts(names: [text], facts: [RuleFacts]) -> [RuleFacts]:
    edit cur = facts
    edit pass = 0
    limit = length(names)
    loop:
        if pass >= limit:
            break
        cur = close_once(names, cur)
        pass = pass + 1
    cur

# Fold every called function's closed facts into a rule.
define merge_callees(rf: RuleFacts, names: [text], fclosed: [RuleFacts]) -> RuleFacts:
    edit f = rf
    nc = length(rf.calls)
    loop k in 0 until nc:
        ci = facts_idx(names, text_item(rf.calls, k))
        if ci >= 0:
            f = merge_facts(f, ffacts_at(fclosed, ci))
    f

define rule_facts(r: Rule) -> RuleFacts:
    edit bound = []
    np = length(r.params)
    loop i in 0 until np:
        p = fparam_at(r.params, i)
        bound = append(bound, p.name)
    a0 = FAcc{reads: [], writes: [], emits: [], spawns: [], calls: [], bound: bound}
    a1 = expr_facts(r.condition, a0)
    a2 = stmts_facts(r.body, a1)
    RuleFacts{rule_name: r.name, trigger: r.trigger, reads: a2.reads, writes: a2.writes, emits: a2.emits, spawns: a2.spawns, calls: a2.calls}

define fparam_at(ps: [Param], i: number) -> Param:
    ps[i]

define f_has(xs: [text], x: text) -> truth:
    n = length(xs)
    loop i in 0 until n:
        if text_item(xs, i) is x:
            return true
    false

define text_item(xs: [text], i: number) -> text:
    xs[i]

define f_add(xs: [text], x: text) -> [text]:
    if f_has(xs, x) then xs else append(xs, x)

define f_read(a: FAcc, name: text) -> FAcc:
    if name is "_" or f_has(a.bound, name) then a else FAcc{reads: f_add(a.reads, name), writes: a.writes, emits: a.emits, spawns: a.spawns, calls: a.calls, bound: a.bound}

define f_callee(a: FAcc, callee: text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: a.emits, spawns: a.spawns, calls: f_add(a.calls, callee), bound: a.bound}

define f_bind(a: FAcc, name: text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: a.emits, spawns: a.spawns, calls: a.calls, bound: append(a.bound, name)}

define cq_facts(binder: text, src: Expr, pred: Expr, a: FAcc) -> FAcc:
    expr_facts(pred, f_bind(expr_facts(src, a), binder))

define letin_facts(name: text, v: Expr, body: Expr, a: FAcc) -> FAcc:
    expr_facts(body, f_bind(expr_facts(v, a), name))

define expr_facts(e: Expr, a: FAcc) -> FAcc:
    choose e:
        VarRef(name) then f_read(a, name)
        Binop(_, l, r) then expr_facts(r, expr_facts(l, a))
        Unop(_, x) then expr_facts(x, a)
        IfExpr(c, t, f) then expr_facts(f, expr_facts(t, expr_facts(c, a)))
        Call(callee, args) then exprs_facts(args, f_callee(a, callee))
        Field(base, _) then expr_facts(base, a)
        CountQuery(binder, src, pred) then cq_facts(binder, src, pred, a)
        LetIn(name, v, body) then letin_facts(name, v, body, a)
        LitList(xs) then exprs_facts(xs, a)
        MapLit(fs) then fields_facts(fs, a)
        RangeExpr(lo, hi) then expr_facts(hi, expr_facts(lo, a))
        MatchExpr(scrut, arms) then arms_facts(arms, expr_facts(scrut, a))
        _ then a

define exprs_facts(xs: [Expr], a: FAcc) -> FAcc:
    n = length(xs)
    edit acc = a
    loop i in 0 until n:
        acc = expr_facts(expr_item(xs, i), acc)
    acc

define expr_item(xs: [Expr], i: number) -> Expr:
    xs[i]

define fields_facts(fs: [FieldExpr], a: FAcc) -> FAcc:
    n = length(fs)
    edit acc = a
    loop i in 0 until n:
        fe = field_item(fs, i)
        acc = expr_facts(fe.value, acc)
    acc

define field_item(fs: [FieldExpr], i: number) -> FieldExpr:
    fs[i]

define arms_facts(arms: [MatchArm], a: FAcc) -> FAcc:
    n = length(arms)
    edit acc = a
    loop i in 0 until n:
        arm = arm_item(arms, i)
        acc = expr_facts(arm.body, expr_facts(arm.pattern, acc))
    acc

define arm_item(xs: [MatchArm], i: number) -> MatchArm:
    xs[i]

define stmts_facts(ss: [Stmt], a: FAcc) -> FAcc:
    n = length(ss)
    edit acc = a
    loop i in 0 until n:
        acc = stmt_facts(stmt_item(ss, i), acc)
    acc

define stmt_item(ss: [Stmt], i: number) -> Stmt:
    ss[i]

define f_emit(a: FAcc, name: text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: f_add(a.emits, name), spawns: a.spawns, calls: a.calls, bound: a.bound}

define f_spawn(a: FAcc, kind: text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: a.emits, spawns: f_add(a.spawns, kind), calls: a.calls, bound: a.bound}

define f_write(a: FAcc, name: text) -> FAcc:
    FAcc{reads: a.reads, writes: f_add(a.writes, name), emits: a.emits, spawns: a.spawns, calls: a.calls, bound: a.bound}

define let_facts(name: text, v: Expr, a: FAcc) -> FAcc:
    f_bind(expr_facts(v, a), name)

define letd_facts(names: [text], v: Expr, a: FAcc) -> FAcc:
    edit acc = expr_facts(v, a)
    nn = length(names)
    loop i in 0 until nn:
        acc = f_bind(acc, text_item(names, i))
    acc

define setvar_facts(name: text, v: Expr, a: FAcc) -> FAcc:
    f_write(expr_facts(v, a), name)

define foreach_facts(var: text, src: Expr, pred: Expr, body: [Stmt], a: FAcc) -> FAcc:
    stmts_facts(body, expr_facts(pred, f_bind(expr_facts(src, a), var)))

define stmt_facts(s: Stmt, a: FAcc) -> FAcc:
    choose s:
        EmitEffect(name, fs) then fields_facts(fs, f_emit(a, name))
        Require(e) then expr_facts(e, a)
        Let(name, v) then let_facts(name, v, a)
        LetDestructure(names, v) then letd_facts(names, v, a)
        SpawnEntity(kind, fs) then fields_facts(fs, f_spawn(a, kind))
        DestroyEntity(e) then expr_facts(e, a)
        SetField(base, _, v) then expr_facts(v, expr_facts(base, a))
        SetVar(name, v) then setvar_facts(name, v, a)
        ForEach(var, src, pred, body) then foreach_facts(var, src, pred, body, a)
        IfStmt(c, body) then stmts_facts(body, expr_facts(c, a))
        RelateStmt(src, k, tgt) then expr_facts(tgt, expr_facts(src, a))
        _ then a

# Unknown helper calls: valid = bundle fns + the three eval
# builtins. Live eval stays graceful (NoneV — hot-reload mid-edit
# must not crash the game); CHECK and TRY fail loud instead.
public define astra_unknown_calls_c(cid: text, source: text) -> text:
    c = compile_c(cid, source)
    facts = astra_facts_c(cid, source)
    n = length(facts)
    edit bad = []
    loop i in 0 until n:
        f = facts_at(facts, i)
        nc = length(f.calls)
        loop j in 0 until nc:
            callee = text_item(f.calls, j)
            if not call_is_known(c.functions, callee):
                bad = f_add(bad, callee)
    nb = length(bad)
    edit out = ""
    loop i in 0 until nb:
        out = if out is "" then "" + text_item(bad, i) else out + "," + text_item(bad, i)
    out

public define facts_at(xs: [RuleFacts], i: number) -> RuleFacts:
    xs[i]

define call_is_known(funcs: [Function], name: text) -> truth:
    if name is "size" or name is "at" or name is "concat" or name is "related":
        return true
    n = length(funcs)
    loop i in 0 until n:
        f = fn_item(funcs, i)
        if f.name is name:
            return true
    false

define fn_item(fs: [Function], i: number) -> Function:
    fs[i]

# ---- Check pass (astra_check surface) ----
# The loud well-formedness pass, off the hot path. Live dispatch stays
# graceful (unknown calls -> NoneV); this is what a tool/host runs to catch
# authoring mistakes before they silently no-op. Compiles by content, so an
# edit re-checks the new tree.
public define astra_check_source(source: text) -> [CheckError]:
    c = compile(source)
    check_program(c.rules, c.functions, c.enum_states)

public define astra_check_c(cid: text, source: text) -> [CheckError]:
    c = compile_c(cid, source)
    check_program(c.rules, c.functions, c.enum_states)

# One-line summary of the check pass — "" when the bundle is clean, else the
# errors joined "owner: message; owner: message". Mirrors the Text shape of
# astra_unknown_calls_c for CLI/log surfaces.
public define astra_check_text_c(cid: text, source: text) -> text:
    errs = astra_check_c(cid, source)
    n = length(errs)
    edit out = ""
    loop i in 0 until n:
        e = check_err_at(errs, i)
        line = "{e.rule}: {e.message}"
        out = if out is "" then line else out + "; " + line
    out

define check_err_at(errs: [CheckError], i: number) -> CheckError:
    errs[i]

# ---- Test runner (pillar 5: tests as syntax) ----
# Executes each `test NAME:` block from the parse (tests live in ParseResult,
# never in the arena-evacuated Compiled tree). A test runs its steps against a
# fresh effect accumulator + tick counter:
#   apply CALL   — run the named rule, fold its effects into the accumulator
#   tick N       — advance the tick counter (readable as `tick`)
#   expect COND  — assert (with `effects` bound to the running effect count)
# The first failing step stops the test. Returns one TestResult per test.
public type TestResult: name: text, passed: truth, message: text

type TState: effects: [AstraEffect], tickc: number, passed: truth, msg: text

public define run_tests(source: text) -> [TestResult]:
    # Use the evacuated Compiled (not raw compile_parse_result) so every rule,
    # helper, and test step is deep-copied into the persist heap — raw parse
    # output carries arena-lived Text that dangles once any epoch resets.
    c = compile(source)
    n = length(c.tests)
    edit out = []
    loop i in 0 until n:
        out = append(out, rt_run_one(rt_test_at(c.tests, i), c.rules, c.functions, c.consts))
    out

# One-line pass/fail summary — "" when every test passes, else the failing
# tests joined "name: message; ...".
public define run_tests_text(source: text) -> text:
    results = run_tests(source)
    n = length(results)
    edit out = ""
    loop i in 0 until n:
        r = rt_result_at(results, i)
        if not r.passed:
            line = "{r.name}: {r.message}"
            out = if out is "" then line else out + "; " + line
    out

define rt_test_at(ts: [TestCase], i: number) -> TestCase:
    ts[i]

define rt_result_at(rs: [TestResult], i: number) -> TestResult:
    rs[i]

define rt_step_at(ss: [TestStep], i: number) -> TestStep:
    ss[i]

define rt_run_one(tc: TestCase, rules: [Rule], funcs: [Function], consts: [Binding]) -> TestResult:
    st0 = TState{effects: [], tickc: 0, passed: true, msg: ""}
    stf = rt_fold(tc.steps, 0, st0, rules, funcs, consts)
    TestResult{name: tc.name, passed: stf.passed, message: stf.msg}

# Fold steps left-to-right, stopping at the first failure.
define rt_fold(steps: [TestStep], i: number, st: TState, rules: [Rule], funcs: [Function], consts: [Binding]) -> TState:
    if i >= length(steps) or not st.passed:
        st
    else:
        rt_fold(steps, i + 1, rt_step(rt_step_at(steps, i), st, rules, funcs, consts), rules, funcs, consts)

define rt_step(s: TestStep, st: TState, rules: [Rule], funcs: [Function], consts: [Binding]) -> TState:
    if s.kind is "apply":
        rt_apply(s.name, s.args, st, rules, funcs, consts)
    else:
        if s.kind is "tick":
            rt_tick(s.cond, st, funcs, consts)
        else:
            rt_expect(s.cond, st, funcs, consts)

define rt_apply(name: text, args: [Expr], st: TState, rules: [Rule], funcs: [Function], consts: [Binding]) -> TState:
    r = find_named_rule(rules, name)
    if length(r.name) is 0:
        TState{effects: st.effects, tickc: st.tickc, passed: false, msg: "apply: unknown rule `{name}`"}
    else:
        ctx = rt_base_ctx(consts, st.tickc)
        argvals = rt_eval_args(args, ctx, funcs, 0, [])
        oc = run_rule_args_ctx(r, argvals, ctx, funcs)
        TState{effects: rt_append(st.effects, oc.effects), tickc: st.tickc, passed: st.passed, msg: st.msg}

define rt_tick(nexpr: Expr, st: TState, funcs: [Function], consts: [Binding]) -> TState:
    ctx = rt_base_ctx(consts, st.tickc)
    delta = rt_int_of(eval_in_env(nexpr, ctx, funcs))
    TState{effects: st.effects, tickc: st.tickc + delta, passed: st.passed, msg: st.msg}

define rt_expect(cond: Expr, st: TState, funcs: [Function], consts: [Binding]) -> TState:
    env = rt_expect_env(consts, st.tickc, length(st.effects))
    if value_is_truthy(eval_in_env(cond, env, funcs)):
        st
    else:
        # Interpolation takes bare identifiers only (Orion codegen), so
        # precompute the effect count and tick into locals.
        ec = length(st.effects)
        tc = st.tickc
        TState{effects: st.effects, tickc: st.tickc, passed: false, msg: "expect failed (effects={ec}, tick={tc})"}

# ctx a rule body / tick expr sees: consts + the current `tick`.
define rt_base_ctx(consts: [Binding], tickc: number) -> [Binding]:
    edit out = []
    loop b in consts:
        out = append(out, b)
    out = append(out, Binding{name: "tick", value: IntV(tickc)})
    out

# ctx an `expect` sees: base + `effects` (the running effect count).
define rt_expect_env(consts: [Binding], tickc: number, effcount: number) -> [Binding]:
    edit out = rt_base_ctx(consts, tickc)
    out = append(out, Binding{name: "effects", value: IntV(effcount)})
    out

define rt_eval_args(args: [Expr], env: [Binding], funcs: [Function], i: number, acc: [Value]) -> [Value]:
    if i >= length(args):
        acc
    else:
        rt_eval_args(args, env, funcs, i + 1, append(acc, eval_in_env(rt_arg_at(args, i), env, funcs)))

define rt_arg_at(args: [Expr], i: number) -> Expr:
    args[i]

define rt_append(a: [AstraEffect], b: [AstraEffect]) -> [AstraEffect]:
    edit out = []
    loop e in a:
        out = append(out, e)
    loop e in b:
        out = append(out, e)
    out

define rt_int_of(v: Value) -> number:
    choose v:
        IntV(k) then k
        BoolV(b) then if b then 1 else 0
        RefV(k) then k
        _ then 0
