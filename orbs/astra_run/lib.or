# astra_run — the single front door: source → Outcome.
#
# `run(source, name, args)` finds the plain rule named `name` and
# evaluates it.  `dispatch(source, event, args)` finds every `on Event`
# handler and merges their effects — the reactive entry point cubsy
# uses to wire user input to .astra scripts. `tick(source, ctx, prev)`
# fires every `when EXPR: body` rule on the false→true edge.
#
# Pure helper `fn` definitions live in the parser's function table and
# are forwarded to eval transparently — rules call them via expression
# `Call(name, args)` without any runtime ceremony.

use astra_value
use astra_outcome
use astra_ast
use astra_lexer
use astra_parser
use astra_eval
use log

pub extern fn orion_arena_active() -> int
pub extern fn orion_arena_on() -> int
pub extern fn orion_arena_off() -> int
pub extern fn orion_arena_reset() -> int
pub extern fn orion_persist_on() -> int
pub extern fn orion_persist_off() -> int

# What `compile` produces — rules, helper functions, evaluated consts
# and component declarations (the ECS auto-pack schema).
data Compiled: rules: [Rule], functions: [Function], consts: [Binding], components: [ComponentDecl]

# Lex + parse + (MVP: skip check) + evaluate the first rule by NAME.
# Errors at any stage collapse to an empty Outcome — atlas pipes silent
# refusals through, exactly how the Rust impl handles failed guards.
pub fn run(source: Text, rule_name: Text, args: [Value]) -> Outcome:
    c = compile(source)
    target = find_named_rule(c.rules, rule_name)
    if len(target.name) == 0:
        return empty()
    run_rule_args_ctx(target, args, c.consts, c.functions)

# Dispatch — fire every `on Event(...)` handler in `source` matching
# `event`. Merges all effects (order = source order).
# Invoke a pure helper `fn` by name with args; return its Value result.
# Lets Orion-side hosts call into astra-defined helpers for pixel math,
# piece catalog lookups, etc. — single source of truth in the .astra
# file, host stays a thin invoker.
pub fn eval_fn(source: Text, fn_name: Text, args: [Value]) -> Value:
    c = compile(source)
    f = find_fn(c.functions, fn_name)
    if f.name == "":
        NoneV
    else:
        env = bind_call_params(f.params, args, 0, c.consts)
        eval_in_env(f.body, env, c.functions)

fn find_fn(funcs: [Function], name: Text) -> Function:
    n = len(funcs)
    mut found = Function{name: "", params: [], return_type: "", body: LitInt(0)}
    for i in 0..<n:
        f = at(funcs, i)
        if f.name == name:
            found = f
    found

fn bind_call_params(params: [Param], args: [Value], i: int, acc: [Binding]) -> [Binding]:
    if i >= len(params):
        acc
    else:
        p = at(params, i)
        v = if i < len(args) then at(args, i) else NoneV
        bind_call_params(params, args, i + 1, push(acc, Binding{name: p.name, value: v}))

pub fn dispatch(source: Text, event: Text, args: [Value]) -> Outcome:
    dispatch_ctx(source, event, args, [])

# Dispatch with extra ctx bindings the handler body can reference as
# free names (e.g. `tray`, `blocks`). atlas_astra::astra_event_ctx
# auto-injects `tick`.
pub fn dispatch_ctx(source: Text, event: Text, args: [Value], ctx: [Binding]) -> Outcome:
    dispatch_with(compile(source), "", event, args, ctx)

# Short-key twin: dispatch-hot callers pass a stable bundle id so
# the cache lookup is a ~15-byte compare instead of rebuilding and
# comparing the whole source per call (6us/hit on a big bundle —
# a double-digit share of a dirty sims frame across the fixpoint).
pub fn dispatch_ctx_c(cid: Text, source: Text, event: Text, args: [Value], ctx: [Binding]) -> Outcome:
    dispatch_with(compile_c(cid, source), cid, event, args, ctx)

fn dispatch_with(c: Compiled, cid: Text, event: Text, args: [Value], ctx: [Binding]) -> Outcome:
    full_ctx = merge_bindings(c.consts, ctx)
    q_on = slot_has("astra:quar_on")
    # effects is owned (fresh []) until returned — in-place merge.
    mut effects = []
    mut ri = 0
    for r in c.rules:
        if r.trigger == event:
            rid = rule_id(cid, r.name, event, ri)
            ri = ri + 1
            if not (q_on and slot_has("astra:quar:" + rid)):
                orion_crumb_rule(rid)
                outcome = run_rule_args_ctx(r, args, full_ctx, c.functions)
                for e in outcome.effects:
                    effects = push_mut(effects, e)
    Outcome{effects: effects, reads: []}

# A rule's identity for crumbs and quarantine: its own name when it
# has one, else its position among same-trigger rules (source order —
# stable per compile; shifts on script edits, which a session-lived
# quarantine tolerates). The parser stores the trigger AS the name for
# the `on Event():` form, so name==trigger means anonymous too.
fn rule_id(cid: Text, name: Text, trig: Text, i: int) -> Text:
    if name == "" or name == trig then "{cid}/{trig}#{i}" else "{cid}/{name}"

# Start from a fresh list — `mut out = a` would alias the cached consts
# and an in-place push would then append arena-lived ctx bindings INTO
# the compile cache. That was the wandering dangling-cache crash.
# push_mut is audited here BECAUSE out starts owned from [].
fn merge_bindings(a: [Binding], b: [Binding]) -> [Binding]:
    mut out = []
    for binding in a:
        out = push_mut(out, binding)
    for binding in b:
        out = push_mut(out, binding)
    out

# Result of a reactive tick. `truths` is parallel to the `when` rules in
# source order — true means "condition currently holds". The host stores
# this between ticks and passes it back as `prev_truths` so we can
# detect the false→true edge that fires the body.
pub data TickOutcome: outcome: Outcome, truths: [bool]

# Evaluate every `when EXPR: body` rule in `source` against the supplied
# context bindings. Fires the body on the false→true edge only —
# `prev_truths` carries last tick's per-rule state. First call should
# pass an empty list; subsequent calls pass the previous TickOutcome's
# `truths` so milestones don't re-fire every tick.
#
# Out-of-bounds prev_truths entries default to `false` (cold start), so
# any condition that's true on first tick fires once.
pub fn tick(source: Text, ctx: [Binding], prev_truths: [bool]) -> TickOutcome:
    tick_with(compile(source), "", ctx, prev_truths)

pub fn tick_c(cid: Text, source: Text, ctx: [Binding], prev_truths: [bool]) -> TickOutcome:
    tick_with(compile_c(cid, source), cid, ctx, prev_truths)

fn tick_with(c: Compiled, cid: Text, ctx: [Binding], prev_truths: [bool]) -> TickOutcome:
    full_ctx = merge_bindings(c.consts, ctx)
    q_on = slot_has("astra:quar_on")
    mut effects = []
    mut truths = []
    mut idx = 0
    for r in c.rules:
        if r.trigger == "$when":
            v = eval_in_env(r.condition, full_ctx, c.functions)
            now = value_is_truthy(v)
            was = prev_truth_at(prev_truths, idx)
            truths = push_mut(truths, now)
            if now and not was:
                rid = rule_id(cid, r.name, "$when", idx)
                if not (q_on and slot_has("astra:quar:" + rid)):
                    orion_crumb_rule(rid)
                    outcome = run_rule_env(r, full_ctx, c.functions)
                    for e in outcome.effects:
                        effects = push_mut(effects, e)
            idx = idx + 1
    TickOutcome{outcome: Outcome{effects: effects, reads: []}, truths: truths}

fn prev_truth_at(prev: [bool], i: int) -> bool:
    if i < 0 or i >= len(prev):
        false
    else:
        at(prev, i)

# Expose parse result so hosts can inspect component/entity declarations
# without depending directly on astra_lexer / astra_parser.
pub fn compile_parse_result(source: Text) -> ParseResult:
    lex_result = lex(source)
    if not lex_result.ok:
        return ParseResult{rules: [], functions: [], entities: [], consts: [], components: [], uses: [], ok: false, error: ParseError{message: lex_result.error.message, line: lex_result.error.line}}
    parse(lex_result.tokens)

pub extern fn orion_ledger_tag(name: Text) -> int
pub extern fn orion_ledger_off() -> int
pub extern fn orion_crumb_rule(rule: Text)

pub fn compile(source: Text) -> Compiled:
    # Memoise on source text — the same script bundle is dispatched
    # every frame (60Hz) so lex+parse dominates without a cache.
    # Slot map keys on source directly; the runtime hashes the String
    # once per lookup, which is O(N) but a single memcmp vs re-lexing.
    # slot_has instead of type_of-probing — identical semantics
    # interpreted and native (native values carry no type tags).
    cache_key = "astra:compiled_v1:" + source
    if slot_has(cache_key):
        return slot_get(cache_key)
    # Compile INSIDE an arena epoch: tokens and parse garbage die at
    # the reset. Only the live tree is evacuated to persist below,
    # with the arena OFF (the arena outranks the persist scope while
    # on). Persisting the whole compile cost 4.4MB of permanent heap
    # for cubsy's 10KB of scripts; the live tree is a fraction of it.
    was_on = orion_arena_active()
    if was_on == 0:
        orion_arena_on()
    fresh = compile_fresh(source)
    orion_arena_off()
    orion_persist_on()
    orion_ledger_tag("astra-evac")
    safe = compiled_copy(fresh)
    slot_set(cache_key, safe)
    orion_ledger_off()
    orion_persist_off()
    if was_on == 1:
        orion_arena_on()
    if was_on == 0:
        # We owned the epoch: reclaim the garbage now. Arena content is
        # dead whenever the arena is off (epochs reset when they close).
        orion_arena_reset()
    safe

fn compiled_copy(c: Compiled) -> Compiled:
    Compiled{rules: ast_copy_rules(c.rules), functions: ast_copy_functions(c.functions), consts: copy_bindings(c.consts), components: ast_copy_components(c.components)}

fn copy_bindings(bs: [Binding]) -> [Binding]:
    n = len(bs)
    mut out = []
    for i in 0..<n:
        b = binding_at(bs, i)
        out = push_mut(out, Binding{name: "" + b.name, value: value_copy(b.value)})
    out

fn binding_at(bs: [Binding], i: int) -> Binding:
    at(bs, i)

# A bundle that fails to compile becomes an EMPTY program (rules just
# stop firing) — say WHY on the error channel instead of silently
# rendering nothing. astra_check gates hot reload the same way.
fn compile_fresh(source: Text) -> Compiled:
    lex_result = lex(source)
    if not lex_result.ok:
        le = lex_result.error
        lmsg = le.message
        lline = le.line
        log_error("astra", "lex failed line {lline}: {lmsg}")
        return Compiled{rules: [], functions: [], consts: [], components: []}
    parse_result = parse(lex_result.tokens)
    if not parse_result.ok:
        pe = parse_result.error
        pmsg = pe.message
        pline = pe.line
        log_error("astra", "parse failed line {pline}: {pmsg}")
        return Compiled{rules: [], functions: [], consts: [], components: []}
    consts = eval_consts(parse_result.consts, parse_result.functions, 0, [])
    Compiled{rules: parse_result.rules, functions: parse_result.functions, consts: consts, components: parse_result.components}

# Component declarations from the memoized compile — the ECS auto-pack
# path must not re-parse the bundle per dispatch.
pub fn compiled_components(source: Text) -> [ComponentDecl]:
    c = compile(source)
    c.components

fn eval_consts(decls: [ConstDecl], funcs: [Function], i: int, acc: [Binding]) -> [Binding]:
    if i >= len(decls):
        acc
    else:
        d = at(decls, i)
        v = eval_in_env(d.value, acc, funcs)
        eval_consts(decls, funcs, i + 1, push(acc, Binding{name: d.name, value: v}))

# Find first plain rule (no trigger) by name. Sentinel: empty Rule.
fn find_named_rule(rules: [Rule], name: Text) -> Rule:
    n = len(rules)
    mut found = empty_sentinel()
    for i in 0..<n:
        r = at(rules, i)
        if r.name == name and len(r.trigger) == 0:
            found = r
    found

fn empty_sentinel() -> Rule:
    Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}

# Warm the compile cache. compile() owns its epoch/evacuation dance —
# safe to call from anywhere (load, reload poll, mid-dispatch).
pub fn astra_warm(source: Text) -> int:
    c = compile(source)
    len(c.rules)

# ---- Short-key cache layer ----
# The content cache stays correct but its key IS the source: every
# lookup rebuilds and compares a bundle-sized string. Hot callers
# bind bundle -> tree ONCE under a short stable id; (re)load is the
# invalidation point — astra_warm_c recompiles by CONTENT (an edit
# misses the content cache) and rebinds the short key.
pub fn compile_c(cid: Text, source: Text) -> Compiled:
    tkey = "astra:t:" + cid
    if slot_has(tkey):
        return slot_get(tkey)
    c = compile(source)
    store_tree(tkey, c)
    c

pub fn astra_warm_c(cid: Text, source: Text) -> int:
    c = compile(source)
    store_tree("astra:t:" + cid, c)
    len(c.rules)

# The store runs with the arena OFF — the arena outranks persist,
# and a slot key copied into an open epoch is the wandering
# dangling-cache crash all over again.
fn store_tree(tkey: Text, c: Compiled):
    was_on = orion_arena_active()
    if was_on == 1:
        orion_arena_off()
    orion_persist_on()
    slot_set("" + tkey, c)
    orion_persist_off()
    if was_on == 1:
        orion_arena_on()

pub fn compiled_components_c(cid: Text, source: Text) -> [ComponentDecl]:
    c = compile_c(cid, source)
    c.components

# ---- Facts: rules as data (H2 — one machinery, three fruits) ----
# Per rule: what it reads (free names), writes (set targets), emits
# (channels), spawns (kinds), calls (helper fns). This IS the static
# footprint (deterministic parallelism), the AI query surface
# ("which rules write score?"), and the substrate for field-law
# linting. Locals (params, let, foreach vars) are subtracted.

pub data RuleFacts: rule_name: Text, trigger: Text, reads: [Text], writes: [Text], emits: [Text], spawns: [Text], calls: [Text]

data FAcc: reads: [Text], writes: [Text], emits: [Text], spawns: [Text], calls: [Text], bound: [Text]

pub fn astra_facts_c(cid: Text, source: Text) -> [RuleFacts]:
    c = compile_c(cid, source)
    # A rule's effect is not just its own body — it inherits everything
    # the helper functions it calls read and write. Without this, a
    # resource touched only inside a helper (cubsy's tray_x_end, read in
    # pixel_to_tray_slot) looks unread, and the scheduler would call two
    # rules independent when they clash through a shared helper. So:
    # facts each function, close them over the call graph, then fold the
    # called functions' closed facts into every rule.
    fnames = fn_names(c.functions)
    fbase = fn_facts_all(c.functions)
    fclosed = close_facts(fnames, fbase)
    n = len(c.rules)
    mut out = []
    for i in 0..<n:
        rf = rule_facts(frule_at(c.rules, i))
        out = push_mut(out, merge_callees(rf, fnames, fclosed))
    out

fn frule_at(rs: [Rule], i: int) -> Rule:
    at(rs, i)

fn ffn_at(fs: [Function], i: int) -> Function:
    at(fs, i)

fn fn_names(fs: [Function]) -> [Text]:
    n = len(fs)
    mut out = []
    for i in 0..<n:
        out = push_mut(out, ffn_at(fs, i).name)
    out

# Facts for one function body (params are bound, so not reads).
fn fn_facts_of(f: Function) -> RuleFacts:
    mut bound = []
    np = len(f.params)
    for i in 0..<np:
        bound = push_mut(bound, fparam_at(f.params, i).name)
    a = expr_facts(f.body, FAcc{reads: [], writes: [], emits: [], spawns: [], calls: [], bound: bound})
    RuleFacts{rule_name: f.name, trigger: "fn", reads: a.reads, writes: a.writes, emits: a.emits, spawns: a.spawns, calls: a.calls}

fn fn_facts_all(fs: [Function]) -> [RuleFacts]:
    n = len(fs)
    mut out = []
    for i in 0..<n:
        out = push_mut(out, fn_facts_of(ffn_at(fs, i)))
    out

fn facts_idx(names: [Text], name: Text) -> int:
    n = len(names)
    for i in 0..<n:
        if text_item(names, i) == name:
            return i
    0 - 1

fn union_into(dst: [Text], src: [Text]) -> [Text]:
    mut out = dst
    n = len(src)
    for i in 0..<n:
        out = f_add(out, text_item(src, i))
    out

# Fold b's sets into a (union), keeping a's identity.
fn merge_facts(a: RuleFacts, b: RuleFacts) -> RuleFacts:
    RuleFacts{rule_name: a.rule_name, trigger: a.trigger, reads: union_into(a.reads, b.reads), writes: union_into(a.writes, b.writes), emits: union_into(a.emits, b.emits), spawns: union_into(a.spawns, b.spawns), calls: union_into(a.calls, b.calls)}

# One propagation step: each fn absorbs its direct callees' facts.
fn close_once(names: [Text], facts: [RuleFacts]) -> [RuleFacts]:
    n = len(facts)
    mut out = []
    for i in 0..<n:
        mut f = ffacts_at(facts, i)
        nc = len(f.calls)
        for k in 0..<nc:
            ci = facts_idx(names, text_item(f.calls, k))
            if ci >= 0:
                f = merge_facts(f, ffacts_at(facts, ci))
        out = push_mut(out, f)
    out

fn ffacts_at(fs: [RuleFacts], i: int) -> RuleFacts:
    at(fs, i)

# Transitive closure by repeated propagation. Union is monotonic and
# the name set finite, so len(names) passes reach the fixpoint (cycles
# converge — union is idempotent).
fn close_facts(names: [Text], facts: [RuleFacts]) -> [RuleFacts]:
    mut cur = facts
    mut pass = 0
    limit = len(names)
    loop:
        if pass >= limit:
            break
        cur = close_once(names, cur)
        pass = pass + 1
    cur

# Fold every called function's closed facts into a rule.
fn merge_callees(rf: RuleFacts, names: [Text], fclosed: [RuleFacts]) -> RuleFacts:
    mut f = rf
    nc = len(rf.calls)
    for k in 0..<nc:
        ci = facts_idx(names, text_item(rf.calls, k))
        if ci >= 0:
            f = merge_facts(f, ffacts_at(fclosed, ci))
    f

fn rule_facts(r: Rule) -> RuleFacts:
    mut bound = []
    np = len(r.params)
    for i in 0..<np:
        p = fparam_at(r.params, i)
        bound = push_mut(bound, p.name)
    a0 = FAcc{reads: [], writes: [], emits: [], spawns: [], calls: [], bound: bound}
    a1 = expr_facts(r.condition, a0)
    a2 = stmts_facts(r.body, a1)
    RuleFacts{rule_name: r.name, trigger: r.trigger, reads: a2.reads, writes: a2.writes, emits: a2.emits, spawns: a2.spawns, calls: a2.calls}

fn fparam_at(ps: [Param], i: int) -> Param:
    at(ps, i)

fn f_has(xs: [Text], x: Text) -> bool:
    n = len(xs)
    for i in 0..<n:
        if text_item(xs, i) == x:
            return true
    false

fn text_item(xs: [Text], i: int) -> Text:
    at(xs, i)

fn f_add(xs: [Text], x: Text) -> [Text]:
    if f_has(xs, x) then xs else push(xs, x)

fn f_read(a: FAcc, name: Text) -> FAcc:
    if name == "_" or f_has(a.bound, name) then a else FAcc{reads: f_add(a.reads, name), writes: a.writes, emits: a.emits, spawns: a.spawns, calls: a.calls, bound: a.bound}

fn f_callee(a: FAcc, callee: Text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: a.emits, spawns: a.spawns, calls: f_add(a.calls, callee), bound: a.bound}

fn f_bind(a: FAcc, name: Text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: a.emits, spawns: a.spawns, calls: a.calls, bound: push(a.bound, name)}

fn cq_facts(binder: Text, src: Expr, pred: Expr, a: FAcc) -> FAcc:
    expr_facts(pred, f_bind(expr_facts(src, a), binder))

fn letin_facts(name: Text, v: Expr, body: Expr, a: FAcc) -> FAcc:
    expr_facts(body, f_bind(expr_facts(v, a), name))

fn expr_facts(e: Expr, a: FAcc) -> FAcc:
    match e:
        VarRef(name) -> f_read(a, name)
        Binop(_, l, r) -> expr_facts(r, expr_facts(l, a))
        Unop(_, x) -> expr_facts(x, a)
        IfExpr(c, t, f) -> expr_facts(f, expr_facts(t, expr_facts(c, a)))
        Call(callee, args) -> exprs_facts(args, f_callee(a, callee))
        Field(base, _) -> expr_facts(base, a)
        CountQuery(binder, src, pred) -> cq_facts(binder, src, pred, a)
        LetIn(name, v, body) -> letin_facts(name, v, body, a)
        LitList(xs) -> exprs_facts(xs, a)
        MapLit(fs) -> fields_facts(fs, a)
        RangeExpr(lo, hi) -> expr_facts(hi, expr_facts(lo, a))
        MatchExpr(scrut, arms) -> arms_facts(arms, expr_facts(scrut, a))
        _ -> a

fn exprs_facts(xs: [Expr], a: FAcc) -> FAcc:
    n = len(xs)
    mut acc = a
    for i in 0..<n:
        acc = expr_facts(expr_item(xs, i), acc)
    acc

fn expr_item(xs: [Expr], i: int) -> Expr:
    at(xs, i)

fn fields_facts(fs: [FieldExpr], a: FAcc) -> FAcc:
    n = len(fs)
    mut acc = a
    for i in 0..<n:
        fe = field_item(fs, i)
        acc = expr_facts(fe.value, acc)
    acc

fn field_item(fs: [FieldExpr], i: int) -> FieldExpr:
    at(fs, i)

fn arms_facts(arms: [MatchArm], a: FAcc) -> FAcc:
    n = len(arms)
    mut acc = a
    for i in 0..<n:
        arm = arm_item(arms, i)
        acc = expr_facts(arm.body, expr_facts(arm.pattern, acc))
    acc

fn arm_item(xs: [MatchArm], i: int) -> MatchArm:
    at(xs, i)

fn stmts_facts(ss: [Stmt], a: FAcc) -> FAcc:
    n = len(ss)
    mut acc = a
    for i in 0..<n:
        acc = stmt_facts(stmt_item(ss, i), acc)
    acc

fn stmt_item(ss: [Stmt], i: int) -> Stmt:
    at(ss, i)

fn f_emit(a: FAcc, name: Text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: f_add(a.emits, name), spawns: a.spawns, calls: a.calls, bound: a.bound}

fn f_spawn(a: FAcc, kind: Text) -> FAcc:
    FAcc{reads: a.reads, writes: a.writes, emits: a.emits, spawns: f_add(a.spawns, kind), calls: a.calls, bound: a.bound}

fn f_write(a: FAcc, name: Text) -> FAcc:
    FAcc{reads: a.reads, writes: f_add(a.writes, name), emits: a.emits, spawns: a.spawns, calls: a.calls, bound: a.bound}

fn let_facts(name: Text, v: Expr, a: FAcc) -> FAcc:
    f_bind(expr_facts(v, a), name)

fn letd_facts(names: [Text], v: Expr, a: FAcc) -> FAcc:
    mut acc = expr_facts(v, a)
    nn = len(names)
    for i in 0..<nn:
        acc = f_bind(acc, text_item(names, i))
    acc

fn setvar_facts(name: Text, v: Expr, a: FAcc) -> FAcc:
    f_write(expr_facts(v, a), name)

fn foreach_facts(var: Text, src: Expr, pred: Expr, body: [Stmt], a: FAcc) -> FAcc:
    stmts_facts(body, expr_facts(pred, f_bind(expr_facts(src, a), var)))

fn stmt_facts(s: Stmt, a: FAcc) -> FAcc:
    match s:
        EmitEffect(name, fs) -> fields_facts(fs, f_emit(a, name))
        Require(e) -> expr_facts(e, a)
        Let(name, v) -> let_facts(name, v, a)
        LetDestructure(names, v) -> letd_facts(names, v, a)
        SpawnEntity(kind, fs) -> fields_facts(fs, f_spawn(a, kind))
        DestroyEntity(e) -> expr_facts(e, a)
        SetField(base, _, v) -> expr_facts(v, expr_facts(base, a))
        SetVar(name, v) -> setvar_facts(name, v, a)
        ForEach(var, src, pred, body) -> foreach_facts(var, src, pred, body, a)
        IfStmt(c, body) -> stmts_facts(body, expr_facts(c, a))
        RelateStmt(src, k, tgt) -> expr_facts(tgt, expr_facts(src, a))
        _ -> a

# Unknown helper calls: valid = bundle fns + the three eval
# builtins. Live eval stays graceful (NoneV — hot-reload mid-edit
# must not crash the game); CHECK and TRY fail loud instead.
pub fn astra_unknown_calls_c(cid: Text, source: Text) -> Text:
    c = compile_c(cid, source)
    facts = astra_facts_c(cid, source)
    n = len(facts)
    mut bad = []
    for i in 0..<n:
        f = facts_at(facts, i)
        nc = len(f.calls)
        for j in 0..<nc:
            callee = text_item(f.calls, j)
            if not call_is_known(c.functions, callee):
                bad = f_add(bad, callee)
    nb = len(bad)
    mut out = ""
    for i in 0..<nb:
        out = if out == "" then "" + text_item(bad, i) else out + "," + text_item(bad, i)
    out

pub fn facts_at(xs: [RuleFacts], i: int) -> RuleFacts:
    at(xs, i)

fn call_is_known(funcs: [Function], name: Text) -> bool:
    if name == "size" or name == "at" or name == "concat" or name == "related":
        return true
    n = len(funcs)
    for i in 0..<n:
        f = fn_item(funcs, i)
        if f.name == name:
            return true
    false

fn fn_item(fs: [Function], i: int) -> Function:
    at(fs, i)
