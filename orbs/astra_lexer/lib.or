# astra_lexer - tokenise `.astra` source.
#
# Port av Rust-implementationen (LodgeEngine/astra/src/lexer.rs).
# Indent är kosmetisk - Newline separerar statements, brackets/keywords
# delimar resten. Inga INDENT/DEDENT tokens behövs.
#
# Pure Orion - kompileras nativt av `orion` (LLVM-backend). Kördes tidigare
# på lodge-orion-interpretern; den är arkiverad.


# Token-vocab - paritet med Rust astra::Tok.
# Comments interspersed in enum body confuse Orion's indent-tracking parser,
# so all variant names live in one contiguous block, sections noted in trailing
# comments rather than indented headers.
public type Tok:
    Int(number)
    Str(text)
    Ident(text)
    Rule
    Record
    RequireKw
    LetKw
    Set
    SpawnKw
    Destroy
    Emit
    Effect
    On
    View
    Entity
    Test
    Apply
    Expect
    Tick
    If
    Then
    Else
    Match
    For
    Count
    All
    In
    Where
    True
    False
    Not
    And
    Or
    When
    Every
    Fn
    Const
    Derive
    Fact
    Law
    RelateKw
    After
    Belief
    Confidence
    Goal
    Constraint
    Intent
    Each
    To
    From
    Through
    Exists
    None
    UseKw
    Becomes
    Spawned
    Destroyed
    Component
    State
    Command
    Needs
    Signal
    Type
    Create
    Source
    Animate
    Asset
    Trait
    Patch
    Template
    Tokens
    Arrow
    LParen
    RParen
    LBrace
    RBrace
    LBracket
    RBracket
    Comma
    Dot
    Colon
    Assign
    Eq
    Ne
    Lt
    Le
    Gt
    Ge
    Plus
    Minus
    Star
    Slash
    Percent
    Newline

# A token + its source line and start column (1-based). The column of
# a statement's first token is what block parsers compare to detect
# dedent - Astra has no INDENT/DEDENT tokens.
public type Token: tok: Tok, line: number, col: number

# Lex error with the offending line.
public type LexError: message: text, line: number

# A lex result - empty `error` means tokens are good. Sum types with payload
# in Orion are still rough, so we return both fields and a flag.
public type LexResult: tokens: [Token], ok: truth, error: LexError

# ---- Entry point ----

public define lex(source: text) -> LexResult:
    bs = bytes_of(source)
    n = length(bs)
    edit tokens = []
    edit i = 0
    edit line = 1
    edit line_start = 0
    edit failed = false
    edit err_msg = ""
    edit err_line = 0
    loop:
        if i >= n:
            break
        if failed:
            break
        c = bs[i]
        # newline
        if c is 10:
            tokens = push_newline(tokens, line)
            line = line + 1
            line_start = i + 1
            i = i + 1
        else:
            # whitespace
            if c is 32 or c is 9 or c is 13:
                i = i + 1
            else:
                # comment to EOL
                if c is 35:
                    i = skip_to_eol(bs, i, n)
                else:
                    # string literal
                    if c is 34:
                        res = scan_string(bs, i + 1, n, line)
                        if res.ok:
                            tokens = append(tokens, Token{tok: Str(res.text), line: line, col: i - line_start + 1})
                            i = res.next
                        else:
                            failed = true
                            err_msg = res.error
                            err_line = line
                    else:
                        # digit -> int
                        if alx_is_digit(c):
                            res = scan_int(bs, i, n, line)
                            if res.ok:
                                tokens = append(tokens, Token{tok: Int(res.value), line: line, col: i - line_start + 1})
                                i = res.next
                            else:
                                failed = true
                                err_msg = res.error
                                err_line = line
                        else:
                            # alpha -> ident or keyword
                            if is_alpha(c):
                                step = scan_ident(bs, i, n)
                                tokens = append(tokens, Token{tok: keyword_of(step.text), line: line, col: i - line_start + 1})
                                i = step.next
                            else:
                                # punct/symbol
                                step = scan_symbol(bs, i, n, line)
                                if step.ok:
                                    tokens = append(tokens, Token{tok: step.tok, line: line, col: i - line_start + 1})
                                    i = step.next
                                else:
                                    failed = true
                                    err_msg = step.error
                                    err_line = line
    # Always append a terminating Newline so every stmt ends the same way.
    tokens = push_newline(tokens, line)
    if failed:
        LexResult{tokens: [], ok: false, error: LexError{message: err_msg, line: err_line}}
    else:
        LexResult{tokens: tokens, ok: true, error: LexError{message: "", line: 0}}

# ---- char predicates ----

define alx_is_digit(c: number) -> truth:
    c >= 48 and c <= 57

define is_alpha(c: number) -> truth:
    (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or c is 95

define is_alnum(c: number) -> truth:
    is_alpha(c) or alx_is_digit(c)

# ---- scanners ----

define skip_to_eol(bs: [number], start: number, n: number) -> number:
    edit i = start
    loop:
        if i >= n:
            break
        if bs[i] is 10:
            break
        i = i + 1
    i

type StrStep: text: text, next: number, ok: truth, error: text

define scan_string(bs: [number], start: number, n: number, line: number) -> StrStep:
    edit i = start
    edit chars = []
    edit closed = false
    edit bad = false
    loop:
        if i >= n:
            break
        c = bs[i]
        if c is 34:
            closed = true
            break
        if c is 10:
            bad = true
            break
        chars = append(chars, c)
        i = i + 1
    if bad:
        StrStep{text: "", next: i, ok: false, error: "unterminated string"}
    else:
        if not closed:
            StrStep{text: "", next: i, ok: false, error: "unterminated string"}
        else:
            StrStep{text: text_of(chars), next: i + 1, ok: true, error: ""}

type IntStep: value: number, next: number, ok: truth, error: text

define scan_int(bs: [number], start: number, n: number, line: number) -> IntStep:
    edit i = start
    edit value = 0
    loop:
        if i >= n:
            break
        c = bs[i]
        if not alx_is_digit(c):
            break
        value = value * 10 + (c - 48)
        i = i + 1
    IntStep{value: value, next: i, ok: true, error: ""}

type IdentStep: text: text, next: number

define scan_ident(bs: [number], start: number, n: number) -> IdentStep:
    edit i = start
    edit chars = []
    loop:
        if i >= n:
            break
        c = bs[i]
        if not is_alnum(c):
            break
        chars = append(chars, c)
        i = i + 1
    IdentStep{text: text_of(chars), next: i}

type SymStep: tok: Tok, next: number, ok: truth, error: text

define scan_symbol(bs: [number], start: number, n: number, line: number) -> SymStep:
    c = bs[start]
    next_c = if start + 1 < n then bs[start + 1] else 0
    # 2-char ops first
    if c is 61 and next_c is 61:
        SymStep{tok: Eq, next: start + 2, ok: true, error: ""}
    else:
        if c is 33 and next_c is 61:
            SymStep{tok: Ne, next: start + 2, ok: true, error: ""}
        else:
            if c is 62 and next_c is 61:
                SymStep{tok: Ge, next: start + 2, ok: true, error: ""}
            else:
                if c is 60 and next_c is 61:
                    SymStep{tok: Le, next: start + 2, ok: true, error: ""}
                else:
                    if c is 45 and next_c is 62:
                        SymStep{tok: Arrow, next: start + 2, ok: true, error: ""}
                    else:
                        one_char_symbol(c, start)

define one_char_symbol(c: number, start: number) -> SymStep:
    if c is 40:
        SymStep{tok: LParen, next: start + 1, ok: true, error: ""}
    else:
        if c is 41:
            SymStep{tok: RParen, next: start + 1, ok: true, error: ""}
        else:
            if c is 123:
                SymStep{tok: LBrace, next: start + 1, ok: true, error: ""}
            else:
                if c is 125:
                    SymStep{tok: RBrace, next: start + 1, ok: true, error: ""}
                else:
                    if c is 91:
                        SymStep{tok: LBracket, next: start + 1, ok: true, error: ""}
                    else:
                        if c is 93:
                            SymStep{tok: RBracket, next: start + 1, ok: true, error: ""}
                        else:
                            one_char_symbol_rest(c, start)

define one_char_symbol_rest(c: number, start: number) -> SymStep:
    if c is 44:
        SymStep{tok: Comma, next: start + 1, ok: true, error: ""}
    else:
        if c is 46:
            SymStep{tok: Dot, next: start + 1, ok: true, error: ""}
        else:
            if c is 58:
                SymStep{tok: Colon, next: start + 1, ok: true, error: ""}
            else:
                if c is 61:
                    SymStep{tok: Assign, next: start + 1, ok: true, error: ""}
                else:
                    one_char_symbol_math(c, start)

define one_char_symbol_math(c: number, start: number) -> SymStep:
    if c is 60:
        SymStep{tok: Lt, next: start + 1, ok: true, error: ""}
    else:
        if c is 62:
            SymStep{tok: Gt, next: start + 1, ok: true, error: ""}
        else:
            if c is 43:
                SymStep{tok: Plus, next: start + 1, ok: true, error: ""}
            else:
                if c is 45:
                    SymStep{tok: Minus, next: start + 1, ok: true, error: ""}
                else:
                    if c is 42:
                        SymStep{tok: Star, next: start + 1, ok: true, error: ""}
                    else:
                        if c is 47:
                            SymStep{tok: Slash, next: start + 1, ok: true, error: ""}
                        else:
                            if c is 37:
                                SymStep{tok: Percent, next: start + 1, ok: true, error: ""}
                            else:
                                SymStep{tok: Comma, next: start + 1, ok: false, error: "unexpected character"}

# ---- helpers ----

# Append a Newline, dedup runs (matching Rust push_newline contract).
define push_newline(tokens: [Token], line: number) -> [Token]:
    n = length(tokens)
    if n is 0:
        tokens
    else:
        last = tokens[n - 1]
        if is_newline_token(last):
            tokens
        else:
            # In-place append is audited here: every caller rebinds
            # `tokens = push_newline(tokens, line)` immediately.
            append(tokens, Token{tok: Newline, line: line, col: 0})

define is_newline_token(t: Token) -> truth:
    # Pattern-match-via-fold - Orion's enum match should handle this.
    choose t.tok:
        Newline then true
        _ then false

# Map an identifier text to its keyword token, or Ident if not reserved.
define keyword_of(text: text) -> Tok:
    if text is "rule" then Rule
    else if text is "record" then Record
    else if text is "require" then RequireKw
    else if text is "let" then LetKw
    else if text is "set" then Set
    else if text is "spawn" then SpawnKw
    else if text is "destroy" then Destroy
    else if text is "emit" then Emit
    else if text is "effect" then Effect
    else if text is "on" then On
    else if text is "view" then View
    else if text is "entity" then Entity
    else if text is "test" then Test
    else if text is "apply" then Apply
    else if text is "expect" then Expect
    # `tick` intentionally not reserved - atlas_astra auto-injects it
    # as a ctx binding so scripts use it as a regular identifier.
    else if text is "if" then If
    else if text is "then" then Then
    else if text is "else" then Else
    else if text is "match" then Match
    else if text is "for" then For
    else if text is "count" then Count
    else if text is "all" then All
    else if text is "in" then In
    else if text is "where" then Where
    else if text is "true" then True
    else if text is "false" then False
    else if text is "not" then Not
    else if text is "and" then And
    else if text is "or" then Or
    else if text is "when" then When
    else if text is "every" then Every
    else if text is "fn" then Fn
    else if text is "const" then Const
    else if text is "derive" then Derive
    else if text is "fact" then Fact
    else if text is "conf" then Confidence
    else if text is "law" then Law
    else if text is "relate" then RelateKw
    else if text is "after" then After
    else if text is "belief" then Belief
    else if text is "confidence" then Confidence
    else if text is "goal" then Goal
    else if text is "constraint" then Constraint
    else if text is "intent" then Intent
    else if text is "each" then Each
    else if text is "to" then To
    else if text is "from" then From
    else if text is "through" then Through
    else if text is "use" then UseKw
    else if text is "exists" then Exists
    else if text is "none" then None
    else if text is "becomes" then Becomes
    else if text is "spawned" then Spawned
    else if text is "destroyed" then Destroyed
    else if text is "component" then Component
    else if text is "state" then State
    else if text is "command" then Command
    else if text is "needs" then Needs
    else if text is "signal" then Signal
    else if text is "type" then Type
    else if text is "create" then Create
    else if text is "source" then Source
    else if text is "animate" then Animate
    else if text is "asset" then Asset
    else if text is "trait" then Trait
    else if text is "patch" then Patch
    else if text is "template" then Template
    else if text is "tokens" then Tokens
    else Ident(text)
