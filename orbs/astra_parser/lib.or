# Extract data from a token, or return sentinel value if wrong variant.
define ident_of(t: Tok) -> text:
    choose t:
        Ident(s) then s
        _ then ""

define int_of(t: Tok) -> number:
    choose t:
        Int(n) then n
        _ then 0 - 1

define token_text(t: Tok) -> text:
    choose t:
        Str(s) then s
        _ then ""

# Is this token a string literal? Distinguishes `Str("")` (a real empty
# string) from a non-string token — `text_of` alone can't, since both
# yield "".
define is_str_tok(t: Tok) -> truth:
    choose t:
        Str(_) then true
        _ then false
