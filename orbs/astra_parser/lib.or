# astra_parser — tokens → AST. MVP scope: `rule name(): emit X {f: lit}`.
#
# Pure-Orion recursive descent. Cursor + helpers follow the Rust
# LodgeEngine/astra/src/parser/mod.rs structure 1:1, but the grammar
# subset is intentionally tiny for the first iteration.
#
# push_mut audit (applies to every accumulator in this file): each is
# a fresh `mut xs = []` local, appended in one loop, stored once into
# the result record, never aliased before that store. Value-semantic
# push here cost a spine copy per node — the parse of a game's 10KB of
# scripts allocated 6.4MB of permanent heap (compile runs under the
# persist guard). The recursive subst_* helpers keep plain push: their
# accumulator threads through call arguments.


public type ParseError: message: text, line: number

# A parse result — `ok: false` means consult `error`. `functions` are
# pure helpers callable from rule expressions; `rules` are the regular
# `rule`/`on`/`when`/`every` bodies; `entities` are typed authoring
# declarations the host uses to register constructors for `spawn Kind`;
# `components` are ECS component type declarations (`component Kind: f:t`).
# External reactive data sources — declared as `source NAME from file
# "path" [refresh Ns]`. Atlas reads the file at boot and (later) on a
# refresh cadence, writing contents to the prefixed resource `NAME`.
# Only file kind in v1; http/websocket/mmo come in follow-up slices.
public type SourceDecl: name: text, kind: text, path: text, refresh_ms: number

# Declarative tween — `animate NAME from A to B over N unit
# [when TRIGGER becomes VALUE]`. Without a trigger, the tween runs
# once at boot. With a trigger, it waits for the trigger resource to
# transition to VALUE (edge-fire), then runs. Every subsequent edge
# re-runs the tween.
# trigger_name is "" means no trigger (boot-once).
public type AnimationDecl: name: text, from_val: number, to_val: number, duration_ms: number, trigger_name: text, trigger_value: number, easing: text

# Typed asset reference — `asset X: sprite/audio/text "path"`. Atlas
# verifies the file exists at boot and registers name→path so widgets
# can reference the asset by name (`sprite: my_wolf`) instead of raw
# string paths. Fails hard at boot when a file is missing — the shift
# from silent-at-runtime to loud-at-load-time.
public type AssetDecl: name: text, kind: text, path: text

# Trait declaration — `trait X { field: type }`. A reusable field
# bundle. When a `type Y uses A, B { extra }` composes it, the parser
# inlines A's and B's fields into Y's ComponentDecl. Pure parse-time
# sugar; the ECS sees one merged component per Y, no multi-component
# machinery required. Bundle-local: traits declared in one .astra
# file are only visible within that file's compositions.
public type TraitDecl: name: text, fields: [Param]

# Which traits does a type use? Recorded at parse time when
# `type X uses A, B` is seen. Atlas uses this to answer trait-queries
# (`each e in Movable` iterates entities of every type that uses
# Movable) without any storage-level multi-component ECS rewrite.
public type TypeTraits: type_name: text, traits: [text]

# `template NAME(params) = EXPR` — parameterised fragment. Replaces
# per-shape widget types (List/Grid/Card/Pill…). At runtime a template
# is invoked with concrete arguments and expands its body expression
# with the params bound. Body is a normal Astra expression in v1;
# extension to widget-tree literals lands with Veil's Panel primitive.
public type TemplateDecl: name: text, params: [Param], body: Expr
# A reusable widget prop bundle: `style NAME:` then indented `key: value`.
public type StyleDecl: name: text, fields: [FieldExpr]

# One entry in a `tokens NS:` block — `key: value`. Value is any
# expression (int/text/ident) resolved at consume-time.
public type TokenEntry: key: text, value: Expr

# `tokens NAMESPACE:` — design-system token block. Atlas registers
# each namespace so widgets can consume `style: card` via a runtime
# resolver. Namespace + key together form the resolved token id
# (e.g. `color.bg`, `layout.card`).
public type TokensDecl: namespace: text, entries: [TokenEntry]

public type ParseResult: rules: [Rule], functions: [Function], entities: [EntityDecl], consts: [ConstDecl], components: [ComponentDecl], uses: [text], tests: [TestCase], sources: [SourceDecl], animations: [AnimationDecl], assets: [AssetDecl], type_traits: [TypeTraits], templates: [TemplateDecl], token_blocks: [TokensDecl], styles: [StyleDecl], enum_states: [EnumState], ok: truth, error: ParseError

public define parse(tokens: [Token]) -> ParseResult:
    n = length(tokens)
    edit i = 0
    edit rules = []
    edit functions = []
    edit entities = []
    edit consts = []
    edit components = []
    edit uses = []
    edit tests = []
    # State decls (`state NAME: TYPE = INIT`) accumulate here; at
    # end-of-parse we synthesise one on Init() rule from the inits and
    # clamp every SetVar in every rule whose name has bounds. Pure
    # parser sugar — no downstream consumer changes.
    edit state_inits = []
    edit state_bounds = []
    # Enum-typed states, retained so the checker can flag non-exhaustive
    # `when` switches (the parser otherwise flattens enum variants to ints).
    edit enum_states = []
    edit sources = []
    edit animations = []
    edit assets = []
    edit traits = []
    edit type_traits = []
    edit templates = []
    edit component_templates = []
    edit token_blocks = []
    edit styles = []
    # Top-level widget tree: `Panel ...` / `for x in [..]:` written at the
    # bundle's top level (no `on Init()` wrapper) collect here and fold into
    # the synthesised Init. The tree IS the declaration — declare the scene
    # like state/tokens, not inside a lifecycle callback.
    edit tree_stmts = []
    edit failed = false
    edit err_msg = ""
    edit err_line = 0
    edit handled = false
    # Leading newlines + `use NAME` directives (engine bundling metadata,
    # conventionally first in the file).
    loop:
        if i >= n:
            break
        if failed:
            break
        t0 = tokens[i]
        if is_newline(t0.tok):
            i = i + 1
        else:
            if match_tok(tokens, i, n, "Use"):
                ustep = parse_use_decl(tokens, i + 1, n)
                if ustep.ok:
                    uses = append(uses, ustep.name)
                    i = ustep.next
                else:
                    failed = true
                    err_msg = ustep.error
                    err_line = t0.line
            else:
                break
    loop:
        if i >= n:
            break
        if failed:
            break
        t = tokens[i]
        if is_newline(t.tok):
            i = i + 1
        else:
            # Flat keyword dispatch: one self-contained block per top-level
            # construct, each guarded by `handled`, so adding a construct is
            # one block — not another pyramid level. Order is irrelevant (the
            # leading keyword is unambiguous) except the implicit-fn and
            # belief/goal/rule fallthroughs, which must stay last.
            handled = false
            # `type X ...` — the only shape. `component` was from an earlier design
            # jargon; databases (SurrealDB/EdgeDB) use `type`. First-
            # version cleanup: one-way syntax, no aliases.
            if match_tok(tokens, i, n, "Type"):
                handled = true
                cstep = parse_component_decl(tokens, i + 1, n, traits)
                if cstep.ok:
                    components = append(components, cstep.component)
                    if length(cstep.uses_traits) > 0:
                        type_traits = append(type_traits, TypeTraits{type_name: cstep.component.name, traits: cstep.uses_traits})
                    i = cstep.next
                else:
                    failed = true
                    err_msg = cstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Trait"):
                # `trait X { fields }` — reusable field bundle. Types
                # declare `uses X` to inline the fields.
                handled = true
                tstep = parse_trait_decl(tokens, i + 1, n)
                if tstep.ok:
                    traits = append(traits, tstep.trait_decl)
                    i = tstep.next
                else:
                    failed = true
                    err_msg = tstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Const"):
                handled = true
                kstep = parse_const_decl(tokens, i + 1, n)
                if kstep.ok:
                    consts = append(consts, kstep.cnst)
                    i = kstep.next
                else:
                    failed = true
                    err_msg = kstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Fn"):
                handled = true
                fstep = parse_function(tokens, i + 1, n)
                if fstep.ok:
                    functions = append(functions, fstep.func)
                    i = fstep.next
                else:
                    failed = true
                    err_msg = fstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Entity"):
                handled = true
                estep = parse_entity_decl(tokens, i + 1, n)
                if estep.ok:
                    entities = append(entities, estep.entity)
                    i = estep.next
                else:
                    failed = true
                    err_msg = estep.error
                    err_line = t.line
            if not handled and (match_tok(tokens, i, n, "Each") or match_tok(tokens, i, n, "For")):
                handled = true
                # Two top-level `for`s: `for x in INT..INT:` is the compile-
                # time range macro (unrolls to rules); `for x in [list]:` (or
                # any non-int source) is a runtime foreach that spawns into
                # the tree — it folds into the synthesised Init.
                if is_range_for(tokens, i, n):
                    floop = parse_for_loop(tokens, i + 1, n)
                    if floop.ok:
                        loop r in floop.rules:
                            rules = append(rules, r)
                        i = floop.next
                    else:
                        failed = true
                        err_msg = floop.error
                        err_line = t.line
                else:
                    festep = parse_foreach_stmt(tokens, i + 1, n)
                    if festep.ok:
                        tree_stmts = append(tree_stmts, festep.stmt)
                        i = festep.next
                    else:
                        failed = true
                        err_msg = festep.error
                        err_line = t.line
            # `view X = EXPR` — a value that is ALWAYS its expression.
            # Matches SQL materialized-view. `derive` (early Astra) is
            # gone in v1.
            if not handled and match_tok(tokens, i, n, "View"):
                # `derive NAME = EXPR` -> a rule recomputing NAME from EXPR
                # every tick: a value that is ALWAYS its expression.
                handled = true
                dstep = parse_derive_decl(tokens, i + 1, n)
                if dstep.ok:
                    rules = append(rules, dstep.rule)
                    i = dstep.next
                else:
                    failed = true
                    err_msg = dstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Fact"):
                # `fact NAME = EXPR [in ...] [conf N]` — consolidates
                # view/goal/constraint/belief into one keyword (NEXTGEN #3).
                handled = true
                fstep = parse_fact_decl(tokens, i + 1, n)
                if fstep.ok:
                    rules = append(rules, fstep.rule)
                    i = fstep.next
                else:
                    failed = true
                    err_msg = fstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Law"):
                # `law NAME:` names the following rule.
                handled = true
                lstep = parse_law_decl(tokens, i + 1, n)
                if lstep.ok:
                    rules = append(rules, lstep.rule)
                    i = lstep.next
                else:
                    failed = true
                    err_msg = lstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "State"):
                # `state NAME: TYPE [in ...] = INIT` -> synthesised Init
                # + bounds table; applied at end-of-parse. `enum` types
                # emit consts (one per value, ints 0-indexed) SO `dead`
                # in `game_over = dead` resolves to IntV(1) within THIS
                # bundle. They also emit SetVars into Init so the values
                # become world resources — auto-ctx then makes them
                # readable in every other bundle (`if game_over is dead`
                # in narrative.astra resolves via world state, not
                # bundle-local consts).
                handled = true
                sstep = parse_state_decl(tokens, i + 1, n)
                if sstep.ok:
                    state_inits = append(state_inits, sstep.init)
                    state_bounds = append(state_bounds, sstep.bound)
                    loop ec in sstep.enum_consts:
                        consts = append(consts, ec)
                        state_inits = append(state_inits, SetVar(ec.name, ec.value))
                    # Enum state: retain (name, variants-in-order) for the
                    # exhaustive-`when` check.
                    if length(sstep.enum_consts) > 0:
                        edit vnames = []
                        loop ec in sstep.enum_consts:
                            vnames = append(vnames, ec.name)
                        enum_states = append(enum_states, EnumState{name: state_name_of(sstep.init), variants: vnames})
                    i = sstep.next
                else:
                    failed = true
                    err_msg = sstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Animate"):
                # `animate NAME from A to B over N unit` -> AnimationDecl.
                handled = true
                astep = parse_animate_decl(tokens, i + 1, n)
                if astep.ok:
                    animations = append(animations, astep.anim)
                    i = astep.next
                else:
                    failed = true
                    err_msg = astep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Asset"):
                # `asset NAME: kind "path"` -> AssetDecl. Atlas verifies
                # + registers name→path at boot.
                handled = true
                aset_step = parse_asset_decl(tokens, i + 1, n)
                if aset_step.ok:
                    assets = append(assets, aset_step.asset)
                    i = aset_step.next
                else:
                    failed = true
                    err_msg = aset_step.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Source"):
                # `source NAME from file "path" [refresh N s]` -> atlas
                # loads the file at boot into the world resource `NAME`.
                handled = true
                srcstep = parse_source_decl(tokens, i + 1, n)
                if srcstep.ok:
                    sources = append(sources, srcstep.source)
                    i = srcstep.next
                else:
                    failed = true
                    err_msg = srcstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Patch"):
                # `patch command NAME CODE [needs...]: body` — bundle-
                # local override: post-parse step removes the earlier
                # `cmd:NAME` rule so only the patch runs. Cross-bundle
                # patches (mods/) need atlas-level layering — future.
                handled = true
                if match_tok(tokens, i + 1, n, "Command"):
                    cmdstep = parse_command_decl(tokens, i + 2, n)
                    if cmdstep.ok:
                        # Mark as patch by prefixing name so post-parse
                        # can find + evict its base counterpart.
                        base_rule = cmdstep.rule
                        patch_rule = Rule{name: "patch:" + rule_name_strip_prefix(base_rule.name, "cmd:"), params: base_rule.params, body: base_rule.body, trigger: base_rule.trigger, condition: base_rule.condition}
                        rules = append(rules, patch_rule)
                        i = cmdstep.next
                    else:
                        failed = true
                        err_msg = cmdstep.error
                        err_line = t.line
                else:
                    failed = true
                    err_msg = "only `patch command` supported in v1"
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Template"):
                # `template NAME(params) = EXPR` -> parameterised fragment.
                # Body is a single expression (widget-tree extension lands
                # with Veil's Panel primitive). Runtime invokes templates
                # by name from `items:`/`template:` on collection widgets.
                handled = true
                tmplstep = parse_template_decl(tokens, i + 1, n)
                if tmplstep.ok:
                    templates = append(templates, tmplstep.template)
                    i = tmplstep.next
                else:
                    failed = true
                    err_msg = tmplstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Component"):
                # `component NAME(params):` + an indented widget subtree — a
                # parameterised, reusable component. Instantiations NAME(args)
                # in the tree are expanded (subst + splice) after parsing.
                handled = true
                comp_col = t.col
                cmpstep = parse_component_template(tokens, i + 1, n, comp_col)
                if cmpstep.ok:
                    component_templates = append(component_templates, cmpstep.template)
                    i = cmpstep.next
                else:
                    failed = true
                    err_msg = cmpstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Tokens"):
                # `tokens NAMESPACE:` NEWLINE (indent) key: value ... ->
                # design-system token block. Atlas resolver joins namespace
                # + key (e.g. `color.bg`) at consume-time when a widget
                # reads `style:`/`layout:` attributes.
                handled = true
                tokstep = parse_tokens_decl(tokens, i + 1, n)
                if tokstep.ok:
                    token_blocks = append(token_blocks, tokstep.block)
                    i = tokstep.next
                else:
                    failed = true
                    err_msg = tokstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Command"):
                # `command NAME [needs EXPR]: body` -> when-rule watching
                # ui_action is "NAME"; body consumes + optionally gates.
                handled = true
                cmdstep = parse_command_decl(tokens, i + 1, n)
                if cmdstep.ok:
                    rules = append(rules, cmdstep.rule)
                    i = cmdstep.next
                else:
                    failed = true
                    err_msg = cmdstep.error
                    err_line = t.line
            if not handled and match_tok(tokens, i, n, "Test"):
                # `test NAME:` — inline test block (dev surface).
                handled = true
                tstep = parse_test_decl(tokens, i + 1, n)
                if tstep.ok:
                    tests = append(tests, tstep.test)
                    i = tstep.next
                else:
                    failed = true
                    err_msg = tstep.error
                    err_line = t.line
            if not handled and looks_like_style_decl(tokens, i, n):
                # `style NAME:` then indented `key: value` — a reusable prop
                # bundle. "style" is a bare ident (no keyword/enum surgery).
                handled = true
                stystep = parse_style_decl(tokens, i + 1, n)
                if stystep.ok:
                    styles = append(styles, stystep.style)
                    i = stystep.next
                else:
                    failed = true
                    err_msg = stystep.error
                    err_line = t.line
            if not handled and looks_like_implicit_fn(tokens, i, n):
                # `NAME(params): body` with no `fn` keyword — a top-level pure
                # helper. parse_function takes the name as its start token, so
                # pass `i` (not i+1 like the explicit `fn` path).
                handled = true
                ifstep = parse_function(tokens, i, n)
                if ifstep.ok:
                    functions = append(functions, ifstep.func)
                    i = ifstep.next
                else:
                    failed = true
                    err_msg = ifstep.error
                    err_line = t.line
            # `data NAME(cols):` + indented rows — a schema'd data table → const list.
            if not handled and looks_like_data_decl(tokens, i, n):
                handled = true
                dbstep = parse_data_decl(tokens, i, n)
                if dbstep.ok:
                    consts = append(consts, dbstep.cnst)
                    i = dbstep.next
                else:
                    failed = true
                    err_msg = dbstep.error
                    err_line = t.line
            # `Panel ...` / `Text ...` at top level — a widget-tree node with
            # no `on Init()` wrapper. Parse it (+ its indented props) as a
            # spawn and collect into the tree; parent-inference nests the
            # whole run by column at end-of-parse.
            if not handled and is_type_stmt(tokens, i, n):
                handled = true
                sstep = parse_spawn_stmt(tokens, i, n, t.col)
                if sstep.ok:
                    tree_stmts = append(tree_stmts, sstep.stmt)
                    i = sstep.next
                else:
                    failed = true
                    err_msg = sstep.error
                    err_line = t.line
            if not handled:
                # belief/goal/constraint/intent declarations, else a plain rule.
                step = parse_belief_goal_or_rule(tokens, i, n)
                if step.ok:
                    rules = append(rules, step.rule)
                    i = step.next
                else:
                    failed = true
                    err_msg = step.error
                    err_line = t.line
    if failed:
        ParseResult{rules: [], functions: [], entities: [], consts: [], components: [], uses: [], tests: [], sources: [], animations: [], assets: [], type_traits: [], templates: [], token_blocks: [], styles: [], enum_states: [], ok: false, error: ParseError{message: err_msg, line: err_line}}
    else:
        # State post-processing: synthesise Init from collected inits;
        # clamp SetVars whose name has bounds. Order matters — synthetic
        # Init is prepended so user rules run after (letting user Init
        # writes override defaults if both exist for the same name).
        # Patch resolution: `patch:X` rules override `cmd:X` rules
        # (bundle-local). Filter out patched base rules, then rename
        # `patch:X` → `cmd:X` so dispatch treats them uniformly.
        # Hoist show-expressions: a `show:` whose value is an EXPRESSION
        # (not a lone resource name / bareword) is lifted into a synthesised
        # `view __show_N = <expr>` rule (recomputed each tick) and the field
        # is repointed at that derived resource. So `show: overlay is palette`
        # is reactive, reusing the same res-lookup as `show: resource_name`.
        # Expand component instantiations first: a `NAME(args)` at tree
        # position (parsed as SpawnEntity with __argN fields) whose NAME is a
        # declared component is replaced by the component's body, with params
        # substituted and columns/loop-stamps rebased to the call site.
        expanded_tree = expand_components(tree_stmts, component_templates)
        hoisted = hoist_show_body(expanded_tree, 0)
        edit rules_hoisted = rules
        loop hoisted_view in hoisted.views:
            rules_hoisted = append(rules_hoisted, hoisted_view)
        patched = apply_patches(rules_hoisted)
        # Init body = state seeds first (resources exist before the tree
        # spawns / any `show:` reads them), then the top-level widget tree.
        edit init_body = []
        loop si in state_inits:
            init_body = append(init_body, si)
        loop ts in hoisted.stmts:
            init_body = append(init_body, ts)
        final_rules = if length(init_body) > 0 then push_front(patched, Rule{name: "$state_init", params: [], body: init_body, trigger: "Init", condition: LitBool(true)}) else patched
        final_rules_clamped = if length(state_bounds) > 0 then rewrite_setvars_rules(final_rules, state_bounds) else final_rules
        # Infer parent from indentation + strip __col. Styles are NOT
        # applied here — they ride on the create's `style:` field and atlas
        # merges them at spawn from a global registry (cross-bundle).
        final_rules_parented = infer_parents_rules(final_rules_clamped)
        ParseResult{rules: final_rules_parented, functions: functions, entities: entities, consts: consts, components: components, uses: uses, tests: tests, sources: sources, animations: animations, assets: assets, type_traits: type_traits, templates: templates, token_blocks: token_blocks, styles: styles, enum_states: enum_states, ok: true, error: ParseError{message: "", line: 0}}

# ── show-expression hoisting ── A `show:` value that isn't a lone resource
# name (`show: overlay is palette`, `show: not busy`) is lifted into a
# synthesised tick-recomputed `view __show_N = <expr>` and the field points
# at `__show_N`. Reuses the derived-resource path, so render is unchanged.
type BodyHoist: stmts: [Stmt], views: [Rule], counter: number
type FieldsHoist: fields: [FieldExpr], views: [Rule], counter: number

define is_lit_text_expr(e: Expr) -> truth:
    choose e:
        LitText(_) then true
        _ then false

define hoist_show_fields(fields: [FieldExpr], counter: number) -> FieldsHoist:
    edit out_fields = []
    edit out_views = []
    edit c = counter
    loop i in 0 until length(fields):
        f = fields[i]
        if fe_name_eq(f.name, "show") and not is_lit_text_expr(f.value):
            nm = "__show{c}"
            view_rule = Rule{name: "derive:" + nm, params: [], body: append([], SetVar(nm, f.value)), trigger: "$derive", condition: LitBool(true)}
            out_views = append(out_views, view_rule)
            out_fields = append(out_fields, FieldExpr{name: "show", value: LitText(nm)})
            c = c + 1
        else:
            out_fields = append(out_fields, f)
    FieldsHoist{fields: out_fields, views: out_views, counter: c}

define hoist_show_stmt(s: Stmt, counter: number) -> BodyHoist:
    choose s:
        SpawnEntity(kind, fields) then 
            fh = hoist_show_fields(fields, counter)
            BodyHoist{stmts: append([], SpawnEntity(kind, fh.fields)), views: fh.views, counter: fh.counter}
        ForEach(iter, src, filter, body) then 
            bh = hoist_show_body(body, counter)
            BodyHoist{stmts: append([], ForEach(iter, src, filter, bh.stmts)), views: bh.views, counter: bh.counter}
        _ then BodyHoist{stmts: append([], s), views: [], counter: counter}

define hoist_show_body(body: [Stmt], counter: number) -> BodyHoist:
    edit out_stmts = []
    edit out_views = []
    edit c = counter
    loop i in 0 until length(body):
        sh = hoist_show_stmt(body[i], c)
        loop st in sh.stmts:
            out_stmts = append(out_stmts, st)
        loop vw in sh.views:
            out_views = append(out_views, vw)
        c = sh.counter
    BodyHoist{stmts: out_stmts, views: out_views, counter: c}

# Apply bundle-local patches: for every `patch:NAME` rule, remove the
# corresponding `cmd:NAME` base rule from THIS bundle. Patch keeps its
# `patch:X` name so cross-bundle dispatch can identify it (atlas at
# boot indexes patched names; dispatch skips `cmd:X` when the base is
# patched anywhere).
define apply_patches(all_rules: [Rule]) -> [Rule]:
    n = length(all_rules)
    edit patched_bases = []
    loop i in 0 until n:
        r = state_rule_at(all_rules, i)
        if rule_name_starts_with(r.name, "patch:"):
            patched_bases = append(patched_bases, "cmd:" + rule_name_strip_prefix(r.name, "patch:"))
    edit out = []
    loop i in 0 until n:
        r = state_rule_at(all_rules, i)
        if patch_contains_text(patched_bases, r.name):
            0
        else:
            out = append(out, r)
    out

define patch_contains_text(xs: [text], target: text) -> truth:
    n = length(xs)
    edit i = 0
    edit found = false
    loop:
        if i >= n:
            break
        if patch_text_at(xs, i) is target:
            found = true
            break
        i = i + 1
    found

define patch_text_at(xs: [text], i: number) -> text:
    xs[i]

# Local byte-comparison helpers — parser can't reach the text orb from
# its Orbit.toml dep set and the byte primitives are already in scope.
# Kept name-scoped so a later `use text` won't shadow.
define rule_name_starts_with(name: text, prefix: text) -> truth:
    name_bytes = bytes_of(name)
    prefix_bytes = bytes_of(prefix)
    name_len = length(name_bytes)
    prefix_len = length(prefix_bytes)
    if prefix_len > name_len:
        false
    else:
        edit equal_so_far = true
        loop ci in 0 until prefix_len:
            if name_bytes[ci] is not prefix_bytes[ci]:
                equal_so_far = false
        equal_so_far

define rule_name_strip_prefix(name: text, prefix: text) -> text:
    name_bytes = bytes_of(name)
    prefix_bytes = bytes_of(prefix)
    name_len = length(name_bytes)
    prefix_len = length(prefix_bytes)
    if prefix_len > name_len:
        name
    else:
        edit equal_so_far = true
        loop ci in 0 until prefix_len:
            if name_bytes[ci] is not prefix_bytes[ci]:
                equal_so_far = false
        if not equal_so_far:
            name
        else:
            edit suffix = []
            loop ci in prefix_len until name_len:
                suffix = append(suffix, name_bytes[ci])
            text_of(suffix)

# Prepend one Rule to the head of a list. push_mut appends; we need
# insert-at-front so the synthetic Init runs BEFORE any user-declared
# rule with the same trigger.
define push_front(rules: [Rule], head: Rule) -> [Rule]:
    edit out = append([], head)
    n = length(rules)
    loop i in 0 until n:
        out = append(out, state_rule_at(rules, i))
    out

type UseStep: name: text, next: number, ok: truth, error: text

define parse_use_decl(tokens: [Token], start: number, n: number) -> UseStep:
    if start >= n:
        UseStep{name: "", next: start, ok: false, error: "expected a name after `use`"}
    else:
        t = tokens[start]
        choose t.tok:
            Ident(name) then UseStep{name: name, next: start + 1, ok: true, error: ""}
            _ then UseStep{name: "", next: start, ok: false, error: "expected a name after `use`"}

# ---- rule = "rule" IDENT "(" ")" ":" NEWLINE stmts ----

type RuleStep: rule: Rule, next: number, ok: truth, error: text

define parse_rule(tokens: [Token], start: number, n: number) -> RuleStep:
    # `when EXPR: body` short-circuits — it has no name/paren list.
    if match_tok(tokens, start, n, "When"):
        return parse_when_rule(tokens, start + 1, n)
    # `every N: body` desugars to when (tick % N is 0): body — same
    # runtime path, host just has to bind `tick` in ctx (atlas_astra does).
    if match_tok(tokens, start, n, "Every"):
        return parse_every_rule(tokens, start + 1, n)
    edit i = start
    # Accept either `rule NAME(...)` or `on EVENT(...)`. The latter is
    # a handler — same shape, but `trigger` is set so dispatch can find it.
    edit is_handler = false
    if match_tok(tokens, i, n, "On"):
        is_handler = true
        i = i + 1
        # Transition sugar: `on NAME becomes EXPR: body` desugars to a
        # `when NAME is EXPR: body` rule. Astra's edge semantics fire
        # exactly when NAME transitions to EXPR — cleaner than manual
        # `when X is Y and prev_X is not Y` guards.
        if i + 1 < n:
            after_name = ident_of(tokens[i].tok)
            if after_name is not "" and match_tok(tokens, i + 1, n, "Becomes"):
                target_step = parse_expr(tokens, i + 2, n)
                if not target_step.ok:
                    return RuleStep{rule: empty_rule(), next: target_step.next, ok: false, error: target_step.error}
                if not match_tok(tokens, target_step.next, n, "Colon"):
                    return RuleStep{rule: empty_rule(), next: target_step.next, ok: false, error: "expected `:` after `becomes` target"}
                edit bi = target_step.next + 1
                loop:
                    if bi >= n:
                        break
                    if is_newline(tokens[bi].tok):
                        bi = bi + 1
                    else:
                        break
                edit becomes_body = []
                loop:
                    if bi >= n:
                        break
                    t = tokens[bi]
                    if at_rule_starter(tokens, bi, n):
                        break
                    if is_newline(t.tok):
                        bi = bi + 1
                    else:
                        step = parse_stmt(tokens, bi, n)
                        if step.ok:
                            becomes_body = append(becomes_body, step.stmt)
                            bi = step.next
                        else:
                            return RuleStep{rule: empty_rule(), next: bi, ok: false, error: step.error}
                transition_cond = Binop("==", VarRef(after_name), target_step.value)
                return RuleStep{rule: Rule{name: "becomes:" + after_name, params: [], body: becomes_body, trigger: "$when", condition: transition_cond}, next: bi, ok: true, error: ""}
    else:
        if not match_tok(tokens, i, n, "Rule"):
            return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `rule`, `on`, or `when`"}
        i = i + 1
    # i points at the rule/event NAME token.
    if i >= n:
        return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected name"}
    name = ident_of(tokens[i].tok)
    if name is "":
        return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected name"}
    edit trigger = if is_handler then name else ""
    i = i + 1
    # Expect "("
    if not match_tok(tokens, i, n, "LParen"):
        return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `(`"}
    i = i + 1
    # Optional comma-separated ident params (no types in MVP).
    edit params = []
    loop:
        if i >= n:
            break
        if match_tok(tokens, i, n, "RParen"):
            break
        p_name = ident_of(tokens[i].tok)
        if p_name is "":
            return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected param name or `)`"}
        params = append(params, Param{name: p_name, type_name: ""})
        i = i + 1
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    if not match_tok(tokens, i, n, "RParen"):
        return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `)`"}
    i = i + 1
    # Optional guard: `on Click(x,y,b) when EXPR:` gates the handler at
    # dispatch — no body eval when EXPR is false. Cleaner than a leading
    # `require EXPR` inside the body: no crumb, no rule-id sink, and
    # facts/why-engine can read the guard directly off the rule.
    edit gate = LitBool(true)
    if match_tok(tokens, i, n, "When"):
        gate_step = parse_expr(tokens, i + 1, n)
        if not gate_step.ok:
            return RuleStep{rule: empty_rule(), next: gate_step.next, ok: false, error: gate_step.error}
        gate = gate_step.value
        i = gate_step.next
    # Optional cadence suffix: `on income() every 2s:` schedules this
    # handler on a wall-clock interval — same real-time scheduler as the
    # anonymous `every <dur>:` form. The trigger becomes "$every:<ms>" so
    # the engine's timer sweep dispatches it (the name is kept for facts).
    if match_tok(tokens, i, n, "Every"):
        i = i + 1
        cperiod = int_of(tokens[i].tok)
        i = i + 1
        cunit = if i < n then ident_of(tokens[i].tok) else ""
        edit cms = cperiod
        if cunit is "s":
            cms = cperiod * 1000
            i = i + 1
        else:
            if cunit is "m":
                cms = cperiod * 60000
                i = i + 1
            else:
                if cunit is "ms":
                    i = i + 1
        trigger = "$every:{cms}"
    # Expect ":"
    if not match_tok(tokens, i, n, "Colon"):
        return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `:`"}
    i = i + 1
    # Skip newlines into body.
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            i = i + 1
        else:
            break
    # Body: list of stmts until next top-level rule starter or EOF.
    edit body = []
    loop:
        if i >= n:
            break
        t = tokens[i]
        if at_rule_starter(tokens, i, n):
            break
        if is_newline(t.tok):
            i = i + 1
        else:
            step = parse_stmt(tokens, i, n)
            if step.ok:
                body = append(body, step.stmt)
                i = step.next
            else:
                return RuleStep{rule: empty_rule(), next: i, ok: false, error: step.error}
    RuleStep{rule: Rule{name: name, params: params, body: body, trigger: trigger, condition: gate}, next: i, ok: true, error: ""}

# `when EXPR : NEWLINE body` — produces a Rule with trigger="$when"
# and `condition` set to the watch expression. Body re-uses the same
# stmt grammar as `rule`/`on`.
define parse_when_rule(tokens: [Token], start: number, n: number) -> RuleStep:
    # `when spawned(Kind):` / `when destroyed(Kind):` — lifecycle triggers.
    if match_tok(tokens, start, n, "Spawned") or match_tok(tokens, start, n, "Destroyed"):
        is_spawned = match_tok(tokens, start, n, "Spawned")
        trigger_prefix = if is_spawned then "$spawned:" else "$destroyed:"
        edit i = start + 1
        if not match_tok(tokens, i, n, "LParen"):
            return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `(` after spawned/destroyed"}
        i = i + 1
        kind_name = ident_of(tokens[i].tok)
        if kind_name is "":
            return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected component type name in spawned(T)"}
        i = i + 1
        if not match_tok(tokens, i, n, "RParen"):
            return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `)` after component type in spawned(T)"}
        i = i + 1
        # Optional binding — `when spawned(Chair) c: body-uses-c`.
        # `c` binds to a MapV of the spawned entity's fields; body can
        # reference `c.at`, `c.tint` etc. Unifies the prefab pattern
        # (spawn an X, spawn its children using X's fields).
        edit bind_name = ""
        if not match_tok(tokens, i, n, "Colon"):
            bind_name = ident_of(tokens[i].tok)
            if bind_name is not "":
                i = i + 1
        if not match_tok(tokens, i, n, "Colon"):
            return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `:` after when spawned(T)"}
        i = i + 1
        loop:
            if i >= n:
                break
            if is_newline(tokens[i].tok):
                i = i + 1
            else:
                break
        edit body = []
        loop:
            if i >= n:
                break
            t = tokens[i]
            if at_rule_starter(tokens, i, n):
                break
            if is_newline(t.tok):
                i = i + 1
            else:
                step = parse_stmt(tokens, i, n)
                if step.ok:
                    body = append(body, step.stmt)
                    i = step.next
                else:
                    return RuleStep{rule: empty_rule(), next: i, ok: false, error: step.error}
        # If a binding name was given, expose it as the rule's first
        # param — dispatch passes the spawned entity's fields as args[0]
        # and eval binds them under the name. Empty name = no param =
        # a spawn trigger with no field binding.
        lifecycle_params = if length(bind_name) > 0 then append([], Param{name: bind_name, type_name: kind_name}) else []
        return RuleStep{rule: Rule{name: "", params: lifecycle_params, body: body, trigger: trigger_prefix + kind_name, condition: LitBool(true)}, next: i, ok: true, error: ""}
    # Regular `when COND:` — edge-triggered conditional.
    cond = parse_expr(tokens, start, n)
    if not cond.ok:
        return RuleStep{rule: empty_rule(), next: cond.next, ok: false, error: cond.error}
    edit i = cond.next
    if not match_tok(tokens, i, n, "Colon"):
        return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `:` after when condition"}
    i = i + 1
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            i = i + 1
        else:
            break
    edit body = []
    loop:
        if i >= n:
            break
        t = tokens[i]
        if at_rule_starter(tokens, i, n):
            break
        if is_newline(t.tok):
            i = i + 1
        else:
            step = parse_stmt(tokens, i, n)
            if step.ok:
                body = append(body, step.stmt)
                i = step.next
            else:
                return RuleStep{rule: empty_rule(), next: i, ok: false, error: step.error}
    RuleStep{rule: Rule{name: "", params: [], body: body, trigger: "$when", condition: cond.value}, next: i, ok: true, error: ""}

define at_rule_starter(tokens: [Token], i: number, n: number) -> truth:
    match_tok(tokens, i, n, "Rule") or match_tok(tokens, i, n, "On") or match_tok(tokens, i, n, "Every") or match_tok(tokens, i, n, "Fn") or match_tok(tokens, i, n, "When") or match_tok(tokens, i, n, "Component") or match_tok(tokens, i, n, "Type") or match_tok(tokens, i, n, "Entity") or match_tok(tokens, i, n, "Const") or match_tok(tokens, i, n, "Test") or match_tok(tokens, i, n, "Intent") or match_tok(tokens, i, n, "State") or match_tok(tokens, i, n, "Command") or match_tok(tokens, i, n, "View") or match_tok(tokens, i, n, "Source") or match_tok(tokens, i, n, "Animate") or match_tok(tokens, i, n, "Asset") or match_tok(tokens, i, n, "Trait") or match_tok(tokens, i, n, "Template") or match_tok(tokens, i, n, "Tokens")

# `fn NAME(params) -> TYPE: body-expr` — pure helper. Params may include
# optional `: type` annotations; we accept and discard them for now.
# Body is a single expression (parens/if-else compose naturally).
type FuncStep: func: Function, next: number, ok: truth, error: text

define parse_function(tokens: [Token], start: number, n: number) -> FuncStep:
    if start >= n:
        return FuncStep{func: empty_function(), next: start, ok: false, error: "expected fn name"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return FuncStep{func: empty_function(), next: start, ok: false, error: "expected fn name"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "LParen"):
        return FuncStep{func: empty_function(), next: i, ok: false, error: "expected `(` after fn name"}
    i = i + 1
    edit params = []
    loop:
        if i >= n:
            break
        if match_tok(tokens, i, n, "RParen"):
            break
        p_name = ident_of(tokens[i].tok)
        if p_name is "":
            return FuncStep{func: empty_function(), next: i, ok: false, error: "expected param name or `)`"}
        i = i + 1
        edit p_type = ""
        if match_tok(tokens, i, n, "Colon"):
            i = i + 1
            if i < n:
                p_type = ident_of(tokens[i].tok)
                if p_type is "":
                    return FuncStep{func: empty_function(), next: i, ok: false, error: "expected type name"}
                i = i + 1
        params = append(params, Param{name: p_name, type_name: p_type})
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    if not match_tok(tokens, i, n, "RParen"):
        return FuncStep{func: empty_function(), next: i, ok: false, error: "expected `)`"}
    i = i + 1
    edit ret_type = ""
    if match_tok(tokens, i, n, "Arrow"):
        i = i + 1
        if i < n:
            ret_type = ident_of(tokens[i].tok)
            if ret_type is "":
                return FuncStep{func: empty_function(), next: i, ok: false, error: "expected return type after `->`"}
            i = i + 1
    if not match_tok(tokens, i, n, "Colon"):
        return FuncStep{func: empty_function(), next: i, ok: false, error: "expected `:` before fn body"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    body = parse_expr(tokens, i, n)
    if not body.ok:
        return FuncStep{func: empty_function(), next: body.next, ok: false, error: body.error}
    FuncStep{func: Function{name: name, params: params, return_type: ret_type, body: body.value}, next: body.next, ok: true, error: ""}

define empty_function() -> Function:
    Function{name: "", params: [], return_type: "", body: LitInt(0)}

# Top-level `IDENT(...)` with no leading `fn` keyword is treated as a
# function definition. We peek for IDENT LParen and assume fn-shape
# (vs an unlikely top-level expression). All other top-level
# constructs use explicit keywords (rule/on/when/every/each/entity/const/fn).
define looks_like_implicit_fn(tokens: [Token], i: number, n: number) -> truth:
    if i >= n:
        return false
    if ident_of(tokens[i].tok) is "":
        return false
    match_tok(tokens, i + 1, n, "LParen")

# `entity Kind { f: type, f: type, ... }` — typed component declaration.
# Field types are accepted and stored for future checks but unenforced.
type EntityStep: entity: EntityDecl, next: number, ok: truth, error: text

define parse_entity_decl(tokens: [Token], start: number, n: number) -> EntityStep:
    if start >= n:
        return EntityStep{entity: empty_entity_decl(), next: start, ok: false, error: "expected entity name"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return EntityStep{entity: empty_entity_decl(), next: start, ok: false, error: "expected entity name"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "LBrace"):
        return EntityStep{entity: empty_entity_decl(), next: i, ok: false, error: "expected LBrace after entity name"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    edit fields = []
    loop:
        if i >= n:
            break
        if match_tok(tokens, i, n, "RBrace"):
            break
        f_name = ident_of(tokens[i].tok)
        if f_name is "":
            return EntityStep{entity: empty_entity_decl(), next: i, ok: false, error: "expected field name"}
        i = i + 1
        edit f_type = ""
        if match_tok(tokens, i, n, "Colon"):
            i = i + 1
            if i < n:
                f_type = ident_of(tokens[i].tok)
                if f_type is "":
                    return EntityStep{entity: empty_entity_decl(), next: i, ok: false, error: "expected field type"}
                i = i + 1
        fields = append(fields, Param{name: f_name, type_name: f_type})
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
        i = skip_newlines(tokens, i, n)
    if match_tok(tokens, i, n, "RBrace"):
        i = i + 1
    EntityStep{entity: EntityDecl{name: name, fields: fields}, next: i, ok: true, error: ""}

define empty_entity_decl() -> EntityDecl:
    EntityDecl{name: "", fields: []}

# `component Kind { f: type, f: type, ... }` — ECS component declaration.
# Identical structure to entity but signals that atlas_astra should
# register the type directly in world storage (no manual pack_* glue).
type ComponentStep: component: ComponentDecl, uses_traits: [text], next: number, ok: truth, error: text

define parse_component_decl(tokens: [Token], start: number, n: number, traits: [TraitDecl]) -> ComponentStep:
    if start >= n:
        return ComponentStep{component: empty_component_decl(), uses_traits: [], next: start, ok: false, error: "expected component name"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return ComponentStep{component: empty_component_decl(), uses_traits: [], next: start, ok: false, error: "expected component name"}
    edit i = start + 1
    # Optional `uses A, B, C` — inline each named trait's fields into
    # this type. Bundle-local; traits declared later in the same file
    # aren't visible here (parse-order-dependent). Trait names also
    # recorded for cross-type queries (`each e in Movable`).
    edit fields = []
    edit used_traits = []
    used_here = ident_of(tokens[i].tok)
    if used_here is "uses":
        i = i + 1
        loop:
            if i >= n:
                break
            tname = ident_of(tokens[i].tok)
            if tname is "":
                break
            i = i + 1
            used_traits = append(used_traits, tname)
            tf = trait_fields(traits, tname)
            loop tp in tf:
                fields = append(fields, tp)
            if match_tok(tokens, i, n, "Comma"):
                i = i + 1
            else:
                break
    # v1: brace-less only. Fields comma-separated, terminated by newline.
    if match_tok(tokens, i, n, "LBrace"):
        return ComponentStep{component: empty_component_decl(), uses_traits: [], next: i, ok: false, error: "braces not allowed for type — use `type X f: t, f: t`"}
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            break
        f_name = ident_of(tokens[i].tok)
        if f_name is "":
            return ComponentStep{component: empty_component_decl(), uses_traits: [], next: i, ok: false, error: "expected field name in type"}
        i = i + 1
        edit f_type = ""
        if match_tok(tokens, i, n, "Colon"):
            i = i + 1
            if i < n:
                f_type = ident_of(tokens[i].tok)
                if f_type is "":
                    return ComponentStep{component: empty_component_decl(), uses_traits: [], next: i, ok: false, error: "expected field type in type decl"}
                i = i + 1
        fields = append(fields, Param{name: f_name, type_name: f_type})
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    ComponentStep{component: ComponentDecl{name: name, fields: fields}, uses_traits: used_traits, next: i, ok: true, error: ""}

# Look up a trait by name and return its fields (empty if unknown —
# unknown trait fires no fields; the user's own decl still lands).
define trait_fields(traits: [TraitDecl], name: text) -> [Param]:
    n = length(traits)
    edit i = 0
    edit out = []
    loop:
        if i >= n:
            break
        t = trait_at(traits, i)
        if t.name is name:
            out = t.fields
            break
        i = i + 1
    out

define trait_at(xs: [TraitDecl], i: number) -> TraitDecl:
    xs[i]

# `trait X { field: type }` — reuses the component field-parsing but
# stores as a TraitDecl. No composition allowed on traits themselves
# in v1 (a trait can't `uses` another trait).
type TraitStep: trait_decl: TraitDecl, next: number, ok: truth, error: text

define parse_trait_decl(tokens: [Token], start: number, n: number) -> TraitStep:
    empty = TraitDecl{name: "", fields: []}
    cstep = parse_component_decl(tokens, start, n, [])
    if not cstep.ok:
        return TraitStep{trait_decl: empty, next: cstep.next, ok: false, error: cstep.error}
    TraitStep{trait_decl: TraitDecl{name: cstep.component.name, fields: cstep.component.fields}, next: cstep.next, ok: true, error: ""}

define empty_component_decl() -> ComponentDecl:
    ComponentDecl{name: "", fields: []}

type ConstStep: cnst: ConstDecl, next: number, ok: truth, error: text

define parse_const_decl(tokens: [Token], start: number, n: number) -> ConstStep:
    if start >= n:
        return ConstStep{cnst: ConstDecl{name: "", value: LitInt(0)}, next: start, ok: false, error: "expected const name"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return ConstStep{cnst: ConstDecl{name: "", value: LitInt(0)}, next: start, ok: false, error: "expected const name"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Assign"):
        return ConstStep{cnst: ConstDecl{name: name, value: LitInt(0)}, next: i, ok: false, error: "expected = after const name"}
    i = i + 1
    val_step = parse_expr(tokens, i, n)
    if not val_step.ok:
        return ConstStep{cnst: ConstDecl{name: name, value: LitInt(0)}, next: val_step.next, ok: false, error: val_step.error}
    ConstStep{cnst: ConstDecl{name: name, value: val_step.value}, next: val_step.next, ok: true, error: ""}

# `data NAME(col, col, …):` NEWLINE (indent) row* — a data TABLE with a
# NAMED schema. Each row's positional values fill the columns IN ORDER
# (bareword = symbol, "quoted" = text, 123 = int), then optional
# `key: value` pairs override/extend. So
#   data commands(id, label):
#       menu      "Open Menu"
#       minimize  "Minimize window"  hint: "Ctrl M"
# desugars to `const commands = [ {id: menu, label: "Open Menu"}, … ]`.
# The header is what makes `.id`/`.label` DERIVABLE, not a special case —
# only real text is quoted. It's a const list, so `for`/`each` iterates it.
define looks_like_data_decl(tokens: [Token], i: number, n: number) -> truth:
    if i + 2 >= n:
        false
    else:
        if not fe_name_eq(ident_of(tokens[i].tok), "data"):
            false
        else:
            if ident_of(tokens[i + 1].tok) is "":
                false
            else:
                match_tok(tokens, i + 2, n, "LParen")

define parse_data_decl(tokens: [Token], start: number, n: number) -> ConstStep:
    block_col = tokens[start].col
    name = ident_of(tokens[start + 1].tok)
    edit i = start + 2
    if not match_tok(tokens, i, n, "LParen"):
        return ConstStep{cnst: ConstDecl{name: "", value: LitInt(0)}, next: i, ok: false, error: "expected `(` after `data NAME`"}
    i = i + 1
    edit cols = []
    loop:
        if i >= n:
            return ConstStep{cnst: ConstDecl{name: "", value: LitInt(0)}, next: i, ok: false, error: "unterminated column list"}
        if match_tok(tokens, i, n, "RParen"):
            i = i + 1
            break
        cn = ident_of(tokens[i].tok)
        if cn is "":
            return ConstStep{cnst: ConstDecl{name: "", value: LitInt(0)}, next: i, ok: false, error: "expected column name in `data NAME(...)`"}
        cols = append(cols, cn)
        i = i + 1
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    if not match_tok(tokens, i, n, "Colon"):
        return ConstStep{cnst: ConstDecl{name: name, value: LitInt(0)}, next: i, ok: false, error: "expected `:` after `data NAME(cols)`"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    edit rows = []
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            i = i + 1
        else:
            if tokens[i].col <= block_col:
                break
            row = parse_data_row(tokens, i, n, cols)
            if not row.ok:
                return ConstStep{cnst: ConstDecl{name: name, value: LitList(rows)}, next: row.next, ok: false, error: row.error}
            rows = append(rows, row.value)
            i = row.next
    ConstStep{cnst: ConstDecl{name: name, value: LitList(rows)}, next: i, ok: true, error: ""}

# One table row → a MapLit. Positional values (bareword / string / int)
# fill `cols` in order until a `key:` pair begins; then explicit fields.
define parse_data_row(tokens: [Token], start: number, n: number, cols: [text]) -> ExprStep:
    edit fields = []
    edit i = start
    edit col_idx = 0
    loop:
        if i >= n or is_newline(tokens[i].tok):
            break
        # A `key: value` pair (ident then colon) ends the positional run.
        if ident_of(tokens[i].tok) is not "" and match_tok(tokens, i + 1, n, "Colon"):
            break
        if col_idx >= length(cols):
            break
        tok = tokens[i]
        if is_str_tok(tok.tok):
            fields = append(fields, FieldExpr{name: cols[col_idx], value: text_lit_expr(token_text(tok.tok))})
        else:
            iv = int_of(tok.tok)
            if iv >= 0:
                fields = append(fields, FieldExpr{name: cols[col_idx], value: LitInt(iv)})
            else:
                fields = append(fields, FieldExpr{name: cols[col_idx], value: LitText(ident_of(tok.tok))})
        col_idx = col_idx + 1
        i = i + 1
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    loop:
        if i >= n or is_newline(tokens[i].tok):
            break
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
        else:
            fstep = parse_map_field(tokens, i, n)
            if not fstep.ok:
                return ExprStep{value: MapLit(fields), next: fstep.next, ok: false, error: fstep.error}
            fields = append(fields, fstep.field)
            i = fstep.next
    ExprStep{value: MapLit(fields), next: i, ok: true, error: ""}

# `test NAME:` NEWLINE step* — an inline test (pillar 5). Steps are
# `apply CALL`, `tick N`, `expect COND`, one per line, more indented than the
# `test` keyword. The body ends on a dedent (a token at or left of the `test`
# column) or a top-level starter. The runner (astra_run::run_tests) executes
# each step against a fresh effect accumulator.
type TestDeclStep: test: TestCase, next: number, ok: truth, error: text

define parse_test_decl(tokens: [Token], start: number, n: number) -> TestDeclStep:
    empty = TestCase{name: "", steps: []}
    if start >= n:
        return TestDeclStep{test: empty, next: start, ok: false, error: "expected name after `test`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return TestDeclStep{test: empty, next: start, ok: false, error: "expected name after `test`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Colon"):
        return TestDeclStep{test: empty, next: i, ok: false, error: "expected `:` after test name"}
    i = i + 1
    # Column of the `test` keyword — a step at or left of it is a dedent.
    test_col = if start >= 1 then tokens[start - 1].col else 0
    i = skip_newlines(tokens, i, n)
    edit steps = []
    loop:
        if i >= n:
            break
        t = tokens[i]
        if is_newline(t.tok):
            i = i + 1
        else:
            if at_rule_starter(tokens, i, n):
                break
            if t.col <= test_col:
                break
            step = parse_test_step(tokens, i, n)
            if not step.ok:
                return TestDeclStep{test: empty, next: step.next, ok: false, error: step.error}
            steps = append(steps, step.step)
            i = step.next
    TestDeclStep{test: TestCase{name: name, steps: steps}, next: i, ok: true, error: ""}

type TestStepStep: step: TestStep, next: number, ok: truth, error: text

define empty_test_step() -> TestStep:
    TestStep{kind: "", name: "", args: [], cond: LitBool(false)}

define parse_test_step(tokens: [Token], start: number, n: number) -> TestStepStep:
    if match_tok(tokens, start, n, "Apply"):
        return parse_apply_step(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Expect"):
        estep = parse_expr(tokens, start + 1, n)
        if not estep.ok:
            return TestStepStep{step: empty_test_step(), next: estep.next, ok: false, error: estep.error}
        return TestStepStep{step: TestStep{kind: "expect", name: "", args: [], cond: estep.value}, next: estep.next, ok: true, error: ""}
    # `tick N` — `tick` is an unreserved identifier by design (hosts inject it
    # as a ctx binding), so match it textually here in the test sub-grammar.
    if ident_of(tokens[start].tok) is "tick":
        vstep = parse_expr(tokens, start + 1, n)
        if not vstep.ok:
            return TestStepStep{step: empty_test_step(), next: vstep.next, ok: false, error: vstep.error}
        return TestStepStep{step: TestStep{kind: "tick", name: "", args: [], cond: vstep.value}, next: vstep.next, ok: true, error: ""}
    TestStepStep{step: empty_test_step(), next: start, ok: false, error: "expected `apply`, `tick`, or `expect` in test body"}

# `apply NAME(args)` — start points at the rule NAME. Args are optional.
define parse_apply_step(tokens: [Token], start: number, n: number) -> TestStepStep:
    if start >= n:
        return TestStepStep{step: empty_test_step(), next: start, ok: false, error: "expected rule name after `apply`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return TestStepStep{step: empty_test_step(), next: start, ok: false, error: "expected rule name after `apply`"}
    edit i = start + 1
    edit args = []
    if match_tok(tokens, i, n, "LParen"):
        i = i + 1
        if match_tok(tokens, i, n, "RParen"):
            i = i + 1
        else:
            loop:
                astep = parse_expr(tokens, i, n)
                if not astep.ok:
                    return TestStepStep{step: empty_test_step(), next: astep.next, ok: false, error: astep.error}
                args = append(args, astep.value)
                i = astep.next
                if match_tok(tokens, i, n, "Comma"):
                    i = i + 1
                else:
                    break
            if not match_tok(tokens, i, n, "RParen"):
                return TestStepStep{step: empty_test_step(), next: i, ok: false, error: "expected `)` after apply args"}
            i = i + 1
    TestStepStep{step: TestStep{kind: "apply", name: name, args: args, cond: LitBool(false)}, next: i, ok: true, error: ""}

# `derive NAME = EXPR` — a resource that is ALWAYS its expression. It
# desugars to a rule that recomputes NAME from EXPR every tick, so it
# reuses the whole rule -> dispatch -> set pipeline with no new AST
# node. The program describes what is TRUE (`derive alive = health > 0`)
# instead of when to recompute it (idea #1: a dependency net, not an
# instruction list). v1 recomputes every tick; a facts-driven
# recompute-only-when-a-dep-changed pass is the follow-up.
define parse_derive_decl(tokens: [Token], start: number, n: number) -> RuleStep:
    empty = Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}
    if start >= n:
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `derive`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `derive`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Assign"):
        return RuleStep{rule: empty, next: i, ok: false, error: "expected `=` after derive name"}
    i = i + 1
    val_step = parse_expr(tokens, i, n)
    if not val_step.ok:
        return RuleStep{rule: empty, next: val_step.next, ok: false, error: val_step.error}
    body = append([], SetVar(name, val_step.value))
    # `$derive`, not "Tick": a view is a definition that is ALWAYS its
    # expression, so it recomputes every sims pass — including the boot
    # pass, before any Tick event exists. Binding it to Tick left every
    # view unset on the first frame (`{view}` empty, `show:` gates 0).
    r = Rule{name: "derive:" + name, params: [], body: body, trigger: "$derive", condition: LitBool(true)}
    RuleStep{rule: r, next: val_step.next, ok: true, error: ""}

# `law NAME:` then a rule — names the rule after the law. Pure sugar
# over the following when/on rule (A2, idea #7): `law Gravity: when ...`
# reads as a world law and gives an otherwise-anonymous rule a name, so
# facts, the why-engine, and quarantine all identify it as `Gravity`.
define parse_law_decl(tokens: [Token], start: number, n: number) -> RuleStep:
    empty = Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}
    if start >= n:
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `law`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `law`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Colon"):
        return RuleStep{rule: empty, next: i, ok: false, error: "expected `:` after law name"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    rstep = parse_rule(tokens, i, n)
    if not rstep.ok:
        return rstep
    src = rstep.rule
    named = Rule{name: name, params: src.params, body: src.body, trigger: src.trigger, condition: src.condition}
    RuleStep{rule: named, next: rstep.next, ok: true, error: ""}

# `state NAME: TYPE [in A to B | in A through B] = INIT` — typed world
# resource declaration. PURE PARSER SUGAR: desugars to (a) a SetVar in a
# synthetic on Init() rule so the resource is seeded on boot/restart,
# and (b) a bounds record consulted at end-of-parse to clamp every
# SetVar targeting this name across ALL rules in the source.
#
# Type presets (all lex as Ident):
#   int              -> no bounds
#   nat              -> min 0
#   percent          -> 0 through 100
# Explicit `in A to B` / `in A through B` overrides the preset.
# Bounds are integer-literal only in v1 (no expression bounds).
type StateBound: name: text, has_min: truth, min_val: number, has_max: truth, max_val: number
type StateStep: init: Stmt, bound: StateBound, enum_consts: [ConstDecl], next: number, ok: truth, error: text

# The resource name a state's synthesised init writes — its `SetVar` target.
define state_name_of(st: Stmt) -> text:
    choose st:
        SetVar(nm, _) then nm
        _ then ""

define parse_state_decl(tokens: [Token], start: number, n: number) -> StateStep:
    empty_stmt = SetVar("", LitInt(0))
    empty_bound = StateBound{name: "", has_min: false, min_val: 0, has_max: false, max_val: 0}
    if start >= n:
        return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: start, ok: false, error: "expected name after `state`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: start, ok: false, error: "expected name after `state`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Colon"):
        return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected `:` after state name"}
    i = i + 1
    type_name = ident_of(tokens[i].tok)
    if type_name is "":
        return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected type name after `:`"}
    i = i + 1
    # Apply type preset first — explicit `in ...` below overrides.
    edit has_min = false
    edit min_v = 0
    edit has_max = false
    edit max_v = 0
    edit enum_consts = []
    if type_name is "nat":
        has_min = true
        min_v = 0
    if type_name is "percent":
        has_min = true
        min_v = 0
        has_max = true
        max_v = 100
    # `enum(a, b, c)` — named integer states. Each value binds as a
    # top-level const (a=0, b=1, c=2) so rules can write `game_over = dead`
    # and `when game_over is survived: ...` instead of magic-number 0/1/2.
    # Bounds are auto-set from the value count.
    if type_name is "enum":
        if not match_tok(tokens, i, n, "LParen"):
            return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected `(` after `enum`"}
        i = i + 1
        edit idx = 0
        loop:
            if i >= n:
                return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "unterminated enum"}
            if match_tok(tokens, i, n, "RParen"):
                i = i + 1
                break
            ev_name = ident_of(tokens[i].tok)
            if ev_name is "":
                return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected enum value name"}
            enum_consts = append(enum_consts, ConstDecl{name: ev_name, value: LitInt(idx)})
            idx = idx + 1
            i = i + 1
            if match_tok(tokens, i, n, "Comma"):
                i = i + 1
        has_min = true
        min_v = 0
        has_max = true
        max_v = idx - 1
    # `text` and `bool` skip the numeric branch — no bounds, no clamp.
    # A `bool` reads/writes as int 0/1 (apply_set coerces BoolV → 1/0), so
    # `= true`/`= false`, `needs not X`, and `show: X` all work uniformly.
    if type_name is not "int" and type_name is not "nat" and type_name is not "percent" and type_name is not "text" and type_name is not "bool" and type_name is not "enum":
        return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "unknown state type `{type_name}` (expected int, nat, percent, text, bool, or enum)"}
    # Optional explicit range: `in A to B` (half-open) or `in A through B` (inclusive)
    if match_tok(tokens, i, n, "In"):
        i = i + 1
        lo = int_of(tokens[i].tok)
        if lo < 0:
            return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected int literal for lower bound"}
        i = i + 1
        edit inclusive = false
        if match_tok(tokens, i, n, "Through"):
            inclusive = true
        else:
            if not match_tok(tokens, i, n, "To"):
                return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected `to` or `through` in state range"}
        i = i + 1
        hi = int_of(tokens[i].tok)
        if hi < 0:
            return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected int literal for upper bound"}
        i = i + 1
        has_min = true
        min_v = lo
        has_max = true
        max_v = if inclusive then hi else hi - 1
    if not match_tok(tokens, i, n, "Assign"):
        return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: i, ok: false, error: "expected `=` after state type"}
    i = i + 1
    init_step = parse_expr(tokens, i, n)
    if not init_step.ok:
        return StateStep{init: empty_stmt, bound: empty_bound, enum_consts: [], next: init_step.next, ok: false, error: init_step.error}
    bound = StateBound{name: name, has_min: has_min, min_val: min_v, has_max: has_max, max_val: max_v}
    StateStep{init: SetVar(name, init_step.value), bound: bound, enum_consts: enum_consts, next: init_step.next, ok: true, error: ""}

# Wrap `expr` in a clamp: LetIn binds expr once, then IfExpr chain
# saturates to [min, max]. No-op branches are omitted when only one
# side is bounded (nat = min only). __clamp_v is a reserved local name;
# users shouldn't collide (double-underscore prefix).
define clamp_expr(value: Expr, bound: StateBound) -> Expr:
    if not bound.has_min and not bound.has_max:
        value
    else:
        v = VarRef("__clamp_v")
        core = if bound.has_max then IfExpr(Binop(">", v, LitInt(bound.max_val)), LitInt(bound.max_val), v) else v
        full = if bound.has_min then IfExpr(Binop("<", v, LitInt(bound.min_val)), LitInt(bound.min_val), core) else core
        LetIn("__clamp_v", value, full)

# Find bound for `name` in the table; returns empty (no-op) bound when absent.
define bound_for(bounds: [StateBound], name: text) -> StateBound:
    n = length(bounds)
    edit i = 0
    edit found = StateBound{name: "", has_min: false, min_val: 0, has_max: false, max_val: 0}
    loop:
        if i >= n:
            break
        b = bound_at(bounds, i)
        if b.name is name:
            found = b
            break
        i = i + 1
    found

define bound_at(bs: [StateBound], i: number) -> StateBound:
    bs[i]

# Rewrite every SetVar in `stmts` whose name is bounded, wrapping its
# value in a clamp. Descends into ForEach and IfStmt bodies so nested
# writes get the same treatment. SetField is untouched (component
# fields, not resources).
define rewrite_setvars_stmts(stmts: [Stmt], bounds: [StateBound]) -> [Stmt]:
    n = length(stmts)
    edit out = []
    loop i in 0 until n:
        out = append(out, rewrite_setvars_stmt(stmts[i], bounds))
    out

define rewrite_setvars_stmt(s: Stmt, bounds: [StateBound]) -> Stmt:
    choose s:
        SetVar(name, value) then SetVar(name, clamp_expr(value, bound_for(bounds, name)))
        ForEach(iter_name, list_expr, filter_expr, body) then ForEach(iter_name, list_expr, filter_expr, rewrite_setvars_stmts(body, bounds))
        IfStmt(cond, body) then IfStmt(cond, rewrite_setvars_stmts(body, bounds))
        _ then s

define rewrite_setvars_rules(rules: [Rule], bounds: [StateBound]) -> [Rule]:
    n = length(rules)
    edit out = []
    loop i in 0 until n:
        r = state_rule_at(rules, i)
        out = append(out, Rule{name: r.name, params: r.params, body: rewrite_setvars_stmts(r.body, bounds), trigger: r.trigger, condition: r.condition})
    out

define state_rule_at(rules: [Rule], i: number) -> Rule:
    rules[i]

# `command NAME [needs EXPR]: body` — a player-facing action.
# PURE PARSER SUGAR: desugars to a `when` rule watching `ui_action is 
# "NAME"`; the body consumes the intent (writes ui_action = "") and then
# runs the effect, optionally gated by `needs`. Same shape as the
# manual pattern in a game, but named, gated, and consumed in one line
# per command.
#
#   command tend_fire needs wood >= 1:
#       wood = wood - 1
#       heat = heat + 10
#
# becomes:
#
#   when ui_action is "tend_fire":
#       ui_action = ""
#       if wood >= 1:
#           wood = wood - 1
#           heat = heat + 10
#
# The intent bus is a shared text resource `ui_action` — callers
# (click handlers, network layer, AI planner) all write the command
# name to it. Text lets facts/why/log identify commands by name
# without a manual code-number table.
# Stable name→code hash for NAMED actions (djb2 — orion has no `^`, so
# not FNV). Folded into [1000, 1_001_000) to stay clear of hand-written
# small codes (< 1000). PUBLIC and single-source: atlas_project's
# route_widget_clicks calls THIS (names are global in the flattened
# build), so a widget's `do: NAME` and a `command NAME:` always agree.
public define action_code(name: text) -> number:
    bs = bytes_of(name)
    cnt = bytes_count(bs)
    edit h = 5381
    edit idx = 0
    loop:
        if idx >= cnt:
            break
        h = h * 33 + byte_at(bs, idx)
        idx = idx + 1
    m = 1000000
    hm = h - (h // m) * m
    pos = if hm < 0 then 0 - hm else hm
    1000 + pos

define parse_command_decl(tokens: [Token], start: number, n: number) -> RuleStep:
    empty = Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}
    if start >= n:
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `command`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `command`"}
    edit i = start + 1
    # The dispatch code is DERIVED from the name (action_code); a widget's
    # `do: close` maps to the same value, so there is never a magic number.
    code = action_code(name)
    # Optional `needs EXPR` — precondition wrapping the effect body.
    edit gate = LitBool(true)
    if match_tok(tokens, i, n, "Needs"):
        gate_step = parse_expr(tokens, i + 1, n)
        if not gate_step.ok:
            return RuleStep{rule: empty, next: gate_step.next, ok: false, error: gate_step.error}
        gate = gate_step.value
        i = gate_step.next
    if not match_tok(tokens, i, n, "Colon"):
        return RuleStep{rule: empty, next: i, ok: false, error: "expected `:` after command header"}
    i = i + 1
    # Skip newlines into body.
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            i = i + 1
        else:
            break
    # Body stmts until the next top-level rule starter or EOF.
    edit body_stmts = []
    loop:
        if i >= n:
            break
        t = tokens[i]
        if at_rule_starter(tokens, i, n):
            break
        if is_newline(t.tok):
            i = i + 1
        else:
            step = parse_stmt(tokens, i, n)
            if step.ok:
                body_stmts = append(body_stmts, step.stmt)
                i = step.next
            else:
                return RuleStep{rule: empty, next: i, ok: false, error: step.error}
    # Build the desugared rule body: consume the intent first (so the
    # trigger condition falls false immediately), then run the effect —
    # gated by `if needs` when a precondition was given. IfStmt (not
    # require) so the consume survives even when the effect is skipped;
    # require's abort discards ALL prior effects including the consume.
    consume = SetVar("ui_action", LitInt(0))
    gated_body = if is_lit_true(gate) then body_stmts else append([], IfStmt(gate, body_stmts))
    full_body = push_front_stmt(consume, gated_body)
    trigger_cond = Binop("==", VarRef("ui_action"), LitInt(code))
    r = Rule{name: "cmd:" + name, params: [], body: full_body, trigger: "$when", condition: trigger_cond}
    RuleStep{rule: r, next: i, ok: true, error: ""}

define is_lit_true(e: Expr) -> truth:
    choose e:
        LitBool(b) then b
        _ then false

define push_front_stmt(head: Stmt, rest: [Stmt]) -> [Stmt]:
    edit out = append([], head)
    n = length(rest)
    loop i in 0 until n:
        out = append(out, stmt_at(rest, i))
    out

define stmt_at(xs: [Stmt], i: number) -> Stmt:
    xs[i]

# `animate NAME from A to B over N unit` — one-shot tween at boot.
# Atlas records start time, per-frame writes the interpolated value
# to the prefixed resource `NAME`. Linear easing, int endpoints in v1.
type AnimStep: anim: AnimationDecl, next: number, ok: truth, error: text

# `asset NAME: kind "path"` — typed asset ref. Kind is an ident
# (sprite/audio/text/shader/font). Atlas verifies file at boot, wires
# name→path so widgets can say `sprite: NAME` instead of raw strings.
type AssetStep: asset: AssetDecl, next: number, ok: truth, error: text

define parse_asset_decl(tokens: [Token], start: number, n: number) -> AssetStep:
    empty = AssetDecl{name: "", kind: "", path: ""}
    if start >= n:
        return AssetStep{asset: empty, next: start, ok: false, error: "expected name after `asset`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return AssetStep{asset: empty, next: start, ok: false, error: "expected name after `asset`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Colon"):
        return AssetStep{asset: empty, next: i, ok: false, error: "expected `:` after asset name"}
    i = i + 1
    kind_name = ident_of(tokens[i].tok)
    if kind_name is "":
        return AssetStep{asset: empty, next: i, ok: false, error: "expected asset kind (sprite/audio/text/shader/font)"}
    i = i + 1
    path_text = token_text(tokens[i].tok)
    if length(path_text) is 0:
        return AssetStep{asset: empty, next: i, ok: false, error: "expected string path after asset kind"}
    i = i + 1
    AssetStep{asset: AssetDecl{name: name, kind: kind_name, path: path_text}, next: i, ok: true, error: ""}

define parse_animate_decl(tokens: [Token], start: number, n: number) -> AnimStep:
    empty = AnimationDecl{name: "", from_val: 0, to_val: 0, duration_ms: 0, trigger_name: "", trigger_value: 0, easing: "linear"}
    if start >= n:
        return AnimStep{anim: empty, next: start, ok: false, error: "expected name after `animate`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return AnimStep{anim: empty, next: start, ok: false, error: "expected name after `animate`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "From"):
        return AnimStep{anim: empty, next: i, ok: false, error: "expected `from` after animate name"}
    i = i + 1
    from_v = int_of(tokens[i].tok)
    if from_v < 0:
        return AnimStep{anim: empty, next: i, ok: false, error: "expected int literal for animate `from`"}
    i = i + 1
    if not match_tok(tokens, i, n, "To"):
        return AnimStep{anim: empty, next: i, ok: false, error: "expected `to` in animate"}
    i = i + 1
    to_v = int_of(tokens[i].tok)
    if to_v < 0:
        return AnimStep{anim: empty, next: i, ok: false, error: "expected int literal for animate `to`"}
    i = i + 1
    over_ident = ident_of(tokens[i].tok)
    if over_ident is not "over":
        return AnimStep{anim: empty, next: i, ok: false, error: "expected `over` in animate"}
    i = i + 1
    dur_n = int_of(tokens[i].tok)
    if dur_n < 0:
        return AnimStep{anim: empty, next: i, ok: false, error: "expected int duration in animate"}
    i = i + 1
    unit = ident_of(tokens[i].tok)
    dur_ms = if unit is "s" then dur_n * 1000 else if unit is "ms" then dur_n else 0
    if dur_ms is 0:
        return AnimStep{anim: empty, next: i, ok: false, error: "expected `s` or `ms` after duration"}
    i = i + 1
    # Optional easing: `ease FUNC` — linear/out-cubic/in-cubic/
    # in-out-cubic/out-bounce. Default is linear.
    edit easing_fn = "linear"
    if ident_of(tokens[i].tok) is "ease":
        i = i + 1
        ename = ident_of(tokens[i].tok)
        if ename is "":
            return AnimStep{anim: empty, next: i, ok: false, error: "expected easing name after `ease`"}
        easing_fn = ename
        i = i + 1
    # Optional trigger: `when NAME becomes VALUE`. Without it, tween
    # runs once at boot. With it, tween resets on every rising edge
    # of NAME transitioning to VALUE.
    edit trig_name = ""
    edit trig_val = 0
    if match_tok(tokens, i, n, "When"):
        i = i + 1
        tn = ident_of(tokens[i].tok)
        if tn is "":
            return AnimStep{anim: empty, next: i, ok: false, error: "expected trigger name after `when`"}
        i = i + 1
        if not match_tok(tokens, i, n, "Becomes"):
            return AnimStep{anim: empty, next: i, ok: false, error: "expected `becomes` after trigger name"}
        i = i + 1
        tv = int_of(tokens[i].tok)
        if tv < 0:
            # Also accept an ident (enum name) — resolved at runtime via
            # world resource lookup. For MVP we require int literal
            # (enum values also compile to int world resources so this
            # works after enum → const propagation).
            id_name = ident_of(tokens[i].tok)
            if id_name is "":
                return AnimStep{anim: empty, next: i, ok: false, error: "expected int or ident for `becomes` target"}
            # For MVP: unknown ident becomes value 0. Better: resolve at
            # runtime. Follow-up.
            trig_name = tn
            trig_val = 0
        else:
            trig_name = tn
            trig_val = tv
        i = i + 1
    AnimStep{anim: AnimationDecl{name: name, from_val: from_v, to_val: to_v, duration_ms: dur_ms, trigger_name: trig_name, trigger_value: trig_val, easing: easing_fn}, next: i, ok: true, error: ""}

# `source NAME from file "path" [refresh N s]` — declares an external
# data feed. Atlas reads the file at boot and (later) on a refresh
# cadence, exposing the contents as the world resource `NAME`.
# `from` and unit keywords (`s`/`ms`) reuse existing lexer tokens.
type SourceStep: source: SourceDecl, next: number, ok: truth, error: text

define parse_source_decl(tokens: [Token], start: number, n: number) -> SourceStep:
    empty = SourceDecl{name: "", kind: "", path: "", refresh_ms: 0}
    if start >= n:
        return SourceStep{source: empty, next: start, ok: false, error: "expected name after `source`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return SourceStep{source: empty, next: start, ok: false, error: "expected name after `source`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "From"):
        return SourceStep{source: empty, next: i, ok: false, error: "expected `from` after source name"}
    i = i + 1
    kind_name = ident_of(tokens[i].tok)
    if kind_name is "":
        return SourceStep{source: empty, next: i, ok: false, error: "expected kind after `from` (v1 supports `file`)"}
    if kind_name is not "file":
        return SourceStep{source: empty, next: i, ok: false, error: "only `file` sources supported in v1 (http/ws/mmo later)"}
    i = i + 1
    path_text = token_text(tokens[i].tok)
    if length(path_text) is 0:
        return SourceStep{source: empty, next: i, ok: false, error: "expected string path after source kind"}
    i = i + 1
    edit refresh_ms = 0
    # Optional `refresh N s|ms`
    ident_here = ident_of(tokens[i].tok)
    if ident_here is "refresh":
        i = i + 1
        n_val = int_of(tokens[i].tok)
        if n_val < 0:
            return SourceStep{source: empty, next: i, ok: false, error: "expected int after `refresh`"}
        i = i + 1
        unit = if i < n then ident_of(tokens[i].tok) else ""
        if unit is "s":
            refresh_ms = n_val * 1000
            i = i + 1
        else:
            if unit is "ms":
                refresh_ms = n_val
                i = i + 1
            else:
                return SourceStep{source: empty, next: i, ok: false, error: "expected `s` or `ms` after refresh interval"}
    SourceStep{source: SourceDecl{name: name, kind: kind_name, path: path_text, refresh_ms: refresh_ms}, next: i, ok: true, error: ""}

# `template NAME(params) = EXPR` — parameterised fragment. Shape is
# fn-like (name + paren-params + body) but signalled with `=` instead
# of `:` because the body is a single expression, not a statement
# block. Runtime callers (`items:` on a Panel) invoke by name and bind
# args positionally.
type TemplateStep: template: TemplateDecl, next: number, ok: truth, error: text

define parse_template_decl(tokens: [Token], start: number, n: number) -> TemplateStep:
    empty = TemplateDecl{name: "", params: [], body: LitInt(0)}
    if start >= n:
        return TemplateStep{template: empty, next: start, ok: false, error: "expected template name"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return TemplateStep{template: empty, next: start, ok: false, error: "expected template name"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "LParen"):
        return TemplateStep{template: empty, next: i, ok: false, error: "expected `(` after template name"}
    i = i + 1
    edit params = []
    loop:
        if i >= n:
            break
        if match_tok(tokens, i, n, "RParen"):
            break
        param_name = ident_of(tokens[i].tok)
        if param_name is "":
            return TemplateStep{template: empty, next: i, ok: false, error: "expected param name or `)` in template"}
        i = i + 1
        edit param_type = ""
        if match_tok(tokens, i, n, "Colon"):
            i = i + 1
            if i < n:
                param_type = ident_of(tokens[i].tok)
                if param_type is "":
                    return TemplateStep{template: empty, next: i, ok: false, error: "expected type name in template param"}
                i = i + 1
        params = append(params, Param{name: param_name, type_name: param_type})
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    if not match_tok(tokens, i, n, "RParen"):
        return TemplateStep{template: empty, next: i, ok: false, error: "expected `)` after template params"}
    i = i + 1
    if not match_tok(tokens, i, n, "Assign"):
        return TemplateStep{template: empty, next: i, ok: false, error: "expected `=` before template body"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    body_step = parse_expr(tokens, i, n)
    if not body_step.ok:
        return TemplateStep{template: empty, next: body_step.next, ok: false, error: body_step.error}
    TemplateStep{template: TemplateDecl{name: name, params: params, body: body_step.value}, next: body_step.next, ok: true, error: ""}

# `tokens NAMESPACE:` NEWLINE (indented) `key: value` lines. The
# namespace + key together form the resolved token id (`color.bg`,
# `layout.card`). Block ends on dedent-or-below the `tokens` column,
# or on any top-level starter. Values are arbitrary expressions —
# strings for colors, ints for spacing, idents for token refs.
type TokensStep: block: TokensDecl, next: number, ok: truth, error: text

define parse_tokens_decl(tokens: [Token], start: number, n: number) -> TokensStep:
    empty = TokensDecl{namespace: "", entries: []}
    if start >= n:
        return TokensStep{block: empty, next: start, ok: false, error: "expected namespace after `tokens`"}
    namespace = ident_of(tokens[start].tok)
    if namespace is "":
        return TokensStep{block: empty, next: start, ok: false, error: "expected namespace after `tokens`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Colon"):
        return TokensStep{block: empty, next: i, ok: false, error: "expected `:` after tokens namespace"}
    i = i + 1
    # Column of the `tokens` keyword — entries at or left of it dedent out.
    tokens_col = if start >= 1 then tokens[start - 1].col else 0
    i = skip_newlines(tokens, i, n)
    edit entries = []
    loop:
        if i >= n:
            break
        entry_tok = tokens[i]
        if is_newline(entry_tok.tok):
            i = i + 1
        else:
            if at_rule_starter(tokens, i, n):
                break
            if entry_tok.col <= tokens_col:
                break
            key = ident_of(entry_tok.tok)
            if key is "":
                return TokensStep{block: empty, next: i, ok: false, error: "expected token key ident"}
            i = i + 1
            if not match_tok(tokens, i, n, "Colon"):
                return TokensStep{block: empty, next: i, ok: false, error: "expected `:` after token key"}
            i = i + 1
            val_step = parse_expr(tokens, i, n)
            if not val_step.ok:
                return TokensStep{block: empty, next: val_step.next, ok: false, error: val_step.error}
            entries = append(entries, TokenEntry{key: key, value: val_step.value})
            i = val_step.next
    TokensStep{block: TokensDecl{namespace: namespace, entries: entries}, next: i, ok: true, error: ""}

# `belief NAME:` then a body of `fact = value` lines — declares an
# agent's believed facts as a resource namespace `belief:NAME:fact`
# that can diverge from reality (B1, idea belief-1). PURE PARSER SUGAR
# (like derive/after): each fact line desugars to a Tick SetVar of the
# prefixed resource, so the belief is re-asserted each tick and the
# divergence from the real `fact` is a resource-prefix comparison
# (atlas belief_wrong). A belief is not a separate world here — it is a
# namespace of facts an agent holds; the fork-based simulatable belief
# (foresee-on-belief) is a distinct future slice. `becomes` accepted.
define parse_belief_decl(tokens: [Token], start: number, n: number) -> RuleStep:
    empty = Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}
    if start >= n:
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `belief`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `belief`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Colon"):
        return RuleStep{rule: empty, next: i, ok: false, error: "expected `:` after belief name"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    prefix = "belief:" + name + ":"
    edit body = []
    loop:
        if i >= n:
            break
        t = tokens[i]
        if is_newline(t.tok):
            i = i + 1
        else:
            key = ident_of(t.tok)
            if key is "":
                break
            i = i + 1
            if not (match_tok(tokens, i, n, "Assign") or match_tok(tokens, i, n, "Becomes")):
                return RuleStep{rule: empty, next: i, ok: false, error: "expected `=` after belief fact name"}
            i = i + 1
            vexpr = parse_expr(tokens, i, n)
            if not vexpr.ok:
                return RuleStep{rule: empty, next: vexpr.next, ok: false, error: vexpr.error}
            body = append(body, SetVar(prefix + key, vexpr.value))
            i = vexpr.next
    r = Rule{name: "belief:" + name, params: [], body: body, trigger: "Tick", condition: LitBool(true)}
    RuleStep{rule: r, next: i, ok: true, error: ""}

# `fact NAME = EXPR [in goal|broken|belief:SUB] [conf N]` — ONE keyword that
# consolidates view / goal / constraint / belief (+ confidence). PURE PARSER
# SUGAR (NEXTGEN Punkt 3): every form desugars to the SAME rule shape the
# individual keywords already emit, so nothing new reaches the runtime. The old
# keywords stay as aliases; `fact` is the recommended spelling.
#   fact N = E              -> SetVar(N, E)              every $derive pass (view)
#   fact N = E in goal      -> SetVar("goal:N", E?1:0)        every Tick
#   fact N = E in broken    -> SetVar("constraint:N", E?1:0)  every Tick
#   fact V = E in belief:B  -> SetVar("belief:B:V", E)        every Tick
#   ... conf C  (suffix)    -> extra SetVar("conf:N", C)
define parse_fact_decl(tokens: [Token], start: number, n: number) -> RuleStep:
    empty = Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}
    if start >= n:
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `fact`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `fact`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Assign"):
        return RuleStep{rule: empty, next: i, ok: false, error: "expected `=` after fact name"}
    i = i + 1
    val = parse_expr(tokens, i, n)
    if not val.ok:
        return RuleStep{rule: empty, next: val.next, ok: false, error: val.error}
    i = val.next
    # Default (no namespace): a view — recompute NAME from EXPR every $derive
    # pass. Identical to parse_derive_decl.
    edit target = name
    edit value = val.value
    edit trigger = "$derive"
    edit rname = "derive:" + name
    if match_tok(tokens, i, n, "In"):
        i = i + 1
        if match_tok(tokens, i, n, "Goal"):
            i = i + 1
            target = "goal:" + name
            value = IfExpr(val.value, LitInt(1), LitInt(0))
            trigger = "Tick"
            rname = "goal:" + name
        else:
            if ident_of(tokens[i].tok) is "broken":
                i = i + 1
                target = "constraint:" + name
                value = IfExpr(val.value, LitInt(1), LitInt(0))
                trigger = "Tick"
                rname = "constraint:" + name
            else:
                if match_tok(tokens, i, n, "Belief"):
                    i = i + 1
                    if not match_tok(tokens, i, n, "Colon"):
                        return RuleStep{rule: empty, next: i, ok: false, error: "expected `:` after `belief` in fact namespace"}
                    i = i + 1
                    sub = ident_of(tokens[i].tok)
                    if sub is "":
                        return RuleStep{rule: empty, next: i, ok: false, error: "expected belief name after `belief:`"}
                    i = i + 1
                    target = "belief:" + sub + ":" + name
                    trigger = "Tick"
                    rname = "belief:" + sub + ":" + name
                else:
                    return RuleStep{rule: empty, next: i, ok: false, error: "expected `goal`, `broken`, or `belief:NAME` after `in`"}
    edit body = append([], SetVar(target, value))
    # Optional confidence suffix: `conf N` (or `confidence N`) stores a parallel
    # 0-100 certainty under `conf:NAME`, read via `confidence(NAME)`.
    if match_tok(tokens, i, n, "Confidence"):
        i = i + 1
        cstep = parse_expr(tokens, i, n)
        if not cstep.ok:
            return RuleStep{rule: empty, next: cstep.next, ok: false, error: cstep.error}
        body = append(body, SetVar("conf:" + name, cstep.value))
        i = cstep.next
    r = Rule{name: rname, params: [], body: body, trigger: trigger, condition: LitBool(true)}
    RuleStep{rule: r, next: i, ok: true, error: ""}

# Top-level dispatch tail: a belief/goal/constraint declaration, else a
# plain rule. Kept in one helper so the parse() dispatch doesn't pyramid.
define parse_belief_goal_or_rule(tokens: [Token], start: number, n: number) -> RuleStep:
    if match_tok(tokens, start, n, "Belief"):
        return parse_belief_decl(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Goal"):
        return parse_prefixed_derive(tokens, start + 1, n, "goal:")
    if match_tok(tokens, start, n, "Constraint"):
        return parse_prefixed_derive(tokens, start + 1, n, "constraint:")
    if match_tok(tokens, start, n, "Intent"):
        return parse_intent_decl(tokens, start + 1, n)
    parse_rule(tokens, start, n)

# `intent NAME [for KIND]:` then `require COND` / `utility EXPR` lines — an
# AI-native declaration (pillar 1). PURE PARSER SUGAR, like goal/constraint:
# it desugars to a Tick rule that keeps two resources current so a utility-AI
# can pick actions by reading them, no planner in the language:
#   intent:NAME:applicable = COND ? 1 : 0    (is this intent viable now?)
#   intent:NAME:score      = COND ? UTILITY : 0   (its utility when viable)
# `for KIND` is accepted for readability and stored nowhere (documentation);
# the PLANNER that sequences chosen intents is the host's job (a future slice).
define parse_intent_decl(tokens: [Token], start: number, n: number) -> RuleStep:
    empty = Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}
    if start >= n:
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `intent`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after `intent`"}
    edit i = start + 1
    # Optional `for KIND` — `for` lexes to the For token; consume it and the
    # kind name purely as documentation.
    if match_tok(tokens, i, n, "For"):
        i = i + 1
        if i < n and ident_of(tokens[i].tok) is not "":
            i = i + 1
    if not match_tok(tokens, i, n, "Colon"):
        return RuleStep{rule: empty, next: i, ok: false, error: "expected `:` after intent header"}
    i = i + 1
    # Column of the `intent` keyword — a body line at or left of it is a dedent.
    intent_col = if start >= 1 then tokens[start - 1].col else 0
    i = skip_newlines(tokens, i, n)
    edit cond = LitBool(true)
    edit util = LitInt(0)
    loop:
        if i >= n:
            break
        t = tokens[i]
        if is_newline(t.tok):
            i = i + 1
        else:
            if at_rule_starter(tokens, i, n) or t.col <= intent_col:
                break
            if match_tok(tokens, i, n, "Require"):
                cstep = parse_expr(tokens, i + 1, n)
                if not cstep.ok:
                    return RuleStep{rule: empty, next: cstep.next, ok: false, error: cstep.error}
                cond = cstep.value
                i = cstep.next
            else:
                if ident_of(t.tok) is "utility":
                    ustep = parse_expr(tokens, i + 1, n)
                    if not ustep.ok:
                        return RuleStep{rule: empty, next: ustep.next, ok: false, error: ustep.error}
                    util = ustep.value
                    i = ustep.next
                else:
                    return RuleStep{rule: empty, next: i, ok: false, error: "intent body takes `require COND` and `utility EXPR`"}
    prefix = "intent:" + name
    applicable = SetVar(prefix + ":applicable", IfExpr(cond, LitInt(1), LitInt(0)))
    score = SetVar(prefix + ":score", IfExpr(cond, util, LitInt(0)))
    body = append(append([], applicable), score)
    r = Rule{name: prefix, params: [], body: body, trigger: "Tick", condition: LitBool(true)}
    RuleStep{rule: r, next: i, ok: true, error: ""}

# `goal NAME = COND` / `constraint NAME = COND` — the world describes its
# intent, not the behavior (B3). Both desugar (like derive) to a Tick
# rule that keeps `<ns>NAME` equal to the condition, so the engine
# TRACKS whether each goal is met (goal:NAME is 1) and whether each
# constraint holds (constraint:NAME is 1, violated when 0). This is the
# declaration + evaluation layer — goals/constraints as first-class,
# queryable, always-current facts (atlas goals_met / constraints_
# violated). The SOLVER that plans HOW to achieve a goal under the
# constraints is a distinct future slice; here the world states its
# intent and the engine continuously scores it.
define parse_prefixed_derive(tokens: [Token], start: number, n: number, ns: text) -> RuleStep:
    empty = Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}
    if start >= n:
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after goal/constraint"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return RuleStep{rule: empty, next: start, ok: false, error: "expected name after goal/constraint"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Assign"):
        return RuleStep{rule: empty, next: i, ok: false, error: "expected `=` after goal/constraint name"}
    i = i + 1
    val = parse_expr(tokens, i, n)
    if not val.ok:
        return RuleStep{rule: empty, next: val.next, ok: false, error: val.error}
    # Coerce the predicate to 1/0 so it stores as an int resource (the
    # set-drain drops raw bool payloads — see apply_set). goal:NAME is 1
    # means met; constraint:NAME is 1 means satisfied.
    scored = IfExpr(val.value, LitInt(1), LitInt(0))
    body = append([], SetVar(ns + name, scored))
    r = Rule{name: ns + name, params: [], body: body, trigger: "Tick", condition: LitBool(true)}
    RuleStep{rule: r, next: val.next, ok: true, error: ""}

# `for IDENT in INT until INT: body` — top-level macro. Body must be a
# single rule construct (typically `when EXPR: stmts`). At parse time
# we clone the body once per iteration, substituting the iter var.
# Runtime sees N independent rules — edge detection, ctx threading,
# everything else is unchanged.
type ForStep: rules: [Rule], next: number, ok: truth, error: text

# Distinguish the two top-level `for`s: a RANGE macro `for x in [from] INT ..`
# vs a runtime foreach `for x in [list]/ident:`. Peek past `for IDENT in
# [from]` and check whether the source starts with an int literal.
define is_range_for(tokens: [Token], i: number, n: number) -> truth:
    if i + 2 >= n:
        false
    else:
        if not match_tok(tokens, i + 2, n, "In"):
            false
        else:
            edit j = i + 3
            if match_tok(tokens, j, n, "From"):
                j = j + 1
            if j >= n then false else int_of(tokens[j].tok) >= 0

define parse_for_loop(tokens: [Token], start: number, n: number) -> ForStep:
    if start >= n:
        return ForStep{rules: [], next: start, ok: false, error: "expected iter name after `for`"}
    iter_name = ident_of(tokens[start].tok)
    if iter_name is "":
        return ForStep{rules: [], next: start, ok: false, error: "expected iter name after `for`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "In"):
        return ForStep{rules: [], next: i, ok: false, error: "expected `in` after iter name"}
    i = i + 1
    if match_tok(tokens, i, n, "From"):
        i = i + 1
    range_start = int_of(tokens[i].tok)
    if range_start < 0:
        return ForStep{rules: [], next: i, ok: false, error: "expected int literal range start"}
    i = i + 1
    edit inclusive = false
    if match_tok(tokens, i, n, "To"):
        i = i + 1
    else:
        if match_tok(tokens, i, n, "Through"):
            inclusive = true
            i = i + 1
        else:
            return ForStep{rules: [], next: i, ok: false, error: "expected `to` or `through`"}
    edit range_end = int_of(tokens[i].tok)
    if range_end < 0:
        return ForStep{rules: [], next: i, ok: false, error: "expected int literal range end"}
    if inclusive:
        range_end = range_end + 1
    i = i + 1
    if not match_tok(tokens, i, n, "Colon"):
        return ForStep{rules: [], next: i, ok: false, error: "expected `:` after for header"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    # Body: exactly one rule construct (rule/on/when/every). We hand
    # over to parse_rule which handles all those shapes.
    body_step = parse_rule(tokens, i, n)
    if not body_step.ok:
        return ForStep{rules: [], next: body_step.next, ok: false, error: body_step.error}
    edit out = []
    edit v = range_start
    loop:
        if v >= range_end:
            break
        out = append(out, subst_rule(body_step.rule, iter_name, v))
        v = v + 1
    ForStep{rules: out, next: body_step.next, ok: true, error: ""}

# `every N : NEWLINE body` — sugar for `when (tick % N is 0): body`.
# Period must be an int literal; runtime evaluates the synthetic
# condition against whatever `tick` binding the host supplies.
define parse_every_rule(tokens: [Token], start: number, n: number) -> RuleStep:
    if start >= n:
        return RuleStep{rule: empty_rule(), next: start, ok: false, error: "expected period after `every`"}
    period = int_of(tokens[start].tok)
    if period <= 0:
        return RuleStep{rule: empty_rule(), next: start, ok: false, error: "expected positive int period after `every`"}
    edit i = start + 1
    # An optional unit (s/ms/m) turns the frame period into a WALL-CLOCK
    # cadence: `every 2s:` is scheduled on real time by the engine's timer
    # scheduler (sleep-to-deadline, no polling). A bare `every 4:` stays the
    # frame-tick desugar (when tick % 4 is 0).
    edit interval_ms = 0
    unit = if i < n then ident_of(tokens[i].tok) else ""
    if unit is "ms":
        interval_ms = period
        i = i + 1
    else:
        if unit is "s":
            interval_ms = period * 1000
            i = i + 1
        else:
            if unit is "m":
                interval_ms = period * 60000
                i = i + 1
    # Optional `if EXPR` gate: `every 3s if heat > 0: heat -= 1` — cadence
    # fires the tick, EXPR gates the body. Cleaner than nesting an if inside
    # the body manually. Combines the two most common patterns
    # (periodic + conditional) into one line.
    edit guard = LitBool(true)
    if match_tok(tokens, i, n, "If"):
        gate_step = parse_expr(tokens, i + 1, n)
        if not gate_step.ok:
            return RuleStep{rule: empty_rule(), next: gate_step.next, ok: false, error: gate_step.error}
        guard = gate_step.value
        i = gate_step.next
    if not match_tok(tokens, i, n, "Colon"):
        return RuleStep{rule: empty_rule(), next: i, ok: false, error: "expected `:` after every period"}
    i = i + 1
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            i = i + 1
        else:
            break
    edit body = []
    loop:
        if i >= n:
            break
        t = tokens[i]
        if at_rule_starter(tokens, i, n):
            break
        if is_newline(t.tok):
            i = i + 1
        else:
            step = parse_stmt(tokens, i, n)
            if step.ok:
                body = append(body, step.stmt)
                i = step.next
            else:
                return RuleStep{rule: empty_rule(), next: i, ok: false, error: step.error}
    # Wrap body in IfStmt when a guard is present; LitBool(true) short-
    # circuits so the no-guard path pays nothing.
    final_body = if is_lit_true(guard) then body else append([], IfStmt(guard, body))
    if interval_ms > 0:
        RuleStep{rule: Rule{name: "", params: [], body: final_body, trigger: "$every:{interval_ms}", condition: LitBool(true)}, next: i, ok: true, error: ""}
    else:
        cond = Binop("==", Binop("%", VarRef("tick"), LitInt(period)), LitInt(0))
        RuleStep{rule: Rule{name: "", params: [], body: final_body, trigger: "$when", condition: cond}, next: i, ok: true, error: ""}

# ---- stmt = "emit" IDENT [ "{" field-list "}" ] ----

type StmtStep: stmt: Stmt, next: number, ok: truth, error: text

define parse_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    # Dispatch on the leading keyword.
    if match_tok(tokens, start, n, "Require"):
        return parse_require_stmt(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Let"):
        return parse_let_stmt(tokens, start + 1, n)
    # `create X ...` — the only shape. `spawn` was Doom/Quake baggage;
    # Cypher/SurrealDB/EdgeDB agree on CREATE. First-version cleanup:
    # one-way syntax, no aliases.
    if match_tok(tokens, start, n, "Create"):
        return parse_spawn_stmt(tokens, start + 1, n, tokens[start].col)
    if match_tok(tokens, start, n, "Destroy"):
        return parse_destroy_stmt(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Set"):
        return parse_set_stmt(tokens, start + 1, n)
    if match_tok(tokens, start, n, "RelateKw"):
        return parse_relate_stmt(tokens, start + 1, n)
    if match_tok(tokens, start, n, "After"):
        return parse_after_stmt(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Each") or match_tok(tokens, start, n, "For"):
        return parse_foreach_stmt(tokens, start + 1, n)
    if match_tok(tokens, start, n, "If"):
        return parse_if_stmt(tokens, start + 1, n)
    if looks_like_assignment(tokens, start, n):
        return parse_set_stmt(tokens, start, n)
    # Bare `Panel ...` (no `create` keyword): a leading Uppercase Type is a
    # spawn. `create` stays valid — this is pure sugar for the UI parts.
    if is_type_stmt(tokens, start, n):
        return parse_spawn_stmt(tokens, start, n, tokens[start].col)
    edit i = start
    # `emit X {...}` and `signal X {...}` are the same AST today, but the
    # keyword split marks INTENT — `emit` is a buffered message (renderer /
    # audio / log drains it), `signal` is an observed event (any `on X:`
    # handler fires synchronously). Runtime is identical for now; the
    # semantic tag lets us diverge behavior later (buffered vs dispatched)
    # without a source-wide rewrite. Bevy's 0.17 lesson: split early or
    # regret it (they went 2 years mixing the shapes).
    is_effect = match_tok(tokens, i, n, "Effect")
    if not (match_tok(tokens, i, n, "Emit") or match_tok(tokens, i, n, "Signal") or is_effect):
        return StmtStep{stmt: EmitEffect("", []), next: i, ok: false, error: "expected emit/effect/signal/require/let/create/destroy/set/for/assignment"}
    i = i + 1
    name_tok = if i < n then tokens[i] else newline_token()
    raw_event = ident_of(name_tok.tok)
    if raw_event is "":
        return StmtStep{stmt: EmitEffect("", []), next: i, ok: false, error: "expected event name after `emit`/`effect`/`signal`"}
    # `effect X` is an EXTERNAL op the host performs (window/file/net) — it
    # lands on a namespaced channel `effect:X`, so rules can't observe it
    # (`on X` watches channel `X`). `emit X` stays an internal fact.
    event = if is_effect then "effect:" + raw_event else raw_event
    i = i + 1
    # Optional `{ ... }` field block.
    fields = []
    edit field_list = fields
    edit i2 = i
    # `emit X()` — parenless form, no fields. Consume the empty paren pair.
    if match_tok(tokens, i2, n, "LParen"):
        i2 = i2 + 1
        if match_tok(tokens, i2, n, "RParen"):
            i2 = i2 + 1
    # `emit X f1: v1, f2: v2` — brace-less only in v1. Braces `{}` are
    # forbidden; use comma-separated fields terminated by newline.
    if match_tok(tokens, i2, n, "LBrace"):
        return StmtStep{stmt: EmitEffect(event, []), next: i2, ok: false, error: "braces not allowed for emit — use `emit X f: v, f: v`"}
    if i2 < n and not is_newline(tokens[i2].tok) and not at_rule_starter(tokens, i2, n):
        line = parse_field_list_line(tokens, i2, n)
        if line.ok:
            field_list = line.fields
            i2 = line.next
    StmtStep{stmt: EmitEffect(event, field_list), next: i2, ok: true, error: ""}

type FieldBlockStep: fields: [FieldExpr], next: number, ok: truth, error: text

# Brace-less field-list: reads `f: v, f: v, ...` until a Newline.
# The only shape — no C-family `{}` litter in Astra v1.
define parse_field_list_line(tokens: [Token], start: number, n: number) -> FieldBlockStep:
    edit out = []
    edit i = start
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            break
        step = parse_field(tokens, i, n)
        if not step.ok:
            return FieldBlockStep{fields: out, next: i, ok: false, error: step.error}
        out = append(out, step.field)
        i = step.next
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    FieldBlockStep{fields: out, next: i, ok: true, error: ""}

define skip_newlines(tokens: [Token], start: number, n: number) -> number:
    edit i = start
    loop:
        if i >= n:
            break
        if is_newline(tokens[i].tok):
            i = i + 1
        else:
            break
    i

# ---- field = IDENT ":" expr ----

type FieldStep: field: FieldExpr, next: number, ok: truth, error: text

define parse_field(tokens: [Token], start: number, n: number) -> FieldStep:
    edit i = start
    name_tok = if i < n then tokens[i] else newline_token()
    name = ident_of(name_tok.tok)
    if name is "":
        return FieldStep{field: FieldExpr{name: "", value: LitInt(0)}, next: i, ok: false, error: "expected field name"}
    i = i + 1
    if not match_tok(tokens, i, n, "Colon"):
        return FieldStep{field: FieldExpr{name: "", value: LitInt(0)}, next: i, ok: false, error: "expected `:`"}
    i = i + 1
    # Symbolic value: a SYMBOLIC field (anchor/layout/color/show/…) whose
    # value is a lone bareword is an atom — its own name as text. So
    # `anchor: fill` is `anchor: "fill"`, quotes reserved for real text.
    # Only lone idents atomise; `cmd.label` / `a and b` / numbers / strings
    # still parse as expressions. Numeric + text fields never atomise, so
    # `w: 20` and `text: "ATLAS"` are unaffected.
    if is_symbolic_field(name) and is_bareword_value(tokens, i, n):
        atom = ident_of(tokens[i].tok)
        return FieldStep{field: FieldExpr{name: name, value: LitText(atom)}, next: i + 1, ok: true, error: ""}
    # `size: WxH` dimension shorthand — `18x14` lexes as Int(18)+Ident("x14"),
    # so recombine into a [w, h] pair the spawn post-pass expands to w:/h:.
    # (`size: 16` stays a plain int → a square.)
    if fe_name_eq(name, "size") and is_dim_pair(tokens, i, n):
        wv = int_of(tokens[i].tok)
        hv = int_from_x_ident(ident_of(tokens[i + 1].tok))
        return FieldStep{field: FieldExpr{name: name, value: LitList([LitInt(wv), LitInt(hv)])}, next: i + 2, ok: true, error: ""}
    step = parse_expr(tokens, i, n)
    if step.ok:
        FieldStep{field: FieldExpr{name: name, value: step.value}, next: step.next, ok: true, error: ""}
    else:
        FieldStep{field: FieldExpr{name: "", value: LitInt(0)}, next: i, ok: false, error: step.error}

# Map-literal field: like parse_field but a lone bareword value ALWAYS
# atomises (map literals are data — `{ icon: menu, act: menu }` — so any
# unquoted word is a symbol, quotes are reserved for real text). Also ends
# a value at `}`/`]`, not just comma/newline.
define parse_map_field(tokens: [Token], start: number, n: number) -> FieldStep:
    edit i = start
    name = if i < n then ident_of(tokens[i].tok) else ""
    if name is "":
        return FieldStep{field: FieldExpr{name: "", value: LitInt(0)}, next: i, ok: false, error: "expected field name"}
    i = i + 1
    if not match_tok(tokens, i, n, "Colon"):
        return FieldStep{field: FieldExpr{name: "", value: LitInt(0)}, next: i, ok: false, error: "expected `:`"}
    i = i + 1
    if is_bareword_map_value(tokens, i, n):
        return FieldStep{field: FieldExpr{name: name, value: LitText(ident_of(tokens[i].tok))}, next: i + 1, ok: true, error: ""}
    step = parse_expr(tokens, i, n)
    if step.ok:
        FieldStep{field: FieldExpr{name: name, value: step.value}, next: step.next, ok: true, error: ""}
    else:
        FieldStep{field: FieldExpr{name: "", value: LitInt(0)}, next: i, ok: false, error: step.error}

define is_bareword_map_value(tokens: [Token], i: number, n: number) -> truth:
    if i >= n:
        false
    else:
        if length(ident_of(tokens[i].tok)) is 0:
            false
        else:
            j = i + 1
            if j >= n then true else (is_newline(tokens[j].tok) or match_tok(tokens, j, n, "Comma") or match_tok(tokens, j, n, "RBrace") or match_tok(tokens, j, n, "RBracket"))

# Fields whose value is a symbolic atom (an enum-ish name), not text or a
# number. A bare identifier in one of these is its own name. Text fields
# (text/label/hint/placeholder/desc) are absent on purpose — they keep
# quotes; numeric fields never reach here (a bareword there stays an expr).
define is_symbolic_field(name: text) -> truth:
    name is "anchor" or name is "layout" or name is "align" or name is "justify" or name is "role" or name is "fill" or name is "blend" or name is "kind" or name is "tint" or name is "easing" or name is "do" or name is "submit" or name is "style" or name is "name" or name is "parent" or name is "show" or name is "hide" or name is "search" or name is "image" or name is "color" or name is "ink" or name is "w_from" or name is "render" or name is "items" or name is "bind" or name is "changed"

# A lone bareword value = an Ident immediately followed by end-of-value
# (comma, newline, or EOF). Idents followed by `.`/operators/`(` are the
# start of a larger expression and are NOT atomised.
define is_bareword_value(tokens: [Token], i: number, n: number) -> truth:
    if i >= n:
        false
    else:
        id = ident_of(tokens[i].tok)
        if length(id) is 0:
            false
        else:
            j = i + 1
            if j >= n then true else (is_newline(tokens[j].tok) or match_tok(tokens, j, n, "Comma"))

# `18x14` → Int(18) then Ident("x14"). Detect that pair (an int followed by
# an `x` + digits identifier) so `size:` can read a WxH dimension without a
# dedicated lexer token.
define is_dim_pair(tokens: [Token], i: number, n: number) -> truth:
    if i + 1 >= n:
        false
    else:
        if int_of(tokens[i].tok) < 0:
            false
        else:
            x_ident_digits(ident_of(tokens[i + 1].tok))

define x_ident_digits(id: text) -> truth:
    b = bytes_of(id)
    if length(b) < 2:
        false
    else:
        if byte_at(b, 0) is not 120:
            false
        else:
            edit ok = true
            loop k in 1 until length(b):
                c = byte_at(b, k)
                if c < 48 or c > 57:
                    ok = false
            ok

define int_from_x_ident(id: text) -> number:
    b = bytes_of(id)
    edit v = 0
    loop k in 1 until length(b):
        v = v * 10 + (byte_at(b, k) - 48)
    v

# Expand a `size:` field into `w:`/`h:` at spawn build. `size: N` → N×N,
# `size: WxH` → W×H. On Text `size` stays FONT size (text has no box), so
# it is left untouched.
define expand_size(fields: [FieldExpr], kind: text) -> [FieldExpr]:
    if fe_name_eq(kind, "Text"):
        fields
    else:
        edit out = []
        loop i in 0 until length(fields):
            f = fields[i]
            if fe_name_eq(f.name, "size"):
                choose f.value:
                    LitInt(v) then 
                        out = append(out, FieldExpr{name: "w", value: LitInt(v)})
                        out = append(out, FieldExpr{name: "h", value: LitInt(v)})
                    LitList(items) then 
                        if length(items) >= 2:
                            out = append(out, FieldExpr{name: "w", value: items[0]})
                            out = append(out, FieldExpr{name: "h", value: items[1]})
                        else:
                            out = append(out, f)
                    _ then out = append(out, f)
            else:
                out = append(out, f)
        out

# ---- require / let stmt parsers ----

# `require A` — single guard. `require A, B, C` — comma-separated guards
# combined with AND so the rule passes only when all hold. Reads as a
# checklist of preconditions.
define parse_require_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    step = parse_expr(tokens, start, n)
    if not step.ok:
        return StmtStep{stmt: Require(LitBool(false)), next: step.next, ok: false, error: step.error}
    edit combined = step.value
    edit i = step.next
    loop:
        if not match_tok(tokens, i, n, "Comma"):
            break
        i = i + 1
        more = parse_expr(tokens, i, n)
        if not more.ok:
            return StmtStep{stmt: Require(combined), next: more.next, ok: false, error: more.error}
        combined = Binop("and", combined, more.value)
        i = more.next
    StmtStep{stmt: Require(combined), next: i, ok: true, error: ""}

define parse_let_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    if start >= n:
        return StmtStep{stmt: Let("", LitInt(0)), next: start, ok: false, error: "expected name after `let`"}
    if match_tok(tokens, start, n, "LBrace"):
        return parse_let_destructure(tokens, start + 1, n)
    name = ident_of(tokens[start].tok)
    if name is "":
        return StmtStep{stmt: Let("", LitInt(0)), next: start, ok: false, error: "expected name after `let`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Assign"):
        return StmtStep{stmt: Let(name, LitInt(0)), next: i, ok: false, error: "expected `=` after let name"}
    i = i + 1
    step = parse_expr(tokens, i, n)
    if not step.ok:
        return StmtStep{stmt: Let(name, LitInt(0)), next: step.next, ok: false, error: step.error}
    StmtStep{stmt: Let(name, step.value), next: step.next, ok: true, error: ""}

# `let { a, b, c } = expr` — bind every listed name to the same-named
# MapV field. Caller is responsible for ensuring expr yields a MapV;
# missing field → NoneV binding.
define parse_let_destructure(tokens: [Token], start: number, n: number) -> StmtStep:
    edit i = skip_newlines(tokens, start, n)
    edit names = []
    loop:
        if i >= n:
            break
        if match_tok(tokens, i, n, "RBrace"):
            break
        nm = ident_of(tokens[i].tok)
        if nm is "":
            return StmtStep{stmt: Let("", LitInt(0)), next: i, ok: false, error: "expected field name in let-destructure"}
        names = append(names, nm)
        i = i + 1
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
        i = skip_newlines(tokens, i, n)
    if not match_tok(tokens, i, n, "RBrace"):
        return StmtStep{stmt: Let("", LitInt(0)), next: i, ok: false, error: "expected `}` after destructure names"}
    i = i + 1
    if not match_tok(tokens, i, n, "Assign"):
        return StmtStep{stmt: Let("", LitInt(0)), next: i, ok: false, error: "expected `=` after destructure pattern"}
    i = i + 1
    val = parse_expr(tokens, i, n)
    if not val.ok:
        return StmtStep{stmt: Let("", LitInt(0)), next: val.next, ok: false, error: val.error}
    StmtStep{stmt: LetDestructure(names, val.value), next: val.next, ok: true, error: ""}

# `create Kind f: v, f: v, ...` — the only shape. Fields comma-
# separated after Kind, terminated by newline. Braces `{}` are
# forbidden in v1 (C-family litter has no place in an indent-driven
# data language).
define parse_spawn_stmt(tokens: [Token], start: number, n: number, stmt_col: number) -> StmtStep:
    if start >= n:
        return StmtStep{stmt: SpawnEntity("", []), next: start, ok: false, error: "expected type name after `create`"}
    raw_kind = ident_of(tokens[start].tok)
    if raw_kind is "":
        return StmtStep{stmt: SpawnEntity("", []), next: start, ok: false, error: "expected type name after `create`"}
    # Element sugar — the name says what it is, so you don't spell the flag:
    #   Input  = an editable Text (`Input bind:…` not `Text editable: true`)
    #   Spacer = a Panel that just grows (fills the gap in a row/column)
    kind = if raw_kind is "Input" then "Text" else if raw_kind is "Spacer" then "Panel" else raw_kind
    edit fields = []
    if raw_kind is "Input":
        fields = append(fields, FieldExpr{name: "editable", value: LitInt(1)})
    if raw_kind is "Spacer":
        fields = append(fields, FieldExpr{name: "grow", value: LitInt(1)})
    edit i = start + 1
    # Component instantiation: `NAME(argA, argB)` — a capitalised name directly
    # followed by `(` is a call, not a widget (Panel/Text never take parens).
    # Args park in __argN fields; the expand_components post-pass splices the
    # component body in with these bound to its params. Unknown names stay a
    # plain SpawnEntity (a wrong widget type surfaces later, not here).
    if match_tok(tokens, i, n, "LParen"):
        i = i + 1
        edit call_fields = []
        edit argn = 0
        loop:
            if i >= n:
                break
            if match_tok(tokens, i, n, "RParen"):
                break
            astep = parse_expr(tokens, i, n)
            if not astep.ok:
                return StmtStep{stmt: SpawnEntity(kind, []), next: astep.next, ok: false, error: astep.error}
            call_fields = append(call_fields, FieldExpr{name: "__arg{argn}", value: astep.value})
            argn = argn + 1
            i = astep.next
            if match_tok(tokens, i, n, "Comma"):
                i = i + 1
        if not match_tok(tokens, i, n, "RParen"):
            return StmtStep{stmt: SpawnEntity(kind, call_fields), next: i, ok: false, error: "expected `)` after component args"}
        i = i + 1
        call_fields = append(call_fields, FieldExpr{name: "__col", value: LitInt(stmt_col)})
        return StmtStep{stmt: SpawnEntity(kind, call_fields), next: i, ok: true, error: ""}
    if match_tok(tokens, i, n, "LBrace"):
        return StmtStep{stmt: SpawnEntity(kind, []), next: i, ok: false, error: "braces not allowed — use `Panel f: v, f: v` or indented `f: v` lines"}
    # Positional primary value: a leading string with no `key:` is the
    # element's main content — `Text "ATLAS"` is `Text text: "ATLAS"`.
    if i < n and is_str_tok(tokens[i].tok):
        fields = append(fields, FieldExpr{name: "text", value: text_lit_expr(token_text(tokens[i].tok))})
        i = i + 1
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    line = parse_field_list_line(tokens, i, n)
    if not line.ok:
        return StmtStep{stmt: SpawnEntity(kind, []), next: line.next, ok: false, error: line.error}
    loop lf in line.fields:
        fields = append(fields, lf)
    # Continuation props: `key: value` lines indented DEEPER than this
    # create fold in as more fields (readability for many-prop widgets —
    # >4 props reads better stacked). A deeper line starting with an
    # Uppercase Type is a CHILD, not a prop → stop and let the body loop +
    # parent-inference handle it. Dedent ends the create.
    edit cur = line.next
    loop:
        j = skip_newlines(tokens, cur, n)
        if j >= n:
            cur = j
            break
        if tokens[j].col <= stmt_col:
            break
        if is_type_stmt(tokens, j, n):
            break
        fstep = parse_field(tokens, j, n)
        if not fstep.ok:
            break
        fields = append(fields, fstep.field)
        cur = fstep.next
        if match_tok(tokens, cur, n, "Comma"):
            cur = cur + 1
    # Expand `size:` → w:/h: (skips Text, where size is font), then stash the
    # create's column so parent-inference can nest by indentation. Both
    # __size-expansion and __col stripping happen before the entity is built.
    sized = expand_size(fields, kind)
    fields_c = append(sized, FieldExpr{name: "__col", value: LitInt(stmt_col)})
    StmtStep{stmt: SpawnEntity(kind, fields_c), next: cur, ok: true, error: ""}

# A statement that starts with an Uppercase identifier is a bare spawn
# (`Panel ...` — no `create` keyword). Keywords lex to non-Ident tokens
# (ident_of → "") and assignments/props start lowercase, so this never
# collides.
define is_type_stmt(tokens: [Token], start: number, n: number) -> truth:
    if start >= n:
        false
    else:
        nm = ident_of(tokens[start].tok)
        if length(nm) is 0:
            false
        else:
            c = byte_at(bytes_of(nm), 0)
            c >= 65 and c <= 90

# ── Styles ── `style NAME:` declares a reusable prop bundle; a create
# with `style: NAME` gets those props merged in (its own fields win).
# styles are collected here and exposed on ParseResult; atlas loads them
# globally and merges them into a widget's payload at SPAWN — so a style
# in one file styles a create in another (cross-bundle).
type StyleStep: style: StyleDecl, next: number, ok: truth, error: text

# `style` is a bare Ident at top level (no keyword → no Tok enum surgery):
# `style NAME :` — NAME is an Ident, then a Colon.
define looks_like_style_decl(tokens: [Token], start: number, n: number) -> truth:
    if start + 2 >= n:
        false
    else:
        w = ident_of(tokens[start].tok)
        if not fe_name_eq(w, "style"):
            false
        else:
            nm = ident_of(tokens[start + 1].tok)
            length(nm) > 0 and match_tok(tokens, start + 2, n, "Colon")

define parse_style_decl(tokens: [Token], start: number, n: number) -> StyleStep:
    empty = StyleDecl{name: "", fields: []}
    if start >= n:
        return StyleStep{style: empty, next: start, ok: false, error: "expected name after `style`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return StyleStep{style: empty, next: start, ok: false, error: "expected name after `style`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Colon"):
        return StyleStep{style: empty, next: i, ok: false, error: "expected `:` after style name"}
    i = i + 1
    style_col = if start >= 1 then tokens[start - 1].col else 0
    edit fields = []
    loop:
        i = skip_newlines(tokens, i, n)
        if i >= n:
            break
        if tokens[i].col <= style_col:
            break
        if at_rule_starter(tokens, i, n):
            break
        fstep = parse_field(tokens, i, n)
        if not fstep.ok:
            return StyleStep{style: empty, next: i, ok: false, error: fstep.error}
        fields = append(fields, fstep.field)
        i = fstep.next
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    StyleStep{style: StyleDecl{name: name, fields: fields}, next: i, ok: true, error: ""}

define apply_styles_rules(rules: [Rule], styles: [StyleDecl]) -> [Rule]:
    edit out = []
    loop i in 0 until length(rules):
        r = rules[i]
        out = append(out, Rule{name: r.name, params: r.params, body: apply_styles_body(r.body, styles), trigger: r.trigger, condition: r.condition})
    out

define apply_styles_body(body: [Stmt], styles: [StyleDecl]) -> [Stmt]:
    edit out = []
    loop i in 0 until length(body):
        out = append(out, apply_styles_stmt(body[i], styles))
    out

define apply_styles_stmt(s: Stmt, styles: [StyleDecl]) -> Stmt:
    if stmt_is_spawn(s):
        fields = stmt_spawn_fields(s)
        sname = fe_field_text(fields, "style")
        if length(sname) is 0:
            s
        else:
            sfields = find_style_fields(styles, sname)
            merged = merge_missing_fields(fe_strip_field(fields, "style"), sfields)
            SpawnEntity(stmt_spawn_kind(s), merged)
    else:
        apply_styles_control(s, styles)

define apply_styles_control(s: Stmt, styles: [StyleDecl]) -> Stmt:
    choose s:
        IfStmt(c, b) then IfStmt(c, apply_styles_body(b, styles))
        ForEach(vn, sr, pr, b) then ForEach(vn, sr, pr, apply_styles_body(b, styles))
        _ then s

define find_style_fields(styles: [StyleDecl], name: text) -> [FieldExpr]:
    edit out = []
    loop i in 0 until length(styles):
        st = styles[i]
        if fe_name_eq(st.name, name):
            out = st.fields
    out

# base wins; append extra fields whose names aren't already in base.
define merge_missing_fields(base: [FieldExpr], extra: [FieldExpr]) -> [FieldExpr]:
    edit out = base
    loop i in 0 until length(extra):
        f = extra[i]
        if not fe_field_has(base, f.name):
            out = append(out, f)
    out

# ── Parent inference ── a `create` indented deeper than another becomes
# its child. Post-pass over every rule body: parse_spawn_stmt stashed each
# create's column as __col; here we resolve parent = nearest EARLIER create
# with a smaller column, then strip __col so it never reaches the entity.
# An explicit `parent:` always wins; a nameless create can't be a parent.
# Existing apps are untouched: flat creates (same column) infer nothing.
public define infer_parents_rules(rules: [Rule]) -> [Rule]:
    edit out = []
    loop i in 0 until length(rules):
        r = rules[i]
        out = append(out, Rule{name: r.name, params: r.params, body: infer_parents_body(r.body), trigger: r.trigger, condition: r.condition})
    out

define infer_parents_body(body: [Stmt]) -> [Stmt]:
    edit out = []
    loop i in 0 until length(body):
        out = append(out, infer_one_stmt(body, i))
    out

# Layout metadata (parent / source-order / auto-name) is a WIDGET concern:
# only Panel and Text are auto-rendered + laid out. A game-entity create
# (Block, Bullet, …) is imperative gameplay — it keeps EXACTLY its authored
# fields, no dead `name`/`order` riding along at spawn scale.
define is_widget_kind(k: text) -> truth:
    k is "Panel" or k is "Text"

define infer_one_stmt(body: [Stmt], idx: number) -> Stmt:
    s = body[idx]
    if stmt_is_spawn(s):
        kind = stmt_spawn_kind(s)
        base = fe_strip_field(stmt_spawn_fields(s), "__col")
        if not is_widget_kind(kind):
            SpawnEntity(kind, base)
        else:
            col = stmt_spawn_col(s)
            pname = nearest_parent_name(body, idx, col)
            f3 = if fe_field_has(base, "parent") or length(pname) is 0 then base else append(base, FieldExpr{name: "parent", value: LitText(pname)})
            # Stamp source order so flex layout follows how creates are WRITTEN
            # (entity ids batch per type, so id order isn't source order). An
            # explicit `order:` still overrides. Kills the manual `order:` prop.
            f4 = if fe_field_has(f3, "order") then f3 else append(f3, FieldExpr{name: "order", value: LitInt(idx)})
            # Auto-name nameless creates so children can reference them (parent
            # + the visibility cascade look parents up by name). `name:` stays
            # optional — you only write it when YOU need to target the widget.
            f5 = if fe_field_has(f4, "name") then f4 else append(f4, FieldExpr{name: "name", value: LitText("__w{idx}")})
            SpawnEntity(kind, f5)
    else:
        choose s:
            # A `for` nested in the tree: its rows attach to the container the
            # loop sits under (nearest earlier spawn with a smaller column
            # than the `each` keyword) and sort at the loop's own position.
            # So a nested `for` drops explicit `parent:`/`order:`. Top-level
            # loops (each_col 0) find no such container → parent stays empty,
            # so game loops that spawn free entities are unaffected.
            ForEach(iter, src, filter, fbody) then ForEach(iter, src, filter, infer_foreach_body(fbody, nearest_parent_name(body, idx, foreach_eachcol(fbody)), idx))
            _ then strip_one_stmt(s)

# Attach every root row of a nested loop's body to `parent` at `order_val`.
# Explicit parent/order on a row still win. Flat bodies (one Panel per item,
# the palette-row case) are exact; a row with its OWN children keeps them via
# explicit parent (deep nesting inside a loop is not inferred).
define infer_foreach_body(fbody: [Stmt], parent: text, order_val: number) -> [Stmt]:
    # A KEYED body (`each … key EXPR`) can nest: children resolve `parent:` to
    # their in-body root by column, and every widget is named from the key so
    # per-type id batching can't collide names across iterations. A keyless
    # body keeps the old flat behaviour (one Panel per item, all re-parented
    # to the container).
    if foreach_body_keyed(fbody):
        return infer_keyed_body(fbody, parent, order_val)
    edit out = []
    loop i in 0 until length(fbody):
        bs = fbody[i]
        if stmt_is_spawn(bs):
            f = fe_strip_field(fe_strip_field(stmt_spawn_fields(bs), "__col"), "__eachcol")
            if not is_widget_kind(stmt_spawn_kind(bs)):
                out = append(out, SpawnEntity(stmt_spawn_kind(bs), f))
            else:
                f2 = if fe_field_has(f, "parent") or length(parent) is 0 then f else append(f, FieldExpr{name: "parent", value: LitText(parent)})
                f3 = if fe_field_has(f2, "order") then f2 else append(f2, FieldExpr{name: "order", value: LitInt(order_val)})
                out = append(out, SpawnEntity(stmt_spawn_kind(bs), f3))
        else:
            out = append(out, strip_one_stmt(bs))
    out

define foreach_body_keyed(fbody: [Stmt]) -> truth:
    edit r = false
    loop i in 0 until length(fbody):
        bs = fbody[i]
        if stmt_is_spawn(bs) and fe_field_has(stmt_spawn_fields(bs), "__key"):
            r = true
    r

define fe_field_expr(fields: [FieldExpr], key: text) -> Expr:
    edit r = LitInt(0)
    loop i in 0 until length(fields):
        f = fields[i]
        if fe_name_eq(f.name, key):
            r = f.value
    r

# Nearest earlier body spawn with a STRICTLY smaller column — its INDEX (so a
# keyed name can be rebuilt from its position). -1 = none (this row is a root).
define nearest_smaller_col_idx(body: [Stmt], idx: number, col: number) -> number:
    edit j = idx - 1
    edit result = 0 - 1
    edit done = false
    loop:
        if done or j < 0:
            break
        cj = stmt_spawn_col(body[j])
        if cj >= 0 and cj < col:
            result = j
            done = true
        else:
            j = j - 1
    result

# Per-instance widget name: a position-stable prefix + the loop's key value
# (`"__k{pos}_" + cmd.id`). Unique per widget (distinct pos) AND per row
# (distinct key), so a child's `parent:` resolves to ITS row's root, not the
# last-spawned one.
define keyed_name(idx: number, key: Expr) -> Expr:
    Binop("+", LitText("__k{idx}_"), ast_copy_expr(key))

# Keyed loop body: infer nesting by column (like infer_one_stmt does outside a
# loop), naming every widget from the key so the structure survives batching.
define infer_keyed_body(fbody: [Stmt], container: text, order_val: number) -> [Stmt]:
    edit out = []
    loop i in 0 until length(fbody):
        bs = fbody[i]
        if stmt_is_spawn(bs):
            f0 = stmt_spawn_fields(bs)
            col = fe_field_int(f0, "__col", 0)
            keyexpr = fe_field_expr(f0, "__key")
            fa = if fe_field_has(f0, "name") then f0 else append(f0, FieldExpr{name: "name", value: keyed_name(i, keyexpr)})
            pidx = nearest_smaller_col_idx(fbody, i, col)
            # `order` is a GLOBAL paint index (z-order render sorts every widget
            # by it). The whole keyed subtree must sit at the loop's slot, so
            # base it on order_val: root (i=0) = order_val, each nested child
            # +i after. A bare `i` would be a tiny local index (1,2) → the child
            # paints FIRST, then the card + everything paints over it (invisible).
            row_order = order_val + i
            fb = if fe_field_has(fa, "parent") then fa else if pidx >= 0 then append(fa, FieldExpr{name: "parent", value: keyed_name(pidx, keyexpr)}) else if length(container) > 0 then append(fa, FieldExpr{name: "parent", value: LitText(container)}) else fa
            fc = if fe_field_has(fb, "order") then fb else append(fb, FieldExpr{name: "order", value: LitInt(row_order)})
            fd = fe_strip_field(fe_strip_field(fe_strip_field(fc, "__col"), "__eachcol"), "__key")
            out = append(out, SpawnEntity(stmt_spawn_kind(bs), fd))
        else:
            out = append(out, strip_one_stmt(bs))
    out

define foreach_eachcol(fbody: [Stmt]) -> number:
    edit col = 0 - 1
    loop i in 0 until length(fbody):
        s = fbody[i]
        if col < 0 and stmt_is_spawn(s):
            c = fe_field_int(stmt_spawn_fields(s), "__eachcol", 0 - 1)
            if c >= 0:
                col = c
    col

# Nearest earlier create with a STRICTLY smaller column is the parent.
define nearest_parent_name(body: [Stmt], idx: number, col: number) -> text:
    edit j = idx - 1
    edit result = ""
    edit done = false
    loop:
        if done or j < 0:
            break
        cj = stmt_spawn_col(body[j])
        if cj >= 0 and cj < col:
            pn = stmt_spawn_name(body[j])
            # Match the auto-name infer_one_stmt assigns to a nameless parent.
            result = if length(pn) > 0 then pn else "__w{j}"
            done = true
        else:
            j = j - 1
    result

# Strip __col from a stmt (and recurse into control-flow bodies) without
# inferring parent — nested-in-if/for creates keep their explicit parent.
define strip_one_stmt(s: Stmt) -> Stmt:
    choose s:
        SpawnEntity(k, f) then SpawnEntity(k, fe_strip_field(f, "__col"))
        IfStmt(c, b) then IfStmt(c, strip_cols_body(b))
        ForEach(vn, sr, pr, b) then ForEach(vn, sr, pr, strip_cols_body(b))
        _ then s

define strip_cols_body(body: [Stmt]) -> [Stmt]:
    edit out = []
    loop i in 0 until length(body):
        out = append(out, strip_one_stmt(body[i]))
    out

define stmt_is_spawn(s: Stmt) -> truth:
    choose s:
        SpawnEntity(k, f) then true
        _ then false

define stmt_spawn_kind(s: Stmt) -> text:
    choose s:
        SpawnEntity(k, f) then k
        _ then ""

define stmt_spawn_fields(s: Stmt) -> [FieldExpr]:
    choose s:
        SpawnEntity(k, f) then f
        _ then []

define stmt_spawn_col(s: Stmt) -> number:
    choose s:
        SpawnEntity(k, f) then fe_field_int(f, "__col", 0 - 1)
        _ then 0 - 1

define fe_field_int(fields: [FieldExpr], key: text, dflt: number) -> number:
    edit r = dflt
    loop i in 0 until length(fields):
        f = fields[i]
        if fe_name_eq(f.name, key):
            r = expr_as_int(f.value, dflt)
    r

define fe_field_text(fields: [FieldExpr], key: text) -> text:
    edit r = ""
    loop i in 0 until length(fields):
        f = fields[i]
        if fe_name_eq(f.name, key):
            r = expr_as_text(f.value)
    r

define fe_field_has(fields: [FieldExpr], key: text) -> truth:
    edit found = false
    loop i in 0 until length(fields):
        f = fields[i]
        if fe_name_eq(f.name, key):
            found = true
    found

define fe_strip_field(fields: [FieldExpr], key: text) -> [FieldExpr]:
    edit out = []
    loop i in 0 until length(fields):
        f = fields[i]
        if not fe_name_eq(f.name, key):
            out = append(out, f)
    out

# Pub so atlas_project can read style-field literal values at load time.
public define expr_as_int(e: Expr, dflt: number) -> number:
    choose e:
        LitInt(v) then v
        _ then dflt

public define expr_as_text(e: Expr) -> text:
    choose e:
        LitText(s) then s
        _ then ""

public define expr_is_int(e: Expr) -> truth:
    choose e:
        LitInt(v) then true
        _ then false

# Content equality (text ` is ` is pointer-eq on runtime strings).
define fe_name_eq(a: text, b: text) -> truth:
    ba = bytes_of(a)
    bb = bytes_of(b)
    la = bytes_count(ba)
    if la is not bytes_count(bb):
        false
    else:
        edit eq = true
        edit i = 0
        loop:
            if i >= la:
                break
            if byte_at(ba, i) is not byte_at(bb, i):
                eq = false
            i = i + 1
        eq

define stmt_spawn_name(s: Stmt) -> text:
    choose s:
        SpawnEntity(k, f) then fe_field_text(f, "name")
        _ then ""

# `destroy EXPR` — EXPR yields a RefV/IntV. For bulk delete use
# `each x in list: destroy x.eid` — one consistent way to iterate.
define parse_destroy_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    step = parse_expr(tokens, start, n)
    if not step.ok:
        return StmtStep{stmt: DestroyEntity(LitInt(0)), next: step.next, ok: false, error: step.error}
    StmtStep{stmt: DestroyEntity(step.value), next: step.next, ok: true, error: ""}

# `set NAME = EXPR` (resource/var write) or `set EXPR.FIELD = EXPR`
# (entity field write). Disambiguates by peeking after the first ident.
define parse_set_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    if start >= n:
        return StmtStep{stmt: SetVar("", LitInt(0)), next: start, ok: false, error: "expected target after `set`"}
    # Parse target as bare IDENT (+ optional .field chain). Cannot use
    # parse_postfix here because parse_primary would grab `IDENT = VAL`
    # as an implicit let-in expression, consuming the RHS and leaving
    # nothing for our own Assign match.
    lhs = parse_assign_target(tokens, start, n)
    if not lhs.ok:
        return StmtStep{stmt: SetVar("", LitInt(0)), next: lhs.next, ok: false, error: lhs.error}
    edit i = lhs.next
    # Accept `=` OR `becomes` — the state-transition spelling desugars
    # to the same SetVar/SetField (A2 laws-sugar).
    if not (match_tok(tokens, i, n, "Assign") or match_tok(tokens, i, n, "Becomes")):
        return StmtStep{stmt: SetVar("", LitInt(0)), next: i, ok: false, error: "expected `=` or `becomes` after target"}
    i = i + 1
    rhs = parse_expr(tokens, i, n)
    if not rhs.ok:
        return StmtStep{stmt: SetVar("", LitInt(0)), next: rhs.next, ok: false, error: rhs.error}
    # Optional `confidence N` suffix (B2, uncertainty-as-type): tags the
    # fact with a 0-100 certainty stored as a parallel `conf:<fact>`
    # resource, read back by the `confidence(fact)` query. Pure sugar —
    # `x = v confidence n` becomes SetVar(x, v) + SetVar(conf:x, n).
    if match_tok(tokens, rhs.next, n, "Confidence"):
        cname = varref_name_of(lhs.value)
        if cname is "":
            return StmtStep{stmt: SetVar("", LitInt(0)), next: rhs.next, ok: false, error: "confidence can only tag a plain `name = value` fact"}
        cstep = parse_expr(tokens, rhs.next + 1, n)
        if not cstep.ok:
            return StmtStep{stmt: SetVar("", LitInt(0)), next: cstep.next, ok: false, error: cstep.error}
        setv = SetVar(cname, rhs.value)
        setc = SetVar("conf:" + cname, cstep.value)
        return StmtStep{stmt: IfStmt(LitBool(true), append(append([], setv), setc)), next: cstep.next, ok: true, error: ""}
    # Classify the LHS — VarRef → SetVar; Field → SetField.
    classify_set(lhs.value, rhs.value, rhs.next)

define varref_name_of(e: Expr) -> text:
    choose e:
        VarRef(nm) then nm
        _ then ""

# `confidence(FACT)` -> VarRef("conf:FACT") — reads the parallel
# certainty resource a `= v confidence n` fact wrote (B2). Pure sugar:
# the conf: resource is auto-ctx bound, so a rule can `when
# confidence(enemy_at) > 50: ...` reason over how sure it is. Unset
# confidence reads 0 (unknown), so a plain fact is implicitly uncertain.
define parse_confidence_query(tokens: [Token], start: number, n: number) -> ExprStep:
    if not match_tok(tokens, start, n, "LParen"):
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "expected `(` after `confidence`"}
    i = start + 1
    fact = ident_of(tokens[i].tok)
    if fact is "":
        return ExprStep{value: LitInt(0), next: i, ok: false, error: "expected fact name in confidence(...)"}
    edit j = i + 1
    if not match_tok(tokens, j, n, "RParen"):
        return ExprStep{value: LitInt(0), next: j, ok: false, error: "expected `)` after confidence fact"}
    j = j + 1
    ExprStep{value: VarRef("conf:" + fact), next: j, ok: true, error: ""}

# Parse `IDENT[.field]*` as a set target. Standalone helper (not going
# through parse_postfix/primary) because the primary path hijacks
# `IDENT = ...` into an implicit let-in expression.
define parse_assign_target(tokens: [Token], start: number, n: number) -> ExprStep:
    if start >= n:
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "expected assign target"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "expected assign target name"}
    edit e = VarRef(name)
    edit i = start + 1
    loop:
        if match_tok(tokens, i, n, "Dot"):
            if i + 1 >= n:
                return ExprStep{value: e, next: i, ok: false, error: "expected field name after `.`"}
            field = ident_of(tokens[i + 1].tok)
            if field is "":
                return ExprStep{value: e, next: i, ok: false, error: "expected field name after `.`"}
            e = Field(e, field)
            i = i + 2
        else:
            break
    ExprStep{value: e, next: i, ok: true, error: ""}

# Look ahead for `IDENT = ...` or `IDENT.field = ...` so we can treat
# implicit assignments as set statements without the `set` keyword.
define looks_like_assignment(tokens: [Token], start: number, n: number) -> truth:
    if start >= n:
        return false
    if ident_of(tokens[start].tok) is "":
        return false
    edit i = start + 1
    loop:
        if i >= n:
            break
        if match_tok(tokens, i, n, "Dot"):
            i = i + 2
        else:
            break
    # `becomes` is a law-readable synonym for `=`: `player becomes dead`
    # is the state-transition spelling of `player = dead` (A2, idea #7).
    match_tok(tokens, i, n, "Assign") or match_tok(tokens, i, n, "Becomes")

# `if COND: body-stmt` — single-branch conditional. No else. For
# expression-form conditionals use `if-then-else` inside an expression.
define parse_if_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    cond_step = parse_expr(tokens, start, n)
    if not cond_step.ok:
        return StmtStep{stmt: IfStmt(LitBool(false), []), next: cond_step.next, ok: false, error: cond_step.error}
    edit i = cond_step.next
    if not match_tok(tokens, i, n, "Colon"):
        return StmtStep{stmt: IfStmt(cond_step.value, []), next: i, ok: false, error: "expected `:` after if condition"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    body_step = parse_stmt(tokens, i, n)
    if not body_step.ok:
        return StmtStep{stmt: IfStmt(cond_step.value, []), next: body_step.next, ok: false, error: body_step.error}
    StmtStep{stmt: IfStmt(cond_step.value, append([], body_step.stmt)), next: body_step.next, ok: true, error: ""}

# `relate SOURCE kind TARGET` — create a relation SOURCE -kind-> TARGET
# (A3, idea #5). SOURCE/TARGET are exprs (entity refs), kind a bare
# identifier: `relate player owns sword`, `relate wolf hunts player`.
define parse_relate_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    a = parse_expr(tokens, start, n)
    if not a.ok:
        return StmtStep{stmt: SetVar("", LitInt(0)), next: a.next, ok: false, error: a.error}
    edit i = a.next
    kind = ident_of(tokens[i].tok)
    if kind is "":
        return StmtStep{stmt: SetVar("", LitInt(0)), next: i, ok: false, error: "expected relation kind after `relate SOURCE`"}
    i = i + 1
    b = parse_expr(tokens, i, n)
    if not b.ok:
        return StmtStep{stmt: SetVar("", LitInt(0)), next: b.next, ok: false, error: b.error}
    StmtStep{stmt: RelateStmt(a.value, kind, b.value), next: b.next, ok: true, error: ""}

# `after N: name = value` — a delayed set (A2, idea #7). N is a tick
# count; the write lands N ticks from now. PURE PARSER SUGAR, no core
# enum: it desugars to two resource writes inside an always-true block —
#   __after:name     = tick + N     (the fire tick, `tick` from ctx)
#   __after_val:name = value        (the value to set when it fires)
# The host scans `__after:*` each tick and, when tick reaches the fire
# tick, sets `name = __after_val:name` and disarms (`__after:name = 0`).
# Resources are ints, so they save/rewind and self-manage lifetime — no
# timer-list, no pool dance. Only ONE pending `after` per target name in
# v1 (a second arm overwrites the first's fire tick). `becomes` accepted
# as the law-readable synonym for `=`.
define parse_after_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    delay = parse_expr(tokens, start, n)
    if not delay.ok:
        return StmtStep{stmt: SetVar("", LitInt(0)), next: delay.next, ok: false, error: delay.error}
    edit i = delay.next
    if not match_tok(tokens, i, n, "Colon"):
        return StmtStep{stmt: SetVar("", LitInt(0)), next: i, ok: false, error: "expected `:` after `after N`"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    name = ident_of(tokens[i].tok)
    if name is "":
        return StmtStep{stmt: SetVar("", LitInt(0)), next: i, ok: false, error: "expected target name after `after N:`"}
    i = i + 1
    if not (match_tok(tokens, i, n, "Assign") or match_tok(tokens, i, n, "Becomes")):
        return StmtStep{stmt: SetVar("", LitInt(0)), next: i, ok: false, error: "expected `=` or `becomes` in `after N: name = value`"}
    i = i + 1
    val = parse_expr(tokens, i, n)
    if not val.ok:
        return StmtStep{stmt: SetVar("", LitInt(0)), next: val.next, ok: false, error: val.error}
    fire = Binop("+", VarRef("tick"), delay.value)
    arm = SetVar("__after:" + name, fire)
    stash = SetVar("__after_val:" + name, val.value)
    StmtStep{stmt: IfStmt(LitBool(true), append(append([], arm), stash)), next: val.next, ok: true, error: ""}

define classify_set(lhs: Expr, rhs: Expr, next: number) -> StmtStep:
    choose lhs:
        VarRef(name) then StmtStep{stmt: SetVar(name, rhs), next: next, ok: true, error: ""}
        Field(base, field_name) then StmtStep{stmt: SetField(base, field_name, rhs), next: next, ok: true, error: ""}
        _ then StmtStep{stmt: SetVar("", rhs), next: next, ok: false, error: "set target must be a name or a field access"}

# `for x in EXPR: <body-stmt>` — runtime list iteration inside a rule.
# Body is one statement (commonly spawn/emit). The expression must
# yield a ListV at eval time.
define parse_foreach_stmt(tokens: [Token], start: number, n: number) -> StmtStep:
    if start >= n:
        return StmtStep{stmt: ForEach("", LitInt(0), LitBool(true), []), next: start, ok: false, error: "expected iter name after `for`"}
    # Two spellings: `for ITER in EXPR:` and `each EXPR as ITER:`. The
    # for-form leads with the iter name then `in`; anything else is the
    # each-form (source first, then `as ITER`) — reads like plain English.
    edit iter_name = ""
    edit src_expr = LitInt(0)
    edit i = start
    if ident_of(tokens[start].tok) is not "" and match_tok(tokens, start + 1, n, "In"):
        iter_name = ident_of(tokens[start].tok)
        ps = parse_postfix(tokens, start + 2, n)
        if not ps.ok:
            return StmtStep{stmt: ForEach(iter_name, LitInt(0), LitBool(true), []), next: ps.next, ok: false, error: ps.error}
        src_expr = ps.value
        i = ps.next
    else:
        ps = parse_postfix(tokens, start, n)
        if not ps.ok:
            return StmtStep{stmt: ForEach("", LitInt(0), LitBool(true), []), next: ps.next, ok: false, error: ps.error}
        src_expr = ps.value
        i = ps.next
        if ident_of(tokens[i].tok) is not "as":
            return StmtStep{stmt: ForEach("", LitInt(0), LitBool(true), []), next: i, ok: false, error: "expected `in` (for x in list) or `as` (each list as x)"}
        i = i + 1
        iter_name = ident_of(tokens[i].tok)
        if iter_name is "":
            return StmtStep{stmt: ForEach("", LitInt(0), LitBool(true), []), next: i, ok: false, error: "expected iter name after `as`"}
        i = i + 1
    # Optional `key EXPR` — a per-item STABLE IDENTITY (`each commands as cmd
    # key cmd.id`). Stamped onto the body's root spawns as `__key`; the
    # runtime derives a per-instance name from it, so nested children inside a
    # loop can reference their own row (entity ids batch per type, so a static
    # name would collide across iterations) AND the same key maps to the same
    # entity across re-renders (identity for animation/focus/diff). `key` is a
    # bare ident (no keyword surgery); absent → today's behaviour, no __key.
    edit key_expr = LitInt(0)
    edit has_key = false
    if ident_of(tokens[i].tok) is "key":
        k_step = parse_expr(tokens, i + 1, n)
        if not k_step.ok:
            return StmtStep{stmt: ForEach(iter_name, src_expr, LitBool(true), []), next: k_step.next, ok: false, error: k_step.error}
        key_expr = k_step.value
        has_key = true
        i = k_step.next
    # Optional `where COND_EXPR`
    edit filter = LitBool(true)
    if match_tok(tokens, i, n, "Where"):
        i = i + 1
        f_step = parse_expr(tokens, i, n)
        if not f_step.ok:
            return StmtStep{stmt: ForEach(iter_name, src_expr, LitBool(true), []), next: f_step.next, ok: false, error: f_step.error}
        filter = f_step.value
        i = f_step.next
    if not match_tok(tokens, i, n, "Colon"):
        return StmtStep{stmt: ForEach(iter_name, src_expr, filter, []), next: i, ok: false, error: "expected `:` after for-each header"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    # Body: stmts more indented than the `each` keyword itself. A stmt
    # starting at or left of the header's column is a dedent — it belongs
    # to the enclosing block, not this loop. (Without this, a sibling
    # statement after a nested loop is silently swallowed into the loop
    # body and runs once per iteration.)
    each_col = if start >= 1 then tokens[start - 1].col else 0
    edit body_stmts = []
    loop:
        if i >= n:
            break
        if at_rule_starter(tokens, i, n):
            break
        t = tokens[i]
        if is_newline(t.tok):
            i = i + 1
        else:
            if t.col <= each_col:
                break
            step = parse_stmt(tokens, i, n)
            if not step.ok:
                return StmtStep{stmt: ForEach(iter_name, src_expr, filter, body_stmts), next: step.next, ok: false, error: step.error}
            body_stmts = append(body_stmts, step.stmt)
            i = step.next
    # Stamp the `each` keyword's own column onto the body spawns so the
    # parent-inference post-pass can attach the body's root rows to the
    # container the loop is NESTED UNDER (not the preceding sibling). This
    # is what lets a `for` inside a Panel drop its explicit `parent:`/`order:`.
    stamped = stamp_body_eachcol(body_stmts, each_col)
    keyed = if has_key then stamp_body_key(stamped, key_expr) else stamped
    StmtStep{stmt: ForEach(iter_name, src_expr, filter, keyed), next: i, ok: true, error: ""}

define stamp_body_eachcol(body: [Stmt], col: number) -> [Stmt]:
    edit out = []
    loop i in 0 until length(body):
        s = body[i]
        choose s:
            SpawnEntity(k, f) then out = append(out, SpawnEntity(k, append(f, FieldExpr{name: "__eachcol", value: LitInt(col)})))
            _ then out = append(out, s)
    out

# Stamp the loop's `key EXPR` onto each root spawn as `__key`, so the runtime
# can derive a per-instance identity from it (the key expr references the iter
# var, evaluated per iteration at spawn). ast_copy per stamp so root rows
# don't share one expr node.
define stamp_body_key(body: [Stmt], key: Expr) -> [Stmt]:
    edit out = []
    loop i in 0 until length(body):
        s = body[i]
        choose s:
            SpawnEntity(k, f) then out = append(out, SpawnEntity(k, append(f, FieldExpr{name: "__key", value: ast_copy_expr(key)})))
            _ then out = append(out, s)
    out

# ---- components: `component NAME(params):` + a widget subtree ----

type CompTemplStep: template: ComponentTemplate, next: number, ok: truth, error: text

define parse_component_template(tokens: [Token], start: number, n: number, kw_col: number) -> CompTemplStep:
    empty = ComponentTemplate{name: "", params: [], body: []}
    if start >= n:
        return CompTemplStep{template: empty, next: start, ok: false, error: "expected component name"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return CompTemplStep{template: empty, next: start, ok: false, error: "expected component name"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "LParen"):
        return CompTemplStep{template: empty, next: i, ok: false, error: "expected `(` after component name"}
    i = i + 1
    edit params = []
    loop:
        if i >= n:
            break
        if match_tok(tokens, i, n, "RParen"):
            break
        pname = ident_of(tokens[i].tok)
        if pname is "":
            return CompTemplStep{template: empty, next: i, ok: false, error: "expected param name or `)` in component"}
        i = i + 1
        edit ptype = ""
        if match_tok(tokens, i, n, "Colon"):
            i = i + 1
            if i < n:
                ptype = ident_of(tokens[i].tok)
                i = i + 1
        params = append(params, Param{name: pname, type_name: ptype})
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
    if not match_tok(tokens, i, n, "RParen"):
        return CompTemplStep{template: empty, next: i, ok: false, error: "expected `)` after component params"}
    i = i + 1
    if not match_tok(tokens, i, n, "Colon"):
        return CompTemplStep{template: empty, next: i, ok: false, error: "expected `:` after component header"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    # Body: stmts indented deeper than the `component` keyword (like a for body).
    edit body_stmts = []
    loop:
        if i >= n:
            break
        if at_rule_starter(tokens, i, n):
            break
        tk = tokens[i]
        if is_newline(tk.tok):
            i = i + 1
        else:
            if tk.col <= kw_col:
                break
            step = parse_stmt(tokens, i, n)
            if not step.ok:
                return CompTemplStep{template: empty, next: step.next, ok: false, error: step.error}
            body_stmts = append(body_stmts, step.stmt)
            i = step.next
    CompTemplStep{template: ComponentTemplate{name: name, params: params, body: body_stmts}, next: i, ok: true, error: ""}

# Index of the template named `name`, or -1. Byte-compare (parsed idents).
define find_template(name: text, templates: [ComponentTemplate]) -> number:
    edit idx = 0 - 1
    loop i in 0 until length(templates):
        t = templates[i]
        if fe_name_eq(t.name, name):
            idx = i
    idx

# Lowest __col in a body — the root's column (children indent deeper).
define body_min_col(body: [Stmt]) -> number:
    edit m = 1000000
    loop i in 0 until length(body):
        s = body[i]
        if stmt_is_spawn(s):
            c = fe_field_int(stmt_spawn_fields(s), "__col", 0)
            if c < m:
                m = c
    if m is 1000000 then 0 else m

define fe_set_field(fields: [FieldExpr], key: text, value: Expr) -> [FieldExpr]:
    append(fe_strip_field(fields, key), FieldExpr{name: key, value: value})

# Rebase one expanded body stmt onto the call site: shift its column by
# `delta` so it nests under the call's parent, and carry the call's loop
# stamps (__eachcol / __key) so a component used inside a keyed loop behaves
# exactly like the hand-written subtree.
define rebase_stmt(s: Stmt, delta: number, eachcol: number, has_key: truth, key: Expr) -> Stmt:
    choose s:
        SpawnEntity(k, f) then 
            oldcol = fe_field_int(f, "__col", 0)
            f1 = fe_set_field(f, "__col", LitInt(oldcol + delta))
            f2 = if eachcol >= 0 then fe_set_field(f1, "__eachcol", LitInt(eachcol)) else f1
            f3 = if has_key then fe_set_field(f2, "__key", ast_copy_expr(key)) else f2
            SpawnEntity(k, f3)
        _ then s

# Expand one `NAME(args)` call into the component's body: bind params to the
# __argN exprs, substitute, expand any nested calls, then rebase to the call.
define expand_one_call(call: Stmt, tmpl: ComponentTemplate, templates: [ComponentTemplate]) -> [Stmt]:
    cf = stmt_spawn_fields(call)
    call_col = fe_field_int(cf, "__col", 0)
    call_eachcol = fe_field_int(cf, "__eachcol", 0 - 1)
    has_key = fe_field_has(cf, "__key")
    call_key = fe_field_expr(cf, "__key")
    edit param_names = []
    edit arg_exprs = []
    loop k in 0 until length(tmpl.params):
        p = tmpl.params[k]
        param_names = append(param_names, p.name)
        arg_exprs = append(arg_exprs, fe_field_expr(cf, "__arg{k}"))
    substituted = ct_subst_stmts(tmpl.body, param_names, arg_exprs)
    nested = expand_components(substituted, templates)
    delta = call_col - body_min_col(tmpl.body)
    edit out = []
    loop i in 0 until length(nested):
        out = append(out, rebase_stmt(nested[i], delta, call_eachcol, has_key, call_key))
    out

# Walk the tree; replace every `NAME(args)` SpawnEntity (NAME a declared
# component) with its expanded body. Recurses into for/if bodies.
define expand_components(stmts: [Stmt], templates: [ComponentTemplate]) -> [Stmt]:
    edit out = []
    loop i in 0 until length(stmts):
        s = stmts[i]
        ti = if stmt_is_spawn(s) then find_template(stmt_spawn_kind(s), templates) else 0 - 1
        if ti >= 0:
            expanded = expand_one_call(s, templates[ti], templates)
            loop j in 0 until length(expanded):
                out = append(out, expanded[j])
        else:
            choose s:
                ForEach(vn, sr, pr, b) then out = append(out, ForEach(vn, sr, pr, expand_components(b, templates)))
                IfStmt(c, b) then out = append(out, IfStmt(c, expand_components(b, templates)))
                _ then out = append(out, s)
    out

# ---- expression grammar (precedence climbing) ----
#
# Levels low → high:
#   1: or          2: and        3: is is not 4: < <= > >=
#   5: + -         6: * / %      7: unary -, not
#   8: postfix (.field, (args)) 9: primary

type ExprStep: value: Expr, next: number, ok: truth, error: text

public define parse_expr(tokens: [Token], start: number, n: number) -> ExprStep:
    parse_binop(tokens, start, n, 1)

# Token-kind → operator-string + precedence. Empty op means "not a binop".
define binop_at(tokens: [Token], i: number, n: number) -> text:
    if i >= n:
        return ""
    k = tok_kind(tokens[i].tok)
    if k is "Or" then "or"
    else if k is "And" then "and"
    else if k is "Eq" then "=="
    else if k is "Ne" then "!="
    else if k is "Lt" then "<"
    else if k is "Le" then "<="
    else if k is "Gt" then ">"
    else if k is "Ge" then ">="
    else if k is "Plus" then "+"
    else if k is "Minus" then "-"
    else if k is "Star" then "*"
    else if k is "Slash" then "/"
    else if k is "Percent" then "%"
    else ""

define prec_of(op: text) -> number:
    if op is "or" then 1
    else if op is "and" then 2
    else if op is "==" or op is "!=" then 3
    else if op is "<" or op is "<=" or op is ">" or op is ">=" then 4
    else if op is "+" or op is "-" then 5
    else if op is "*" or op is "/" or op is "%" then 6
    else 0

define parse_binop(tokens: [Token], start: number, n: number, min_prec: number) -> ExprStep:
    lhs_step = parse_unary(tokens, start, n)
    if not lhs_step.ok:
        return lhs_step
    edit lhs = lhs_step.value
    edit i = lhs_step.next
    loop:
        op = binop_at(tokens, i, n)
        if op is "":
            break
        p = prec_of(op)
        if p < min_prec:
            break
        i = i + 1
        rhs_step = parse_binop(tokens, i, n, p + 1)
        if not rhs_step.ok:
            return rhs_step
        lhs = Binop(op, lhs, rhs_step.value)
        i = rhs_step.next
    ExprStep{value: lhs, next: i, ok: true, error: ""}

define parse_unary(tokens: [Token], start: number, n: number) -> ExprStep:
    if match_tok(tokens, start, n, "Not"):
        inner = parse_unary(tokens, start + 1, n)
        if not inner.ok:
            return inner
        return ExprStep{value: Unop("not", inner.value), next: inner.next, ok: true, error: ""}
    if match_tok(tokens, start, n, "Minus"):
        inner = parse_unary(tokens, start + 1, n)
        if not inner.ok:
            return inner
        return ExprStep{value: Unop("-", inner.value), next: inner.next, ok: true, error: ""}
    parse_postfix(tokens, start, n)

define parse_postfix(tokens: [Token], start: number, n: number) -> ExprStep:
    head = parse_primary(tokens, start, n)
    if not head.ok:
        return head
    edit e = head.value
    edit i = head.next
    loop:
        if match_tok(tokens, i, n, "To"):
            rhs = parse_unary(tokens, i + 1, n)
            if not rhs.ok:
                return rhs
            e = RangeExpr(e, rhs.value)
            i = rhs.next
        else:
        if match_tok(tokens, i, n, "Through"):
            rhs = parse_unary(tokens, i + 1, n)
            if not rhs.ok:
                return rhs
            e = RangeExpr(e, Binop("+", rhs.value, LitInt(1)))
            i = rhs.next
        else:
        if match_tok(tokens, i, n, "Dot"):
            if i + 1 >= n:
                return ExprStep{value: e, next: i, ok: false, error: "expected field name after `.`"}
            name = ident_of(tokens[i + 1].tok)
            if name is "":
                return ExprStep{value: e, next: i, ok: false, error: "expected field name after `.`"}
            e = Field(e, name)
            i = i + 2
        else:
            break
    ExprStep{value: e, next: i, ok: true, error: ""}

# String interpolation: `"wood: {n}"` expands at parse time into a `+`
# concat chain — `"wood: " + n` — reusing the text-coercing `+` in the
# evaluator. `{{` and `}}` are literal braces. A string with no `{` is a
# plain LitText (fast path, unchanged). Interpolated strings always start
# from an empty LitText so a bare `"{n}"` still evaluates to text, not the
# raw value of `n`.
define text_lit_expr(s: text) -> Expr:
    bs = bytes_of(s)
    n = bytes_count(bs)
    if not has_open_brace(bs, n, 0):
        LitText(s)
    else:
        fold_concat(interp_parts(bs, n), 0, LitText(""))

define has_open_brace(bs: [number], n: number, i: number) -> truth:
    if i >= n:
        false
    else:
        if bs[i] is 123 then true else has_open_brace(bs, n, i + 1)

define fold_concat(parts: [Expr], i: number, acc: Expr) -> Expr:
    if i >= length(parts):
        acc
    else:
        fold_concat(parts, i + 1, Binop("+", acc, parts[i]))

type InnerStep: text: text, next: number

define collect_inner(bs: [number], n: number, start: number) -> InnerStep:
    edit i = start
    edit chars = []
    loop:
        if i >= n:
            break
        c = bs[i]
        if c is 125:
            break
        chars = append(chars, c)
        i = i + 1
    InnerStep{text: text_of(chars), next: i + 1}

# Lex + parse one interpolation hole as an astra expression. A hole that
# fails to lex/parse stays literal (braces and all) rather than aborting
# the whole string — a forgiving default for authored game text.
define parse_inner_expr(src: text) -> Expr:
    lr = lex(src)
    if not lr.ok:
        LitText("\{" + src + "\}")
    else:
        step = parse_expr(lr.tokens, 0, length(lr.tokens))
        if step.ok then step.value else LitText("\{" + src + "\}")

define interp_parts(bs: [number], n: number) -> [Expr]:
    edit parts = []
    edit lit = []
    edit i = 0
    loop:
        if i >= n:
            break
        c = bs[i]
        if c is 123:
            if i + 1 < n and bs[i + 1] is 123:
                lit = append(lit, 123)
                i = i + 2
            else:
                if length(lit) > 0:
                    parts = append(parts, LitText(text_of(lit)))
                    lit = []
                inner = collect_inner(bs, n, i + 1)
                # Wrap each hole in `__hole(expr, "{raw}")`. At eval the hole
                # yields its value if the name resolves (a loop var already
                # substituted, or a seeded resource), else the LITERAL `{raw}`
                # — so a hole over a resource not yet seeded when a widget
                # spawns at Init survives as `{name}` and expand_widget_text
                # resolves it at render (live), instead of baking empty.
                # ct_subst/subst recurse into Call args, so loop/component
                # substitution still reaches the inner expr.
                hole_expr = parse_inner_expr(inner.text)
                raw_lit = LitText("\{" + inner.text + "\}")
                parts = append(parts, Call("__hole", [hole_expr, raw_lit]))
                i = inner.next
        else:
            if c is 125 and i + 1 < n and bs[i + 1] is 125:
                lit = append(lit, 125)
                i = i + 2
            else:
                lit = append(lit, c)
                i = i + 1
    if length(lit) > 0:
        parts = append(parts, LitText(text_of(lit)))
    parts

define parse_primary(tokens: [Token], start: number, n: number) -> ExprStep:
    if start >= n:
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "unexpected EOF in expression"}
    t = tokens[start]
    int_v = int_of(t.tok)
    if int_v >= 0:
        return ExprStep{value: LitInt(int_v), next: start + 1, ok: true, error: ""}
    if is_str_tok(t.tok):
        return ExprStep{value: text_lit_expr(token_text(t.tok)), next: start + 1, ok: true, error: ""}
    if match_tok(tokens, start, n, "True"):
        return ExprStep{value: LitBool(true), next: start + 1, ok: true, error: ""}
    if match_tok(tokens, start, n, "False"):
        return ExprStep{value: LitBool(false), next: start + 1, ok: true, error: ""}
    if match_tok(tokens, start, n, "If"):
        return parse_if_expr(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Count"):
        return parse_count_query(tokens, start + 1, n)
    if match_tok(tokens, start, n, "From"):
        # `from A to B` / `from A through B` — the leading `from` is pure
        # readability sugar; the range itself is built by the postfix
        # `to`/`through` handler on the expression that follows. Skip the
        # keyword and parse the range normally.
        return parse_postfix(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Confidence"):
        return parse_confidence_query(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Exists"):
        return parse_quantifier(tokens, start + 1, n, "exists")
    if match_tok(tokens, start, n, "None"):
        return parse_quantifier(tokens, start + 1, n, "none")
    if match_tok(tokens, start, n, "All"):
        return parse_quantifier(tokens, start + 1, n, "all")
    if match_tok(tokens, start, n, "Let"):
        return parse_let_in_expr(tokens, start + 1, n)
    if match_tok(tokens, start, n, "Match"):
        return parse_match_expr(tokens, start + 1, n)
    if match_tok(tokens, start, n, "LBracket"):
        return parse_list_literal(tokens, start + 1, n)
    if match_tok(tokens, start, n, "LBrace"):
        return parse_map_literal(tokens, start + 1, n)
    if match_tok(tokens, start, n, "LParen"):
        inner = parse_expr(tokens, start + 1, n)
        if not inner.ok:
            return inner
        if not match_tok(tokens, inner.next, n, "RParen"):
            return ExprStep{value: inner.value, next: inner.next, ok: false, error: "expected `)`"}
        return ExprStep{value: inner.value, next: inner.next + 1, ok: true, error: ""}
    name = ident_of(t.tok)
    if name is not "":
        if match_tok(tokens, start + 1, n, "Assign"):
            return parse_implicit_let_in(tokens, start, n, name)
        if match_tok(tokens, start + 1, n, "LParen"):
            return parse_call(tokens, start + 2, n, name)
        return ExprStep{value: VarRef(name), next: start + 1, ok: true, error: ""}
    ExprStep{value: LitInt(0), next: start, ok: false, error: "expected an expression"}

# After consuming `name(`, parse comma-sep args + closing `)`.
define parse_call(tokens: [Token], start: number, n: number, name: text) -> ExprStep:
    edit i = start
    edit args = []
    if match_tok(tokens, i, n, "RParen"):
        return ExprStep{value: Call(name, args), next: i + 1, ok: true, error: ""}
    loop:
        step = parse_expr(tokens, i, n)
        if not step.ok:
            return step
        args = append(args, step.value)
        i = step.next
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
        else:
            break
    if not match_tok(tokens, i, n, "RParen"):
        return ExprStep{value: Call(name, args), next: i, ok: false, error: "expected `)` in call"}
    ExprStep{value: Call(name, args), next: i + 1, ok: true, error: ""}

# After `count`, parse: `( NAME in LIST_EXPR where COND_EXPR )`. Iter
# var binds to each list element when COND_EXPR is evaluated; the result
# is the number of elements for which COND_EXPR is truthy.
define parse_count_query(tokens: [Token], start: number, n: number) -> ExprStep:
    if not match_tok(tokens, start, n, "LParen"):
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "expected `(` after `count`"}
    edit i = start + 1
    if i >= n:
        return ExprStep{value: LitInt(0), next: i, ok: false, error: "expected iter name in count"}
    iter_name = ident_of(tokens[i].tok)
    if iter_name is "":
        return ExprStep{value: LitInt(0), next: i, ok: false, error: "expected iter name in count"}
    i = i + 1
    if not match_tok(tokens, i, n, "In"):
        return ExprStep{value: LitInt(0), next: i, ok: false, error: "expected `in` after iter name"}
    i = i + 1
    list_step = parse_count_list_expr(tokens, i, n)
    if not list_step.ok:
        return list_step
    i = list_step.next
    if not match_tok(tokens, i, n, "Where"):
        return ExprStep{value: LitInt(0), next: i, ok: false, error: "expected `where` after list"}
    i = i + 1
    cond = parse_expr(tokens, i, n)
    if not cond.ok:
        return cond
    if not match_tok(tokens, cond.next, n, "RParen"):
        return ExprStep{value: LitInt(0), next: cond.next, ok: false, error: "expected `)` to close count query"}
    ExprStep{value: CountQuery(iter_name, list_step.value, cond.value), next: cond.next + 1, ok: true, error: ""}

# Parse the list source of a count query — only postfix-level exprs (no
# binops, since `where` would conflict). Accepts VarRef, Call, Field
# chains — exactly the shapes a host pre-bakes into ctx.
define parse_count_list_expr(tokens: [Token], start: number, n: number) -> ExprStep:
    parse_postfix(tokens, start, n)

# `exists ITER in LIST where COND` → desugars to `count(where COND) > 0`.
# `none   ITER in LIST where COND` → desugars to `count(where COND) is 0`.
# `all    ITER in LIST where COND` → desugars to `count(where not COND) is 0`
#   ("no element violates COND" — the universal quantifier completing the
#   exists/none/all trio, all over the same CountQuery machinery).
# Reads as natural English; clamps down the most common count idioms.
define parse_quantifier(tokens: [Token], start: number, n: number, kind: text) -> ExprStep:
    if start >= n:
        return ExprStep{value: LitBool(false), next: start, ok: false, error: "expected iter name after quantifier"}
    iter_name = ident_of(tokens[start].tok)
    if iter_name is "":
        return ExprStep{value: LitBool(false), next: start, ok: false, error: "expected iter name after quantifier"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "In"):
        return ExprStep{value: LitBool(false), next: i, ok: false, error: "expected `in` after iter name"}
    i = i + 1
    list_step = parse_postfix(tokens, i, n)
    if not list_step.ok:
        return list_step
    i = list_step.next
    if not match_tok(tokens, i, n, "Where"):
        return ExprStep{value: LitBool(false), next: i, ok: false, error: "expected `where` in quantifier"}
    i = i + 1
    cond = parse_expr(tokens, i, n)
    if not cond.ok:
        return cond
    # `all` counts VIOLATIONS (not COND) and asserts there are none; exists
    # and none count matches of COND directly.
    predicate = if kind is "all" then Unop("not", cond.value) else cond.value
    counted = CountQuery(iter_name, list_step.value, predicate)
    desugared = if kind is "exists" then Binop(">", counted, LitInt(0)) else Binop("==", counted, LitInt(0))
    ExprStep{value: desugared, next: cond.next, ok: true, error: ""}

# `match SCRUTINEE: PAT -> RESULT, PAT -> RESULT, _ -> DEFAULT`
# Pattern is currently an int literal or `_` for wildcard. Arms are
# comma- or newline-separated. Returns the body of the first matching
# arm or NoneV when no arm matches and no wildcard is present.
define parse_match_expr(tokens: [Token], start: number, n: number) -> ExprStep:
    scrut = parse_postfix(tokens, start, n)
    if not scrut.ok:
        return scrut
    edit i = scrut.next
    if not match_tok(tokens, i, n, "Colon"):
        return ExprStep{value: scrut.value, next: i, ok: false, error: "expected : after match scrutinee"}
    i = i + 1
    i = skip_newlines(tokens, i, n)
    edit arms = []
    loop:
        if i >= n:
            break
        pat = parse_match_pattern(tokens, i, n)
        if not pat.ok:
            break
        i = pat.next
        if not match_tok(tokens, i, n, "Arrow"):
            return ExprStep{value: scrut.value, next: i, ok: false, error: "expected -> after match pattern"}
        i = i + 1
        body = parse_expr(tokens, i, n)
        if not body.ok:
            return body
        arms = append(arms, MatchArm{pattern: pat.value, body: body.value})
        i = body.next
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
        i = skip_newlines(tokens, i, n)
    ExprStep{value: MatchExpr(scrut.value, arms), next: i, ok: true, error: ""}

define parse_match_pattern(tokens: [Token], start: number, n: number) -> ExprStep:
    if start >= n:
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "expected pattern"}
    t = tokens[start]
    name = ident_of(t.tok)
    if name is "_":
        return ExprStep{value: VarRef("_"), next: start + 1, ok: true, error: ""}
    int_v = int_of(t.tok)
    if int_v >= 0:
        return ExprStep{value: LitInt(int_v), next: start + 1, ok: true, error: ""}
    if is_str_tok(t.tok):
        return ExprStep{value: text_lit_expr(token_text(t.tok)), next: start + 1, ok: true, error: ""}
    ExprStep{value: LitInt(0), next: start, ok: false, error: "expected literal pattern or _"}

# `NAME = VAL <body-expr>` without the leading `let` keyword. Triggered
# from parse_primary when an identifier is followed by `=`. Same shape
# as parse_let_in_expr but starts one token earlier.
define parse_implicit_let_in(tokens: [Token], start: number, n: number, name: text) -> ExprStep:
    edit i = start + 2
    val_step = parse_expr(tokens, i, n)
    if not val_step.ok:
        return val_step
    i = skip_newlines(tokens, val_step.next, n)
    body_step = parse_expr(tokens, i, n)
    if not body_step.ok:
        return body_step
    ExprStep{value: LetIn(name, val_step.value, body_step.value), next: body_step.next, ok: true, error: ""}

# `let NAME = VAL <body-expr>` — binds NAME in scope of the body
# expression. Newlines between val and body are permitted, so fn bodies
# can stack lets without `in` glue: `let a = ...\nlet b = ...\na + b`.
define parse_let_in_expr(tokens: [Token], start: number, n: number) -> ExprStep:
    if start >= n:
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "expected name after `let`"}
    name = ident_of(tokens[start].tok)
    if name is "":
        return ExprStep{value: LitInt(0), next: start, ok: false, error: "expected name after `let`"}
    edit i = start + 1
    if not match_tok(tokens, i, n, "Assign"):
        return ExprStep{value: LitInt(0), next: i, ok: false, error: "expected `=` after let name"}
    i = i + 1
    val_step = parse_expr(tokens, i, n)
    if not val_step.ok:
        return val_step
    i = skip_newlines(tokens, val_step.next, n)
    body_step = parse_expr(tokens, i, n)
    if not body_step.ok:
        return body_step
    ExprStep{value: LetIn(name, val_step.value, body_step.value), next: body_step.next, ok: true, error: ""}

# `[ e, e, e ]` list literal. Empty `[]` is allowed.
define parse_list_literal(tokens: [Token], start: number, n: number) -> ExprStep:
    edit i = skip_newlines(tokens, start, n)
    edit items = []
    if match_tok(tokens, i, n, "RBracket"):
        return ExprStep{value: LitList([]), next: i + 1, ok: true, error: ""}
    loop:
        item = parse_expr(tokens, i, n)
        if not item.ok:
            return item
        items = append(items, item.value)
        i = item.next
        i = skip_newlines(tokens, i, n)
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
            i = skip_newlines(tokens, i, n)
        else:
            break
    if not match_tok(tokens, i, n, "RBracket"):
        return ExprStep{value: LitList(items), next: i, ok: false, error: "expected `]` to close list literal"}
    ExprStep{value: LitList(items), next: i + 1, ok: true, error: ""}

# `{ f: v, f: v }` map literal — same field syntax as emit/spawn but as
# an expression value. Empty `{}` makes an empty MapV.
define parse_map_literal(tokens: [Token], start: number, n: number) -> ExprStep:
    edit i = skip_newlines(tokens, start, n)
    edit fields = []
    if match_tok(tokens, i, n, "RBrace"):
        return ExprStep{value: MapLit([]), next: i + 1, ok: true, error: ""}
    loop:
        f_step = parse_map_field(tokens, i, n)
        if not f_step.ok:
            return ExprStep{value: MapLit(fields), next: f_step.next, ok: false, error: f_step.error}
        fields = append(fields, f_step.field)
        i = f_step.next
        i = skip_newlines(tokens, i, n)
        if match_tok(tokens, i, n, "Comma"):
            i = i + 1
            i = skip_newlines(tokens, i, n)
        else:
            break
    if not match_tok(tokens, i, n, "RBrace"):
        return ExprStep{value: MapLit(fields), next: i, ok: false, error: "expected RBrace to close map literal"}
    ExprStep{value: MapLit(fields), next: i + 1, ok: true, error: ""}

# After `if`, parse: cond `then` then_expr `else` else_expr.
# Newlines/indent between `then EXPR` and `else` are permitted so fn
# bodies can use the layout.astra style:
#   if cond then A
#   else
#       B
define parse_if_expr(tokens: [Token], start: number, n: number) -> ExprStep:
    cond = parse_expr(tokens, start, n)
    if not cond.ok:
        return cond
    cond_next = skip_newlines(tokens, cond.next, n)
    if not match_tok(tokens, cond_next, n, "Then"):
        return ExprStep{value: cond.value, next: cond_next, ok: false, error: "expected `then`"}
    then_step = parse_expr(tokens, cond_next + 1, n)
    if not then_step.ok:
        return then_step
    then_next = skip_newlines(tokens, then_step.next, n)
    if not match_tok(tokens, then_next, n, "Else"):
        return ExprStep{value: then_step.value, next: then_next, ok: false, error: "expected `else`"}
    else_start = skip_newlines(tokens, then_next + 1, n)
    else_step = parse_expr(tokens, else_start, n)
    if not else_step.ok:
        return else_step
    ExprStep{value: IfExpr(cond.value, then_step.value, else_step.value), next: else_step.next, ok: true, error: ""}

# ---- token-matching helpers (string-based to avoid match-everywhere) ----

define empty_rule() -> Rule:
    Rule{name: "", params: [], body: [], trigger: "", condition: LitBool(true)}

# ---- Substitution: replace VarRef(name) → LitInt(value) throughout
# an Expr/Stmt/Rule tree. Used by `for IDENT in N until M: body` expansion
# to clone the body M-N times with the loop var pinned to each value.

define subst_expr(e: Expr, name: text, value: number) -> Expr:
    choose e:
        LitInt(_) then e
        LitText(_) then e
        LitBool(_) then e
        VarRef(n) then if n is name then LitInt(value) else VarRef(n)
        Binop(op, a, b) then Binop(op, subst_expr(a, name, value), subst_expr(b, name, value))
        Unop(op, x) then Unop(op, subst_expr(x, name, value))
        IfExpr(c, t, e2) then IfExpr(subst_expr(c, name, value), subst_expr(t, name, value), subst_expr(e2, name, value))
        Call(n, args) then Call(n, subst_args(args, name, value, 0, []))
        Field(b, n) then Field(subst_expr(b, name, value), n)
        CountQuery(iter_n, le, ce) then subst_count(iter_n, le, ce, name, value)
        LetIn(let_n, ve, be) then subst_let_in(let_n, ve, be, name, value)
        LitList(items) then LitList(subst_args(items, name, value, 0, []))
        MapLit(fields) then MapLit(subst_fields(fields, name, value, 0, []))
        RangeExpr(a, b) then RangeExpr(subst_expr(a, name, value), subst_expr(b, name, value))
        MatchExpr(s, arms) then MatchExpr(subst_expr(s, name, value), subst_match_arms(arms, name, value, 0, []))

define subst_match_arms(arms: [MatchArm], name: text, value: number, i: number, acc: [MatchArm]) -> [MatchArm]:
    if i >= length(arms):
        acc
    else:
        a = arms[i]
        subst_match_arms(arms, name, value, i + 1, append(acc, MatchArm{pattern: a.pattern, body: subst_expr(a.body, name, value)}))

define subst_let_in(let_n: text, ve: Expr, be: Expr, name: text, value: number) -> Expr:
    new_ve = subst_expr(ve, name, value)
    new_be = if let_n is name then be else subst_expr(be, name, value)
    LetIn(let_n, new_ve, new_be)

# CountQuery's iter binding shadows an outer name — if the loop var and
# the count iter share a name, the count iter wins inside the predicate
# (but the list-source still binds against the outer scope).
define subst_count(iter_n: text, le: Expr, ce: Expr, name: text, value: number) -> Expr:
    new_le = subst_expr(le, name, value)
    new_ce = if iter_n is name then ce else subst_expr(ce, name, value)
    CountQuery(iter_n, new_le, new_ce)

define subst_args(args: [Expr], name: text, value: number, i: number, acc: [Expr]) -> [Expr]:
    if i >= length(args):
        acc
    else:
        subst_args(args, name, value, i + 1, append(acc, subst_expr(args[i], name, value)))

define subst_stmt(s: Stmt, name: text, value: number) -> Stmt:
    choose s:
        EmitEffect(event, fields) then EmitEffect(event, subst_fields(fields, name, value, 0, []))
        Require(cond) then Require(subst_expr(cond, name, value))
        Let(n, ve) then Let(n, subst_expr(ve, name, value))
        LetDestructure(ns, ve) then LetDestructure(ns, subst_expr(ve, name, value))
        SpawnEntity(kind, fields) then SpawnEntity(kind, subst_fields(fields, name, value, 0, []))
        DestroyEntity(target) then DestroyEntity(subst_expr(target, name, value))
        SetVar(n, ve) then SetVar(n, subst_expr(ve, name, value))
        SetField(base, fn_, ve) then SetField(subst_expr(base, name, value), fn_, subst_expr(ve, name, value))
        ForEach(iter_n, le, filt, body) then subst_foreach(iter_n, le, filt, body, name, value)
        IfStmt(c, body) then IfStmt(subst_expr(c, name, value), subst_stmts(body, name, value, 0, []))
        RelateStmt(a, kind, b) then RelateStmt(subst_expr(a, name, value), kind, subst_expr(b, name, value))

define subst_foreach(iter_n: text, le: Expr, filt: Expr, body: [Stmt], name: text, value: number) -> Stmt:
    new_le = subst_expr(le, name, value)
    if iter_n is name:
        ForEach(iter_n, new_le, filt, body)
    else:
        ForEach(iter_n, new_le, subst_expr(filt, name, value), subst_stmts(body, name, value, 0, []))

define subst_fields(fields: [FieldExpr], name: text, value: number, i: number, acc: [FieldExpr]) -> [FieldExpr]:
    if i >= length(fields):
        acc
    else:
        f = fields[i]
        subst_fields(fields, name, value, i + 1, append(acc, FieldExpr{name: f.name, value: subst_expr(f.value, name, value)}))

define subst_stmts(stmts: [Stmt], name: text, value: number, i: number, acc: [Stmt]) -> [Stmt]:
    if i >= length(stmts):
        acc
    else:
        subst_stmts(stmts, name, value, i + 1, append(acc, subst_stmt(stmts[i], name, value)))

define subst_rule(r: Rule, name: text, value: number) -> Rule:
    Rule{name: r.name, params: r.params, body: subst_stmts(r.body, name, value, 0, []), trigger: r.trigger, condition: subst_expr(r.condition, name, value)}

define newline_token() -> Token:
    Token{tok: Newline, line: 0, col: 0}

define is_newline(t: Tok) -> truth:
    choose t:
        Newline then true
        _ then false

# Compare current token against a kind name. We dispatch by short string
# because Orion match on tagged enums with no payload is verbose to write
# inline. Returns true when token at i is the expected variant.
define match_tok(tokens: [Token], i: number, n: number, kind: text) -> truth:
    if i >= n:
        false
    else:
        tok_kind(tokens[i].tok) is kind

# Map every Tok variant to a short string tag.
define tok_kind(t: Tok) -> text:
    choose t:
        Int(_) then "Int"
        Str(_) then "Str"
        Ident(_) then "Ident"
        Rule then "Rule"
        Record then "Record"
        RequireKw then "Require"
        UseKw then "Use"
        LetKw then "Let"
        Set then "Set"
        SpawnKw then "Spawn"
        Destroy then "Destroy"
        Emit then "Emit"
        Effect then "Effect"
        On then "On"
        View then "View"
        Entity then "Entity"
        Test then "Test"
        Apply then "Apply"
        Expect then "Expect"
        Tick then "Tick"
        If then "If"
        Then then "Then"
        Else then "Else"
        Match then "Match"
        For then "For"
        Count then "Count"
        All then "All"
        In then "In"
        Where then "Where"
        True then "True"
        False then "False"
