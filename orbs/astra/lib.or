# astra - a small typed host-agnostic scripting language.
#
# One dependency for a host: this orb re-exports the whole language.
# A rule is a pure fn from args -> Outcome (the effects it proposes
# + the reads it made). A tree is the same shape over widgets.
# The core does lex/check/eval; everything it can't (read the world,
# resolve a bundle) it asks a host through `astra_host`.
#
# Atlas embeds this as `atlas_astra`, mapping Value <-> atlas_wire.

public use astra_value
public use astra_outcome
public use astra_lexer
public use astra_ast
public use astra_parser
public use astra_check
public use astra_eval
public use astra_host
public use astra_run
public use astra_bundle

public define version() -> text = "0.1.0"
