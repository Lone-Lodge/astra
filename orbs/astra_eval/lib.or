# astra_eval — walk a Rule's body, produce an Outcome.
#
# M1+M2 features: require / let / emit statements; expressions with
# binops / unops / if-then-else / field access / function calls.
# Helper `fn` definitions are resolved via the `funcs` table threaded
# through every evaluator entry point.

# Frame-arena hooks (no-op builtins under the interpreter). pub so
# games sharing the arena resolve the same declarations.
public external define orion_arena_on() -> int
public external define orion_arena_off() -> int
public external define orion_arena_reset() -> int
public external define orion_arena_used() -> int
public external define orion_arena_rewind(mark: int) -> int
public external define orion_persist_on() -> int
public external define orion_persist_off() -> int


# Helper data — name+value pair for the environment.
public type Binding: name: text, value: Value

# A failed `require` aborts the rule with an empty outcome.
public type EvalState: env: [Binding], effects: [AstraEffect], refused: truth

# Run a rule body against positional args. `funcs` is the table of pure
# helpers `Call(name, args)` expressions can dispatch to — pass [] when
# none are defined.
public define run_rule(r: Rule, args: [Value], funcs: [Function]) -> Outcome:
    env = bind_params(r.params, args, 0, [])
    if rule_gate_open(r, env, funcs) then run_rule_env(r, env, funcs) else empty_outcome()

# Run a rule with both positional params AND a ctx-binding list. ctx
# binds host-supplied free names (e.g. `tray`, `blocks`); params come
# in after so they shadow ctx on name collision.
public define run_rule_args_ctx(r: Rule, args: [Value], ctx: [Binding], funcs: [Function]) -> Outcome:
    env = bind_args_into(r.params, args, 0, ctx)
    if rule_gate_open(r, env, funcs) then run_rule_env(r, env, funcs) else empty_outcome()

# Observer run condition: `on X(...) when EXPR:` stores EXPR in
# r.condition. Parser defaults condition to LitBool(true) for guardless
# handlers — the equality check below short-circuits the eval so the
# common (no-guard) path pays nothing.
define rule_gate_open(r: Rule, env: [Binding], funcs: [Function]) -> truth:
    choose r.condition:
        LitBool(b) then b
        _ then value_is_truthy(eval_expr(r.condition, env, funcs))

define empty_outcome() -> Outcome:
    Outcome{effects: [], reads: []}

define bind_args_into(params: [Param], args: [Value], i: number, acc: [Binding]) -> [Binding]:
    if i >= length(params):
        acc
    else:
        p = params[i]
        v = if i < length(args) then args[i] else NoneV
        bind_args_into(params, args, i + 1, append(acc, Binding{name: p.name, value: v}))

# Same as `run_rule` but the caller supplies the env directly. Used
# by `astra_run::tick` to inject world-state bindings into `when` rules
# whose body references free names (e.g. `score`, `hp`) instead of
# positional params.
# The whole body evals inside the frame arena (same depth counter as
# eval_call, so nested fn calls take the cheap rewind path); only the
# outcome is evacuated. Effects/env garbage never reaches the heap.
public define run_rule_env(r: Rule, env: [Binding], funcs: [Function]) -> Outcome:
    d = if slot_has("astra:call_depth") then slot_get_number("astra:call_depth") else 0
    slot_set("astra:call_depth", d + 1)
    if d is 0:
        orion_arena_reset()
        orion_arena_on()
    result = eval_rule_body(r, env, funcs)
    slot_set("astra:call_depth", d)
    if d is 0:
        orion_arena_off()
        orion_persist_on()
        out = outcome_copy(result)
        orion_persist_off()
        orion_arena_reset()
        out
    else:
        result

# Evaluate an arbitrary expression in `env`. The reactive runtime uses
# this to test a `when` rule's `condition` *before* deciding whether to
# fire the body, so a false condition doesn't waste work or accidentally
# emit effects via partial body evaluation.
public define eval_in_env(e: Expr, env: [Binding], funcs: [Function]) -> Value:
    eval_expr(e, env, funcs)

# Truthiness check exposed for the runtime — same semantics as the
# internal `is_truthy` (BoolV → b, IntV → is not 0, TextV → non-empty,
# RefV → true, NoneV → false).
public define value_is_truthy(v: Value) -> truth:
    is_truthy(v)

define bind_params(params: [Param], args: [Value], i: number, acc: [Binding]) -> [Binding]:
    if i >= length(params):
        acc
    else:
        p = params[i]
        v = if i < length(args) then args[i] else NoneV
        bind_params(params, args, i + 1, append(acc, Binding{name: p.name, value: v}))

define eval_rule_body(r: Rule, env: [Binding], funcs: [Function]) -> Outcome:
    edit state = EvalState{env: env, effects: [], refused: false}
    loop stmt in r.body:
        if not state.refused:
            state = step_stmt(stmt, state, funcs)
    state_outcome(state)

define state_outcome(state: EvalState) -> Outcome:
    if state.refused:
        empty()
    else:
        Outcome{effects: state.effects, reads: []}

# Scalar payloads land in registers via the match binding, so re-boxing
# after the rewind is safe; aggregates keep their arena block untouched.
define rewind_scalar(r: Value, mark: number) -> Value:
    choose r:
        IntV(n) then rewound_int(n, mark)
        BoolV(b) then rewound_bool(b, mark)
        RefV(x) then rewound_ref(x, mark)
        _ then r

define rewound_int(n: number, mark: number) -> Value:
    orion_arena_rewind(mark)
    IntV(n)

define rewound_bool(b: truth, mark: number) -> Value:
    orion_arena_rewind(mark)
    BoolV(b)

define rewound_ref(x: number, mark: number) -> Value:
    orion_arena_rewind(mark)
    RefV(x)

public external define octr_add(i: int, n: int)

# Backward scan: params/lets sit at the end, so shadowing is "last
# wins" — first hit from the back, usually within a couple of probes.
define lookup(env: [Binding], name: text) -> Value:
    edit found = NoneV
    edit i = length(env) - 1
    loop:
        if i < 0:
            break
        b = env[i]
        if b.name is name:
            found = b.value
            break
        i = i - 1
    found

define lookup_func(funcs: [Function], name: text) -> Function:
    edit found = empty_func()
    edit i = length(funcs) - 1
    loop:
        if i < 0:
            break
        f = funcs[i]
        if f.name is name:
            found = f
            break
        i = i - 1
    found

define empty_func() -> Function:
    Function{name: "", params: [], return_type: "", body: LitInt(0)}

define step_stmt(s: Stmt, state: EvalState, funcs: [Function]) -> EvalState:
    choose s:
        EmitEffect(event, fields) then EvalState{env: state.env, effects: append(state.effects, emit_to_effect(event, fields, state.env, funcs)), refused: false}
        Require(cond) then apply_require(cond, state, funcs)
        Let(name, value_expr) then EvalState{env: append(state.env, Binding{name: name, value: eval_expr(value_expr, state.env, funcs)}), effects: state.effects, refused: false}
        LetDestructure(names, value_expr) then apply_let_destructure(names, eval_expr(value_expr, state.env, funcs), state)
        SpawnEntity(kind, fields) then EvalState{env: state.env, effects: append(state.effects, spawn_to_effect(kind, fields, state.env, funcs)), refused: false}
        DestroyEntity(target) then EvalState{env: state.env, effects: append(state.effects, destroy_to_effect(target, state.env, funcs)), refused: false}
        SetVar(name, value_expr) then EvalState{env: state.env, effects: append(state.effects, AstraSetVar(name, eval_expr(value_expr, state.env, funcs))), refused: false}
        SetField(base, field_name, value_expr) then EvalState{env: state.env, effects: append(state.effects, set_field_to_effect(base, field_name, value_expr, state.env, funcs)), refused: false}
        ForEach(iter_name, list_expr, filter_expr, body) then apply_foreach(iter_name, list_expr, filter_expr, body, state, funcs)
        IfStmt(cond, body) then apply_if_stmt(cond, body, state, funcs)
        RelateStmt(a, kind, b) then apply_relate(a, kind, b, state, funcs)

# `relate A kind B` -> an AstraRelate effect (source/target eval to
# entity ids). The host maps it to atlas Relate; the relation is then
# queryable via related_to/from (A3 create side).
define apply_relate(a: Expr, kind: text, b: Expr, state: EvalState, funcs: [Function]) -> EvalState:
    av = as_int(eval_expr(a, state.env, funcs))
    bv = as_int(eval_expr(b, state.env, funcs))
    EvalState{env: state.env, effects: append(state.effects, AstraRelate(av, kind, bv)), refused: false}

define apply_if_stmt(cond: Expr, body: [Stmt], state: EvalState, funcs: [Function]) -> EvalState:
    if is_truthy(eval_expr(cond, state.env, funcs)):
        run_body_stmts(body, state, funcs, 0)
    else:
        state

define apply_foreach(iter_name: text, list_expr: Expr, filter_expr: Expr, body: [Stmt], state: EvalState, funcs: [Function]) -> EvalState:
    src = eval_expr(list_expr, state.env, funcs)
    choose src:
        ListV(items) then foreach_items(iter_name, items, filter_expr, body, state, funcs, 0)
        _ then state

define foreach_items(iter_name: text, items: [Value], filter_expr: Expr, body: [Stmt], state: EvalState, funcs: [Function], i: number) -> EvalState:
    if i >= length(items) or state.refused:
        state
    else:
        item = items[i]
        iter_env = append(state.env, Binding{name: iter_name, value: item})
        passes = is_truthy(eval_expr(filter_expr, iter_env, funcs))
        if passes:
            iter_state = EvalState{env: iter_env, effects: state.effects, refused: state.refused}
            after_body = run_body_stmts(body, iter_state, funcs, 0)
            next_state = EvalState{env: state.env, effects: after_body.effects, refused: after_body.refused}
            foreach_items(iter_name, items, filter_expr, body, next_state, funcs, i + 1)
        else:
            foreach_items(iter_name, items, filter_expr, body, state, funcs, i + 1)

define run_body_stmts(body: [Stmt], state: EvalState, funcs: [Function], i: number) -> EvalState:
    if i >= length(body) or state.refused:
        state
    else:
        run_body_stmts(body, step_stmt(body[i], state, funcs), funcs, i + 1)

define apply_let_destructure(names: [text], src: Value, state: EvalState) -> EvalState:
    edit env = state.env
    loop name in names:
        env = append(env, Binding{name: name, value: eval_field(src, name)})
    EvalState{env: env, effects: state.effects, refused: false}

define apply_require(cond: Expr, state: EvalState, funcs: [Function]) -> EvalState:
    v = eval_expr(cond, state.env, funcs)
    if is_truthy(v):
        state
    else:
        EvalState{env: state.env, effects: [], refused: true}

define is_truthy(v: Value) -> truth:
    choose v:
        BoolV(b) then b
        IntV(n) then n is not 0
        TextV(s) then length(s) > 0
        RefV(_) then true
        MapV(entries) then length(entries) > 0
        ListV(items) then length(items) > 0
        NoneV then false

define emit_to_effect(event: text, fields: [FieldExpr], env: [Binding], funcs: [Function]) -> AstraEffect:
    n = length(fields)
    if n is 0:
        AstraEmit(event, NoneV)
    else:
        edit entries = []
        loop f in fields:
            entries = append(entries, ValueField{name: f.name, value: eval_expr(f.value, env, funcs)})
        AstraEmit(event, MapV(entries))

define spawn_to_effect(kind: text, fields: [FieldExpr], env: [Binding], funcs: [Function]) -> AstraEffect:
    edit entries = []
    loop f in fields:
        v = eval_expr(f.value, env, funcs)
        # A field that evaluates to NOTHING (e.g. `hint: cmd.hint` where the
        # data row has no hint) is simply left unset — the component takes
        # its type default. Skipping it keeps optional data-driven fields
        # crash-proof: without this, NoneV reached spawn_effect's text concat
        # as a bad pointer and faulted.
        if not is_none_value(v):
            entries = append(entries, ValueField{name: f.name, value: v})
    AstraSpawnKind(kind, entries)

define is_none_value(v: Value) -> truth:
    choose v:
        NoneV then true
        _ then false

define destroy_to_effect(target: Expr, env: [Binding], funcs: [Function]) -> AstraEffect:
    v = eval_expr(target, env, funcs)
    choose v:
        RefV(id) then AstraDestroy(id)
        IntV(id) then AstraDestroy(id)
        _ then AstraDestroy(0 - 1)

define set_field_to_effect(base: Expr, field_name: text, value_expr: Expr, env: [Binding], funcs: [Function]) -> AstraEffect:
    base_v = eval_expr(base, env, funcs)
    value = eval_expr(value_expr, env, funcs)
    choose base_v:
        RefV(id) then AstraSet(id, field_name, value)
        IntV(id) then AstraSet(id, field_name, value)
        _ then AstraSet(0 - 1, field_name, value)

define eval_expr(e: Expr, env: [Binding], funcs: [Function]) -> Value:
    choose e:
        LitInt(n) then IntV(n)
        LitText(s) then TextV(s)
        LitBool(b) then BoolV(b)
        VarRef(name) then lookup(env, name)
        Binop(op, a, b) then eval_binop_lazy(op, a, b, env, funcs)
        Unop(op, x) then eval_unop(op, eval_expr(x, env, funcs))
        IfExpr(c, t, e2) then if is_truthy(eval_expr(c, env, funcs)) then eval_expr(t, env, funcs) else eval_expr(e2, env, funcs)
        Call(name, args) then eval_call(name, args, env, funcs)
        Field(base, name) then eval_field(eval_expr(base, env, funcs), name)
        CountQuery(iter_name, list_expr, cond_expr) then eval_count(iter_name, list_expr, cond_expr, env, funcs)
        LetIn(name, val_expr, body_expr) then eval_expr(body_expr, append(env, Binding{name: name, value: eval_expr(val_expr, env, funcs)}), funcs)
        LitList(items) then ListV(eval_args(items, env, funcs, 0, []))
        MapLit(fields) then MapV(eval_map_fields(fields, env, funcs, 0, []))
        RangeExpr(a, b) then ListV(build_range(as_int(eval_expr(a, env, funcs)), as_int(eval_expr(b, env, funcs)), []))
        MatchExpr(scrut, arms) then eval_match(scrut, arms, env, funcs)

define eval_match(scrut: Expr, arms: [MatchArm], env: [Binding], funcs: [Function]) -> Value:
    target = eval_expr(scrut, env, funcs)
    pick_match_arm(arms, target, env, funcs, 0)

define pick_match_arm(arms: [MatchArm], target: Value, env: [Binding], funcs: [Function], i: number) -> Value:
    if i >= length(arms):
        NoneV
    else:
        arm = arms[i]
        if arm_matches(arm.pattern, target, env, funcs):
            eval_expr(arm.body, env, funcs)
        else:
            pick_match_arm(arms, target, env, funcs, i + 1)

define arm_matches(pattern: Expr, target: Value, env: [Binding], funcs: [Function]) -> truth:
    choose pattern:
        VarRef(name) then name is "_"
        _ then values_equal(eval_expr(pattern, env, funcs), target)

define values_equal(a: Value, b: Value) -> truth:
    if is_text_value(a) or is_text_value(b):
        text_of_value(a) is text_of_value(b)
    else:
        as_int(a) is as_int(b)

# Look up `name` in the function table, bind evaluated args to its
# params, evaluate its body in the resulting env. Unknown names return
# NoneV — keeps the language graceful when a rule references a helper
# that hasn't been defined yet (e.g. during hot-reload mid-edit).
define eval_call(name: text, args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if name is "size":
        eval_builtin_size_of(args, env, funcs)
    else:
        if name is "at":
            eval_builtin_at(args, env, funcs)
        else:
            if name is "concat":
                eval_builtin_concat(args, env, funcs)
            else:
              if name is "related":
                eval_builtin_related(args, env, funcs)
              else:
               if name is "related_from":
                eval_builtin_related_from(args, env, funcs)
               else:
                if name is "entities_of_trait":
                  eval_builtin_entities_of_trait(args, env, funcs)
                else:
                 if name is "entity_field":
                  eval_builtin_entity_field(args, env, funcs)
                 else:
                  if name is "__hole":
                   eval_hole(args, env, funcs)
                  else:
                   eval_user_call(name, args, env, funcs)

# A string-interpolation hole: `__hole(expr, "{raw}")`. Yields the hole's
# value coerced to text if `expr` resolves, else the literal `{raw}` so an
# interpolation over a not-yet-seeded resource survives to render-time
# expansion (expand_widget_text) instead of baking empty at spawn.
define eval_hole(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) is 0:
        TextV("")
    else:
        v = eval_expr(args[0], env, funcs)
        choose v:
            NoneV then if length(args) > 1 then eval_expr(args[1], env, funcs) else TextV("")
            _ then TextV(text_coerce(v))

# Helper fn call — extracted so the builtin ladder above stays flat.
# Helper fns are pure: everything a call allocates is garbage except
# its result. Calls run in the frame arena as an obstack — each call
# saves a watermark, scalar results are re-boxed after rewinding to it.
# The top-level call evacuates by deep copy and resets.
define eval_user_call(name: text, args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    f = lookup_func(funcs, name)
    if f.name is "":
        NoneV
    else:
        d = if slot_has("astra:call_depth") then slot_get_number("astra:call_depth") else 0
        slot_set("astra:call_depth", d + 1)
        if d is 0:
            orion_arena_reset()
            orion_arena_on()
        mark = orion_arena_used()
        evaluated = eval_args(args, env, funcs, 0, [])
        call_env = bind_params(f.params, evaluated, 0, env)
        r = eval_expr(f.body, call_env, funcs)
        slot_set("astra:call_depth", d)
        if d is 0:
            orion_arena_off()
            orion_persist_on()
            rc = value_copy(r)
            orion_persist_off()
            orion_arena_reset()
            rc
        else:
            rewind_scalar(r, mark)

define eval_builtin_at(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) < 2:
        NoneV
    else:
        list_v = eval_expr(args[0], env, funcs)
        i = as_int(eval_expr(args[1], env, funcs))
        choose list_v:
            ListV(items) then if i >= 0 and i < length(items) then items[i] else NoneV
            _ then NoneV

# `related(source, kind)` -> [targets] — the relation query (A3). eval
# stays host-agnostic: the host injects the relation index as a `__rel`
# MapV ctx binding (keys "src:kind"), and this looks up the target list.
# Missing -> empty list, so `count(x in related(npc, "hates"))` works
# even when the entity has no such relation.
define eval_builtin_related(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) < 2:
        ListV([])
    else:
        src = as_int(eval_expr(args[0], env, funcs))
        kind = text_of_value(eval_expr(args[1], env, funcs))
        related_lookup(lookup(env, "__rel"), "{src}:{kind}")

# `entities_of_trait(name)` -> [int] — all entity ids of every type
# that `uses NAME` as a trait. Reads the __trait_index ctx binding
# populated by the host (atlas). Empty when the index isn't wired or
# no matching entities exist.
define eval_builtin_entities_of_trait(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) < 1:
        ListV([])
    else:
        trait_name = text_of_value(eval_expr(args[0], env, funcs))
        related_lookup(lookup(env, "__trait_index"), trait_name)

# `entity_field(eid, field_name)` -> Value — read one field off an
# entity regardless of its component type. The host resolves via the
# __ent_fields ctx binding: MapV keyed by "{eid}:{field}". Missing =
# NoneV. Used with entities_of_trait to iterate cross-type queries.
define eval_builtin_entity_field(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) < 2:
        NoneV
    else:
        eid = as_int(eval_expr(args[0], env, funcs))
        field_name = text_of_value(eval_expr(args[1], env, funcs))
        entity_field_lookup(lookup(env, "__ent_fields"), "{eid}:{field_name}")

define entity_field_lookup(idx: Value, key: text) -> Value:
    choose idx:
        MapV(entries) then lookup_field(entries, key)
        _ then NoneV

# `related_from(target, kind)` -> [sources] — the reverse relation query.
# Reads the __rel_rev ctx binding (keys "target:kind"), symmetric to
# `related()`. Bevy's #9 idea: an auto-mirrored index maintained by
# atlas (do_relate/do_unrelate write both fwd and rev) — a graph
# integrity guarantee no user code has to enforce.
define eval_builtin_related_from(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) < 2:
        ListV([])
    else:
        target = as_int(eval_expr(args[0], env, funcs))
        kind = text_of_value(eval_expr(args[1], env, funcs))
        related_lookup(lookup(env, "__rel_rev"), "{target}:{kind}")

define related_lookup(rel_val: Value, key: text) -> Value:
    choose rel_val:
        MapV(entries) then field_list_or_empty(entries, key)
        _ then ListV([])

define field_list_or_empty(entries: [ValueField], key: text) -> Value:
    choose lookup_field(entries, key):
        ListV(xs) then ListV(xs)
        _ then ListV([])

define eval_builtin_concat(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) < 2:
        ListV([])
    else:
        a_v = eval_expr(args[0], env, funcs)
        b_v = eval_expr(args[1], env, funcs)
        choose a_v:
            ListV(a_items) then concat_list(a_items, b_v)
            _ then b_v

define concat_list(a_items: [Value], b: Value) -> Value:
    choose b:
        ListV(b_items) then ListV(concat_items(a_items, b_items, 0, a_items))
        _ then ListV(a_items)

define concat_items(a: [Value], b: [Value], i: number, acc: [Value]) -> [Value]:
    if i >= length(b):
        acc
    else:
        concat_items(a, b, i + 1, append(acc, b[i]))

define build_range(i: number, finish: number, acc: [Value]) -> [Value]:
    if i >= finish:
        acc
    else:
        build_range(i + 1, finish, append(acc, IntV(i)))

define eval_builtin_size_of(args: [Expr], env: [Binding], funcs: [Function]) -> Value:
    if length(args) is 0:
        IntV(0)
    else:
        v = eval_expr(args[0], env, funcs)
        choose v:
            ListV(items) then IntV(length(items))
            MapV(entries) then IntV(length(entries))
            TextV(s) then IntV(length(s))
            _ then IntV(0)

define eval_args(args: [Expr], env: [Binding], funcs: [Function], i: number, acc: [Value]) -> [Value]:
    if i >= length(args):
        acc
    else:
        eval_args(args, env, funcs, i + 1, append(acc, eval_expr(args[i], env, funcs)))

define eval_map_fields(fields: [FieldExpr], env: [Binding], funcs: [Function], i: number, acc: [ValueField]) -> [ValueField]:
    if i >= length(fields):
        acc
    else:
        f = fields[i]
        eval_map_fields(fields, env, funcs, i + 1, append(acc, ValueField{name: f.name, value: eval_expr(f.value, env, funcs)}))

# Field access — `b.col` against a MapV walks its entries for a matching
# name. Non-MapV bases are NoneV (silent miss, consistent with VarRef on
# unknown names — the language stays graceful under hot-reload).
define eval_field(base: Value, name: text) -> Value:
    choose base:
        MapV(entries) then lookup_field(entries, name)
        _ then NoneV

define lookup_field(entries: [ValueField], name: text) -> Value:
    n = length(entries)
    edit found = NoneV
    loop i in 0 until n:
        f = entries[i]
        if f.name is name:
            found = f.value
    found

# Iterate a ListV, bind each element to `iter_name` in env, evaluate
# `cond_expr`, count truthy results. Returns IntV(count). Non-list source
# evaluates as 0 — same gracefulness as Field on a non-MapV.
define eval_count(iter_name: text, list_expr: Expr, cond_expr: Expr, env: [Binding], funcs: [Function]) -> Value:
    src = eval_expr(list_expr, env, funcs)
    choose src:
        ListV(items) then IntV(count_matching(iter_name, items, cond_expr, env, funcs, 0, 0))
        _ then IntV(0)

# Hot path — one env slot is reused across elements (set, not push).
# A fresh env copy per element made count-heavy scripts allocate tens
# of MB per tick (gamestate: 58MB -> negligible).
define count_matching(iter_name: text, items: [Value], cond_expr: Expr, env: [Binding], funcs: [Function], i: number, acc: number) -> number:
    n = length(items)
    edit iter_env = append(env, Binding{name: iter_name, value: NoneV})
    slot = length(iter_env) - 1
    edit total = acc
    edit j = i
    loop:
        if j >= n:
            break
        iter_env = set(iter_env, slot, Binding{name: iter_name, value: items[j]})
        if is_truthy(eval_expr(cond_expr, iter_env, funcs)):
            total = total + 1
        j = j + 1
    total

# and/or SHORT-CIRCUIT: a false guard means the heavy right side is
# never evaluated. `when board_dirty is 1 and expensive(...)` costs
# one int compare on quiet passes — without this every when-rule
# paid its full worst case every sims pass.
define eval_binop_lazy(op: text, a: Expr, b: Expr, env: [Binding], funcs: [Function]) -> Value:
    if op is "and":
        if is_truthy(eval_expr(a, env, funcs)):
            BoolV(is_truthy(eval_expr(b, env, funcs)))
        else:
            BoolV(false)
    else:
        if op is "or":
            if is_truthy(eval_expr(a, env, funcs)):
                BoolV(true)
            else:
                BoolV(is_truthy(eval_expr(b, env, funcs)))
        else:
            eval_binop(op, eval_expr(a, env, funcs), eval_expr(b, env, funcs))

define eval_binop(op: text, a: Value, b: Value) -> Value:
    if op is "and":
        BoolV(is_truthy(a) and is_truthy(b))
    else:
        if op is "or":
            BoolV(is_truthy(a) or is_truthy(b))
        else:
            # `+` concatenates when either side is text: "wood: " + count
            # is the workhorse of a text-first game (A Dark Room). The
            # non-text side coerces to its printed form so scripts never
            # need an explicit to_text. Numeric `+` still routes below.
            if op is "+" and (is_text_value(a) or is_text_value(b)):
                TextV(text_coerce(a) + text_coerce(b))
            else:
                if (op is "==" or op is "!=") and (is_text_value(a) or is_text_value(b)):
                    eq = text_of_value(a) is text_of_value(b)
                    if op is "==" then BoolV(eq) else BoolV(not eq)
                else:
                    eval_binop_numeric(op, a, b)

define is_text_value(v: Value) -> truth:
    choose v:
        TextV(_) then true
        _ then false

define text_of_value(v: Value) -> text:
    choose v:
        TextV(s) then s
        _ then ""

# Printed form of any scalar for text concatenation. Int/Ref render as
# digits, Bool as true/false, absence as empty — the same shapes an
# interpolation would produce.
define text_coerce(v: Value) -> text:
    choose v:
        TextV(s) then s
        IntV(n) then "{n}"
        BoolV(b) then if b then "true" else "false"
        RefV(r) then "{r}"
        _ then ""

define eval_binop_numeric(op: text, a: Value, b: Value) -> Value:
    ai = as_int(a)
    bi = as_int(b)
    if op is "+" then IntV(ai + bi)
    else if op is "-" then IntV(ai - bi)
    else if op is "*" then IntV(ai * bi)
    else if op is "/" then IntV(if bi is 0 then 0 else ai // bi)
    else if op is "%" then IntV(if bi is 0 then 0 else ai - (ai // bi) * bi)
    else if op is "==" then BoolV(ai is bi)
    else if op is "!=" then BoolV(ai is not bi)
    else if op is "<" then BoolV(ai < bi)
    else if op is "<=" then BoolV(ai <= bi)
    else if op is ">" then BoolV(ai > bi)
    else if op is ">=" then BoolV(ai >= bi)
    else NoneV

define eval_unop(op: text, v: Value) -> Value:
    if op is "not":
        BoolV(not is_truthy(v))
    else:
        if op is "-":
            IntV(0 - as_int(v))
        else:
            NoneV

define as_int(v: Value) -> number:
    choose v:
        IntV(n) then n
        BoolV(b) then if b then 1 else 0
        TextV(_) then 0
        RefV(id) then id
        MapV(_) then 0
        ListV(items) then length(items)
        NoneV then 0
