# astra_eval — walk a Rule's body, produce an Outcome.
#
# MVP scope matches the parser: rule body of `emit Event { field: expr }`
# statements. Expressions are literals + VarRef (param lookup). The
# evaluator binds params positionally from `args`, then walks each stmt
# and accumulates effects.

use astra_ast
use astra_outcome
use astra_value

# Run a rule body against positional args. Returns an Outcome whose
# `effects` is the list of proposed effects in source order.
pub fn run_rule(r: Rule, args: [Value]) -> Outcome:
    env = bind_params(r.params, args, 0, [])
    mut effects = []
    for stmt in r.body:
        effects = push(effects, eval_stmt(stmt, env))
    Outcome{effects: effects, reads: []}

# Bind positional args to param names — env is [(name, value)].
fn bind_params(params: [Param], args: [Value], i: int, acc: [Binding]) -> [Binding]:
    if i >= len(params):
        acc
    else:
        p = at(params, i)
        v = if i < len(args) then at(args, i) else NoneV
        bind_params(params, args, i + 1, push(acc, Binding{name: p.name, value: v}))

# Lookup binding by name, return NoneV if absent.
fn lookup(env: [Binding], name: Text) -> Value:
    n = len(env)
    mut found = NoneV
    for i in 0..<n:
        b = at(env, i)
        if b.name == name:
            found = b.value
    found

# Evaluate one statement → Effect. (MVP: only EmitEffect → Emit.)
fn eval_stmt(s: Stmt, env: [Binding]) -> Effect:
    match s:
        EmitEffect(event, fields) -> emit_to_effect(event, fields, env)

fn emit_to_effect(event: Text, fields: [FieldExpr], env: [Binding]) -> Effect:
    # Astra's Emit effect carries (event, payload). The Rust impl uses
    # a list of (String, Value) pairs; our Value enum lacks compound
    # types so we collapse to "the first field's value" for MVP. Full
    # n-field payload lands when astra_value adds a List variant.
    mut first_value = NoneV
    if len(fields) > 0:
        f = at(fields, 0)
        first_value = eval_expr(f.value, env)
    Emit(event, first_value)

fn eval_expr(e: Expr, env: [Binding]) -> Value:
    match e:
        LitInt(n) -> IntV(n)
        LitText(s) -> TextV(s)
        LitBool(b) -> BoolV(b)
        VarRef(name) -> lookup(env, name)

# Helper data — name+value pair for the environment.
pub data Binding: name: Text, value: Value
