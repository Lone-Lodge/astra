# astra_host - the boundary.
#
# The shape a host answers questions in. The core never reads the world
# itself: it hands out a HostQuery and the host looks the answer up. That
# is the whole seam today - atlas bridges the rest by hand in atlas_astra -
# so this orb is a type, not yet a protocol.


# `kind` is "lookup" against the host's store or "resolve" against its
# bundle map.
public type HostQuery: kind: text, entity: number, field: text

public define empty_query() -> HostQuery:
    HostQuery{kind: "lookup", entity: 0, field: ""}
