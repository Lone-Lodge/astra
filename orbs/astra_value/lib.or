# astra_value — the value universe.
#
# Four typed data (Int / Text / Bool / Ref) so the typechecker is a
# table lookup, not Hindley-Milner. Absence is Option, modeled here
# with an explicit `None` variant per type since Orion enums don't
# carry generics yet.

pub enum Value:
    IntV(int)
    TextV(Text)
    BoolV(bool)
    RefV(int)
    NoneV
