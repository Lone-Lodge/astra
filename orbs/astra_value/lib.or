# astra_value - the value universe.
#
# Four scalar types (Int / Text / Bool / Ref) so the typechecker is a
# table lookup, not Hindley-Milner. MapV gives us multi-field payloads
# (emit X { a: 1, b: 2 }) and is the shape M3 queries will return for
# entity records. Absence is Option, modeled here with an explicit
# `None` variant per type since Orion enums don't carry generics yet.

public type Value:
    IntV(number)
    TextV(text)
    BoolV(truth)
    RefV(number)
    MapV([ValueField])
    ListV([Value])
    NoneV

# A named slot inside a MapV. Field name is the source-level identifier
# (`tier` for `emit Milestone { tier: 100 }`); value can be any Value
# including another MapV - host bridges decide how deep to flatten.
public type ValueField: name: text, value: Value

# Deep copy - evacuates a call result out of the eval frame arena.
public define value_copy(v: Value) -> Value:
    choose v:
        IntV(n) then IntV(n)
        TextV(s) then TextV("" + s)
        BoolV(b) then BoolV(b)
        RefV(r) then RefV(r)
        MapV(fields) then MapV(copy_fields(fields, 0, []))
        ListV(items) then ListV(copy_items(items, 0, []))
        NoneV then NoneV

define copy_fields(fields: [ValueField], i: number, acc: [ValueField]) -> [ValueField]:
    if i >= length(fields):
        acc
    else:
        f = fields[i]
        copy_fields(fields, i + 1, append(acc, ValueField{name: "" + f.name, value: value_copy(f.value)}))

define copy_items(items: [Value], i: number, acc: [Value]) -> [Value]:
    if i >= length(items):
        acc
    else:
        copy_items(items, i + 1, append(acc, value_copy(items[i])))
