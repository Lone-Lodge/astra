# astra_ast — abstract syntax for rules.
#
# MVP scope: just enough to express a rule body of `emit` statements with
# literal-valued field payloads. Full grammar (Field/Call/binop/if/let/
# require/set/spawn/destroy) lands as we port the parser further.

use astra_value

# Expressions — literal-only MVP.
pub enum Expr:
    LitInt(int)
    LitText(Text)
    LitBool(bool)
    VarRef(Text)

# Statement = one effect a rule proposes.
# EmitEffect is `emit EventName { field: expr, ... }`.
pub enum Stmt:
    EmitEffect(Text, [FieldExpr])

# A `name: expr` pair inside an emit body.
pub data FieldExpr: name: Text, value: Expr

# A rule's parameters (currently unused — MVP rules take zero args).
pub data Param: name: Text, type_name: Text

# A whole rule.
pub data Rule: name: Text, params: [Param], body: [Stmt]
