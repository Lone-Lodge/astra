use astra_lexer
use astra_parser
use io

# Smoke: lex + parse a minimal astra rule, verify rule + emit body.

fn main() -> int:
    src = "rule fire(): emit Reset()"
    lex_result = lex(src)
    if not lex_result.ok:
        print_line("LEX FAIL")
        return 1
    parse_result = parse(lex_result.tokens)
    if not parse_result.ok:
        print_line("PARSE FAIL")
        print_line(parse_result.error.message)
        return 1
    mut rule_count = 0
    for _r in parse_result.rules:
        rule_count = rule_count + 1
    print_line("parsed rules:")
    print_line(show_int(rule_count))
    if rule_count > 0:
        r = at(parse_result.rules, 0)
        print_line("first rule name:")
        print_line(r.name)
        mut body_count = 0
        for _s in r.body:
            body_count = body_count + 1
        print_line("body stmts:")
        print_line(show_int(body_count))
    0

fn show_int(value: int) -> Text:
    if value == 0:
        "0"
    else:
        digits(value)

fn digits(value: int) -> Text:
    if value == 0:
        ""
    else:
        digits(value / 10) + glyph(value - (value / 10) * 10)

fn glyph(d: int) -> Text:
    if d == 0 then "0" else if d == 1 then "1" else if d == 2 then "2" else if d == 3 then "3" else if d == 4 then "4" else if d == 5 then "5" else if d == 6 then "6" else if d == 7 then "7" else if d == 8 then "8" else "9"
