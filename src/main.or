

define main() -> number:
    t_begin()

    section("dispatch & effects")
    # M1 regression
    src_rule = "rule scale(x): require x > 0 let d = x*2 emit Scaled()"
    check("rule scale(5) fires one effect", 1, eff_count(run(src_rule, "scale", [IntV(5)])))

    # M2: on-event dispatch
    src_handler = "on Click(x, y): require x > 0 emit Confirmed()"
    check("dispatch Click(10,20)", 1, eff_count(dispatch(src_handler, "Click", [IntV(10), IntV(20)])))
    check("dispatch Click(-1,20) refused", 0, eff_count(dispatch(src_handler, "Click", [IntV(0 - 1), IntV(20)])))

    # Multiple handlers for same event - both fire
    src_multi = "on Tick(): emit A()\non Tick(): emit B()"
    check("two Tick handlers both fire", 2, eff_count(dispatch(src_multi, "Tick", [])))

    section("reactive when / every")
    # M2.2: reactive `when` - edge-triggered milestones
    src_when = "when score >= 100: emit Milestone()"
    ctx_low = [Binding{name: "score", value: IntV(50)}]
    ctx_hit = [Binding{name: "score", value: IntV(100)}]
    t1 = tick(src_when, ctx_low, [])
    check("when score=50 silent", 0, eff_count(t1.outcome))
    t2 = tick(src_when, ctx_hit, t1.truths)
    check("when score=100 fires on edge", 1, eff_count(t2.outcome))
    t3 = tick(src_when, ctx_hit, t2.truths)
    check("when score=100 again is level, silent", 0, eff_count(t3.outcome))

    # M2.3: `every N` periodic - sugar for when(tick % N is 0)
    src_every = "every 3: emit Pulse()"
    # Walk ticks 0..6 and count fires per tick. Expected fire ticks: 0, 3, 6.
    edit prev = []
    edit total = 0
    loop t in 0 until 7:
        ctx_t = [Binding{name: "tick", value: IntV(t)}]
        r = tick(src_every, ctx_t, prev)
        total = total + eff_count(r.outcome)
        prev = r.truths
    check("every 3 over ticks 0..6 fires 3x", 3, total)

    section("fields, fn helpers, queries")
    # M2 multi-field: emit Place {col, row, color} carries all 3 fields.
    # Loaded from disk because Orion interpolates `{...}` inside string
    # literals, which would clobber the astra field-block syntax.
    src_mf = read_file("fixtures/multi_field.astra")
    out_mf = run(src_mf, "place", [])
    check("multi-field emit fires", 1, eff_count(out_mf))
    check("multi-field carries 3 fields", 3, first_effect_field_count(out_mf))

    # M2 fn helpers: rule body calls pure functions defined in same file
    src_fn = read_file("fixtures/fn_call.astra")
    check("double(7) via fn helper", 14, first_field_int(run(src_fn, "scaled", [IntV(7)])))
    check("pixel_to_col(220) via fn helper", 2, first_field_int(run(src_fn, "click", [IntV(220)])))

    # M3 queries: bind a ListV of entity-record MapVs into ctx, run
    # `count(x in items where x.field is value)` over it.
    src_q = read_file("fixtures/count_query.astra")
    ctx_q = [Binding{name: "items", value: ListV(build_items())}]
    check("count reds", 2, first_field_int(run_rule_in_ctx(src_q, "reds", ctx_q)))
    check("count row==3", 2, first_field_int(run_rule_in_ctx(src_q, "row3", ctx_q)))

    section("loops & spawn")
    # M3 bounded `for` - expands at parse time to N copies of the body
    # with iter var substituted. Verify only r=2 fires (the matching
    # `when r is 2:` rule).
    src_for = read_file("fixtures/for_loop.astra")
    fr1 = tick(src_for, [], [])
    check("for-loop cold tick fires only r=2", 1, eff_count(fr1.outcome))
    fr2 = tick(src_for, [], fr1.truths)
    check("for-loop second tick, no edges", 0, eff_count(fr2.outcome))

    # Typed Spawn: `entity Kind { ... }` + `spawn Kind { ... }` produces
    # AstraSpawnKind(kind, fields) which atlas routes to a per-kind
    # channel for the host to construct the real component.
    src_sp = read_file("fixtures/entity_spawn.astra")
    out_sp = run(src_sp, "make_block", [IntV(3), IntV(5)])
    check("spawn Block emits one effect", 1, eff_count(out_sp))
    check("spawn Block carries 3 fields", 3, spawn_field_count(out_sp))

    # Runtime foreach: on PlacePiece(col, row, color, cells) fans
    # `spawn Block` per cell. Pass a 4-cell square piece.
    src_fe = read_file("fixtures/foreach_spawn.astra")
    out_fe = dispatch(src_fe, "PlacePiece", [IntV(2), IntV(7), TextV("magenta"), ListV(build_square_cells())])
    check("PlacePiece foreach spawns 4", 4, eff_count(out_fe))

    section("let, params, literals, ranges")
    # Iter 16: implicit let-in (no `let` keyword)
    src_imp = read_file("fixtures/implicit_let.astra")
    check("implicit let double_plus(5)", 11, int_of_value(eval_fn(src_imp, "double_plus", [IntV(5)])))

    # Iter 18: type-free params + no fn keyword
    src_nt = read_file("fixtures/notypes.astra")
    check("type-free stack(3, 4)", 8, int_of_value(eval_fn(src_nt, "stack", [IntV(3), IntV(4)])))

    # Iter 5: list/map literals + eval_fn
    src_lit = read_file("fixtures/literals.astra")
    check("literals: records with a==2", 1, int_of_value(eval_fn(src_lit, "pick_a", [IntV(2)])))
    check("literals: records with a==99", 0, int_of_value(eval_fn(src_lit, "pick_a", [IntV(99)])))

    # from/through ranges (verification)
    src_rng = read_file("fixtures/range.astra")
    check("range from 1 to 5", 4, int_of_value(eval_fn(src_rng, "rng_to", [])))
    check("range 1 through 4", 4, int_of_value(eval_fn(src_rng, "rng_through", [])))
    check("range from 2 through 6", 5, int_of_value(eval_fn(src_rng, "rng_from_through", [])))

    section("typecheck, quantifiers, tests-as-syntax")
    # astra_check pass: well-formed bundle has 0 errors; a bundle with a
    # duplicate fn + an arity mismatch + an unknown call has 3.
    src_ok = "fn dbl(n): n * 2\nrule go(x): require dbl(x) > 0\nrule go2(x): require size([1, 2]) > 0"
    check("checker: clean bundle has 0 errors", 0, length(astra_check_source(src_ok)))
    src_bad = "fn dbl(n): n * 2\nfn dbl(n): n * 3\nrule go(x): require dbl(x, x) > 0\nrule bad(x): require missing(x) > 0"
    check("checker: bad bundle has 3 errors", 3, length(astra_check_source(src_bad)))

    # Exhaustive `when` over an enum state. A partial
    # equality-switch (a variant with no branch) is flagged; full coverage,
    # any non-` is ` reference, and an unswitched enum are all clean.
    src_when_partial = "state door: enum(Shut, Open, Locked) = Shut\nwhen door == Shut: emit A n: 1\nwhen door == Locked: emit B n: 1"
    check("when: partial enum switch warns (Open missing)", 1, length(astra_check_source(src_when_partial)))
    src_when_full = "state door: enum(Shut, Open, Locked) = Shut\nwhen door == Shut: emit A n: 1\nwhen door == Open: emit B n: 1\nwhen door == Locked: emit C n: 1"
    check("when: full enum switch is clean", 0, length(astra_check_source(src_when_full)))
    src_when_dyn = "state door: enum(Shut, Open, Locked) = Shut\nwhen door == Shut: emit A n: 1\nwhen door != Open: emit B n: 1"
    check("when: any non-== reference suppresses", 0, length(astra_check_source(src_when_dyn)))
    src_when_none = "state door: enum(Shut, Open, Locked) = Shut\nwhen ready: emit A n: 1"
    check("when: enum nobody switches on is clean", 0, length(astra_check_source(src_when_none)))

    # `all` universal quantifier: true only when every element satisfies COND.
    src_all = "fn allpos(): if all x in [2, 4, 6] where x > 0 then 1 else 0\nfn allneg(): if all x in [2, 0, 6] where x > 0 then 1 else 0"
    check("all x>0 over [2,4,6]", 1, int_of_value(eval_fn(src_all, "allpos", [])))
    check("all x>0 over [2,0,6]", 0, int_of_value(eval_fn(src_all, "allneg", [])))

    # `for` as an alias for `each` - same loop macro, both spellings.
    src_fora = read_file("fixtures/for_alias.astra")
    check("for-alias cold tick fires only r=2", 1, eff_count(tick(src_fora, [], []).outcome))

    # tests-as-syntax: `apply` a rule, read `effects`/`tick` in `expect`.
    src_tests = "rule scale(x): require x > 0 emit Scaled()\ntest a:\n    apply scale(5)\n    expect effects == 1\ntest b:\n    apply scale(0)\n    expect effects == 0\ntest c:\n    tick 3\n    expect tick == 3"
    tr = run_tests(src_tests)
    check("inline tests parsed", 3, length(tr))
    check("inline tests passed", 3, count_passed(tr))
    src_tfail = "rule scale(x): require x > 0 emit Scaled()\ntest bad:\n    apply scale(5)\n    expect effects == 2"
    check("failing inline test caught", 0, count_passed(run_tests(src_tfail)))

    section("intent, field access, if-stmt")
    # intent: utility scored into a resource per tick.
    src_intent = "intent FeedSelf for Worker:\n    require hunger > 50\n    utility hunger"
    out_hi = dispatch_ctx(src_intent, "Tick", [], [Binding{name: "hunger", value: IntV(60)}])
    check("intent applicable at hunger=60", 1, setvar_of(out_hi, "intent:FeedSelf:applicable"))
    check("intent score at hunger=60", 60, setvar_of(out_hi, "intent:FeedSelf:score"))
    out_lo = dispatch_ctx(src_intent, "Tick", [], [Binding{name: "hunger", value: IntV(40)}])
    check("intent score at hunger=40", 0, setvar_of(out_lo, "intent:FeedSelf:score"))

    # `.empty` field access - `empty` must lex as an identifier, not a keyword
    # A reserved `empty` would break the `.` access.
    src_empty = "rule check(cell): require cell.empty emit Ok()"
    cell_rec = MapV(append([], ValueField{name: "empty", value: IntV(1)}))
    check("cell.empty field access", 1, eff_count(run(src_empty, "check", [cell_rec])))

    # In-body `if cond: body` statement - a single-branch conditional inside
    # a rule body. Dispatched on the `if` keyword (not `when`, which delimits
    # top-level rules); the guarded emit fires only when the condition holds.
    src_ifstmt = "rule big(x): if x > 5: emit Big()"
    check("if-stmt guard true x=9", 1, eff_count(run(src_ifstmt, "big", [IntV(9)])))
    check("if-stmt guard false x=3", 0, eff_count(run(src_ifstmt, "big", [IntV(3)])))

    section("text: concat, interpolation, empty")
    # Text `+` concatenates when either side is text (was integer add,
    # which silently produced IntV(0) - every dynamic string in a
    # text-first game came out blank).
    check("text \"a\" + \"b\" == ab", 1, text_is("fn f() -> text:\n    \"a\" + \"b\"\n", [], "ab"))
    check("text \"n=\" + 7 == n=7", 1, text_is("fn f(n: int) -> text:\n    \"n=\" + n\n", [IntV(7)], "n=7"))
    check("text \"hi \" + x == hi world", 1, text_is("fn f(x: text) -> text:\n    \"hi \" + x\n", [TextV("world")], "hi world"))

    # String interpolation: "{expr}" holes expand at parse time.
    check("interp count-hole == count 3", 1, text_is("fn f(n: int) -> text:\n    \"count \{n\}\"\n", [IntV(3)], "count 3"))
    check("interp two holes == a=1 b=2", 1, text_is("fn f(a: int, b: int) -> text:\n    \"a=\{a\} b=\{b\}\"\n", [IntV(1), IntV(2)], "a=1 b=2"))
    check("interp expr-hole == sum=10", 1, text_is("fn f(n: int) -> text:\n    \"sum=\{n + 1\}\"\n", [IntV(9)], "sum=10"))

    # Empty string literal "" is a real Text, not a parse fall-through.
    check("empty string literal", 1, text_is("fn f() -> text:\n    \"\"\n", [], ""))

    section("declarations a host reads")
    # const: a named literal any expression can reach.
    src_const = "const MAXHP = 100\nfn cap(n: int) -> int: if n > MAXHP then MAXHP else n"
    check("const caps at 100", 100, int_of_value(eval_fn(src_const, "cap", [IntV(250)])))

    # law NAME: names the rule that follows, so a fact can cite it.
    src_law = "law Gravity:\nwhen falling: emit Fall()"
    check("law names one rule", 1, length(compiled_rules(src_law)))

    # A trait's fields inline into every type that uses it.
    src_trait = read_file("fixtures/trait_compose.astra")
    check("trait composes into a type", 1, length(compiled_type_traits(src_trait)))

    # source / asset / animate are boot-time declarations for the host.
    check("source declares one feed", 1, length(compiled_sources("source levels from file \"levels.json\"\n")))
    check("asset declares one file", 1, length(compiled_assets("asset hero: sprite \"hero.png\"\n")))
    check("animate declares one tween", 1, length(compiled_animations("animate fade from 0 to 100 over 2 s\n")))

    # patch evicts the command it overrides, so one rule survives.
    src_patch = read_file("fixtures/patch_command.astra")
    check("patch replaces its base command", 1, length(compiled_rules(src_patch)))

    section("statements and expressions")
    check("relate proposes one effect", 1, eff_count(run("rule own(a, b): relate a owns b", "own", [IntV(1), IntV(2)])))
    check("destroy proposes one effect", 1, eff_count(run("rule kill(e): destroy e", "kill", [IntV(7)])))
    check("signal proposes one effect", 1, eff_count(run("rule ping(): signal Ping()", "ping", [])))
    check("effect proposes one effect", 1, eff_count(run("rule minimise(): effect WindowMin()", "minimise", [])))

    src_match = "fn pick(x: int) -> int: match x: 1 -> 10, _ -> 0"
    check("match arm 1 gives 10", 10, int_of_value(eval_fn(src_match, "pick", [IntV(1)])))
    check("match wildcard gives 0", 0, int_of_value(eval_fn(src_match, "pick", [IntV(5)])))

    src_exists = "fn any_big() -> int: if exists x in [1, 2, 3] where x > 2 then 1 else 0"
    check("exists finds one over 2", 1, int_of_value(eval_fn(src_exists, "any_big", [])))

    # after / spawned / data / set / none - the last forms without a gate.
    check("after arms a delayed write", 2, eff_count(run("rule arm(): after 3: door = 1", "arm", [])))
    check("when spawned(T) is one rule", 1, length(compiled_rules("when spawned(Block):\n    emit Born()")))
    src_data = read_file("fixtures/data_table.astra")
    check("data table becomes one const", 1, length(compile_parse_result(src_data).consts))
    check("set writes one effect", 1, eff_count(run("rule s(): set hp = 5", "s", [])))
    src_none = "fn no_big() -> int: if none x in [1, 2] where x > 5 then 1 else 0"
    check("none finds nothing over 5", 1, int_of_value(eval_fn(src_none, "no_big", [])))

    section("fact and its family")
    # `fact N = E` is the one keyword: bare it is a view, `in goal` /
    # `in belief:WHO` place it elsewhere, `conf N` records a confidence.
    # Each spelling must land in the namespace the single keyword gave.
    f_view   = compile_parse_result("fact alive = health > 0\n")
    f_goal   = compile_parse_result("fact reach = score > 100 in goal\n")
    f_broken = compile_parse_result("fact wet = water > 0 in broken\n")
    f_belief = compile_parse_result("fact enemy_at = 3 in belief:Guard\n")
    f_conf   = compile_parse_result("fact enemy_at = 3 in belief:Guard conf 73\n")
    v_view   = compile_parse_result("view alive = health > 0\n")
    check("fact writes alive", 1, name_is(f_view, 0, "alive"))
    check("fact in goal writes goal:reach", 1, name_is(f_goal, 0, "goal:reach"))
    check("an unknown namespace is a constraint", 1, name_is(f_broken, 0, "constraint:wet"))
    check("fact in belief writes belief:Guard:enemy_at", 1, name_is(f_belief, 0, "belief:Guard:enemy_at"))
    check("conf writes a second target", 1, name_is(f_conf, 1, "conf:enemy_at"))
    check("bare fact is the view alias", 1, name_is(v_view, 0, "alive"))

    t_summary()

# First statement of the first rule a bundle parsed: the name it writes to.
# `fact` and `view` desugar to a SetVar per target, so the name IS the proof.
define name_is(pr: ParseResult, idx: number, want: text) -> number:
    if not pr.ok:
        0
    else:
        if length(pr.rules) is 0:
            0
        else:
            r = pr.rules[0]
            if idx >= length(r.body):
                0
            else:
                choose r.body[idx]:
                    SetVar(nm, _) then if nm is want then 1 else 0
                    _ then 0


# ── tiny test runner ─────────────────────────────────────────────────
# Colored PASS/FAIL rows + a pass/total summary, in the shape of Orion's
# own LLVM-backend runner. Counters live in slots so each check() is a
# one-liner (no mut state threaded through main). Exit code = fail count.

define ansi(code: text) -> text:
    "{text_of([27])}[{code}m"

define t_begin():
    slot_set("t:n", 0)
    slot_set("t:pass", 0)
    print_line("")
    print_line("  {ansi("1")}{ansi("36")}◆ astra{ansi("0")} {ansi("2")}test runner · eval + parse, native{ansi("0")}")
    print_line("  {ansi("2")}────────────────────────────────────────────────{ansi("0")}")

define section(title: text):
    print_line("")
    print_line("  {ansi("2")}{title}{ansi("0")}")

define check(label: text, expected: number, actual: number):
    n = slot_get_number("t:n") + 1
    slot_set("t:n", n)
    if actual is expected:
        slot_set("t:pass", slot_get_number("t:pass") + 1)
        print_line("    {ansi("32")}✓{ansi("0")} {label}")
    else:
        print_line("    {ansi("31")}✗ {label}{ansi("0")}  {ansi("2")}→ expected {expected}, got {actual}{ansi("0")}")

define t_summary() -> number:
    n = slot_get_number("t:n")
    p = slot_get_number("t:pass")
    f = n - p
    print_line("")
    print_line("  {ansi("2")}────────────────────────────────────────────────{ansi("0")}")
    if f is 0:
        print_line("  {ansi("1")}{ansi("32")}✓ all {p}/{n} passed{ansi("0")}")
    else:
        print_line("  {ansi("1")}{ansi("31")}✗ {f} failed{ansi("0")} {ansi("2")}({p}/{n} passed){ansi("0")}")
    print_line("")
    f

# 1 when eval_fn(src, "f", args) yields exactly TextV(expected).
define text_is(src: text, args: [Value], expected: text) -> number:
    choose eval_fn(src, "f", args):
        TextV(s) then if s is expected then 1 else 0
        _ then 0

define setvar_of(o: Outcome, name: text) -> number:
    edit found = 0 - 1
    loop e in o.effects:
        found = setvar_match(e, name, found)
    found

define setvar_match(e: AstraEffect, name: text, cur: number) -> number:
    choose e:
        AstraSetVar(nm, v) then if nm is name then int_of_value(v) else cur
        _ then cur

define count_passed(results: [TestResult]) -> number:
    edit c = 0
    loop r in results:
        if r.passed:
            c = c + 1
    c

# 2x2 square piece, encoded as MapV records {dc, dr}.
define build_square_cells() -> [Value]:
    a = cell_map(0, 0)
    b = cell_map(1, 0)
    c = cell_map(0, 1)
    d = cell_map(1, 1)
    append(append(append(append([], a), b), c), d)

define cell_map(dc: number, dr: number) -> Value:
    fields = append(append([], ValueField{name: "dc", value: IntV(dc)}), ValueField{name: "dr", value: IntV(dr)})
    MapV(fields)

# Pull the first effect, assert it's AstraSpawnKind, return field count.
define spawn_field_count(o: Outcome) -> number:
    if length(o.effects) is 0:
        0
    else:
        e = o.effects[0]
        choose e:
            AstraSpawnKind(_kind, fields) then length(fields)
            _ then 0

# Small helper: run a parameterless rule with a pre-built env. The
# regular `run` binds args to rule params; here we want free names
# (`items`) bound directly. We use `tick` semantics? No - that's `when`-
# only. Instead use the dispatch path with a synthetic event handler.
# Simpler: inject by re-using run() but with a paren-form rule that
# has no params; the rule body references the ctx names which are
# absent - fails. We have to plumb env into a named-rule call.
#
# Approach: write the fixtures so the rule takes `items` as a param,
# then pass [items] to run().
define run_rule_in_ctx(src: text, rule_name: text, ctx: [Binding]) -> Outcome:
    # Re-use the public `tick` machinery: dummy-source a `when true: emit ...`
    # would over-fire. Instead: call run() with the ctx bindings flattened
    # to positional args matching the rule's params, by name order. The
    # fixtures here use `items` as the first param so [items.value] works.
    args = ctx_values_in_order(ctx)
    run(src, rule_name, args)

define ctx_values_in_order(ctx: [Binding]) -> [Value]:
    n = length(ctx)
    edit out = []
    loop i in 0 until n:
        out = append(out, ctx[i].value)
    out

# Three synthetic entity records: two red (rows 3 and 5), one blue (row 3).
define build_items() -> [Value]:
    a = make_record("red", 3)
    b = make_record("red", 5)
    c = make_record("blue", 3)
    append(append(append([], a), b), c)

define make_record(color: text, row: number) -> Value:
    fields = append(append([], ValueField{name: "color", value: TextV(color)}), ValueField{name: "row", value: IntV(row)})
    MapV(fields)

define first_effect_field_count(o: Outcome) -> number:
    if length(o.effects) is 0:
        0
    else:
        e = o.effects[0]
        choose e:
            AstraEmit(_event, v) then map_value_size(v)
            _ then 0

define map_value_size(v: Value) -> number:
    choose v:
        MapV(entries) then length(entries)
        _ then 0

# Pull the first MapV entry's IntV out - used by fn-helper tests to
# assert the emitted payload value.
define first_field_int(o: Outcome) -> number:
    if length(o.effects) is 0:
        0 - 1
    else:
        e = o.effects[0]
        choose e:
            AstraEmit(_event, v) then first_map_int(v)
            _ then 0 - 1

define first_map_int(v: Value) -> number:
    choose v:
        MapV(entries) then if length(entries) is 0 then 0 - 1 else int_of_value(entries[0].value)
        _ then 0 - 1

define int_of_value(v: Value) -> number:
    choose v:
        IntV(n) then n
        _ then 0 - 1

define eff_count(o: Outcome) -> number:
    edit c = 0
    loop _e in o.effects:
        c = c + 1
    c

define show_int(value: number) -> text:
    if value is 0:
        "0"
    else:
        digits(value)

define digits(value: number) -> text:
    if value is 0:
        ""
    else:
        digits(value // 10) + glyph(value - (value // 10) * 10)

define glyph(d: number) -> text:
    if d is 0 then "0" else if d is 1 then "1" else if d is 2 then "2" else if d is 3 then "3" else if d is 4 then "4" else if d is 5 then "5" else if d is 6 then "6" else if d is 7 then "7" else if d is 8 then "8" else "9"
