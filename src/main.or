use astra_run
use astra_value
use astra_outcome
use io

# Full pipeline smoke: lex → parse → eval → Outcome.effects.
# Pure-Orion Astra MVP — first program where source text becomes
# proposed Effects through the lang.

fn main() -> int:
    # Avoid Orion's {...} string interpolation by using the parenless emit form.
    src = "rule on_click(x, y): emit PlaceBlock()"
    args = [IntV(3), IntV(7)]
    outcome = run(src, "on_click", args)
    mut count = 0
    for _e in outcome.effects:
        count = count + 1
    print_line("effects produced:")
    print_line(show_int(count))
    if count > 0:
        first = at(outcome.effects, 0)
        print_line(describe_effect(first))
    0

fn describe_effect(e: Effect) -> Text:
    match e:
        Emit(_event, _value) -> "emit"
        Spawn(_id) -> "spawn"
        Destroy(_id) -> "destroy"
        Set(_eid, _field, _v) -> "set"

fn show_int(value: int) -> Text:
    if value == 0:
        "0"
    else:
        digits(value)

fn digits(value: int) -> Text:
    if value == 0:
        ""
    else:
        digits(value / 10) + glyph(value - (value / 10) * 10)

fn glyph(d: int) -> Text:
    if d == 0 then "0" else if d == 1 then "1" else if d == 2 then "2" else if d == 3 then "3" else if d == 4 then "4" else if d == 5 then "5" else if d == 6 then "6" else if d == 7 then "7" else if d == 8 then "8" else "9"
