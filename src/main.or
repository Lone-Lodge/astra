use astra_run
use astra_value
use astra_outcome
use io

# M1 smoke: a rule with binops, let-binding, require-guard, and an
# emit whose payload comes from a computed expression.

fn main() -> int:
    # Test 1: rule fires when x > 0; payload = x * 2.
    # Multi-line via concat to dodge Orion's {...} string interp.
    src = "rule scale(x): require x > 0 let doubled = x * 2 emit Scaled" + "(" + ")"
    test_one(src, "scale", [IntV(5)], "x=5 → expects 1 effect")
    test_one(src, "scale", [IntV(0)], "x=0 → expects 0 effects (refused)")
    test_one(src, "scale", [IntV(0 - 3)], "x=-3 → expects 0 effects (refused)")
    # Test 2: if-then-else expression.
    src2 = "rule check(n): require if n > 10 then true else false emit Big()"
    test_one(src2, "check", [IntV(20)], "n=20 → expects 1 effect")
    test_one(src2, "check", [IntV(5)], "n=5 → expects 0 effects")
    0

fn test_one(src: Text, rule: Text, args: [Value], label: Text):
    print_line(label)
    outcome = run(src, rule, args)
    mut count = 0
    for _e in outcome.effects:
        count = count + 1
    print_line("  effects:")
    print_line(show_int(count))

fn show_int(value: int) -> Text:
    if value == 0:
        "0"
    else:
        digits(value)

fn digits(value: int) -> Text:
    if value == 0:
        ""
    else:
        digits(value / 10) + glyph(value - (value / 10) * 10)

fn glyph(d: int) -> Text:
    if d == 0 then "0" else if d == 1 then "1" else if d == 2 then "2" else if d == 3 then "3" else if d == 4 then "4" else if d == 5 then "5" else if d == 6 then "6" else if d == 7 then "7" else if d == 8 then "8" else "9"
