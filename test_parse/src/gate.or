
# st_fact gate - standalone so it does not depend on the
# read_file-based file tests in main.or (whose `io` wildcard does not resolve
# read_file in this environment; unrelated to the `fact` change). Verifies the
# new `fact` keyword desugars into the SAME namespaces the individual keywords
# already emit, and that `fact N = E` is identical to the `view N = E` alias.

define setvar_name(r: Rule, idx: number) -> text:
    if idx >= length(r.body):
        "<oob>"
    else:
        choose r.body[idx]:
            SetVar(nm, _) then nm
            _ then "<not-setvar>"

define main() -> number:
    print_line("=== st_fact gate ===")
    f_view   = compile_parse_result("fact alive = health > 0\n")
    f_goal   = compile_parse_result("fact reach = score > 100 in goal\n")
    f_broken = compile_parse_result("fact wet = water > 0 in broken\n")
    f_belief = compile_parse_result("fact enemy_at = 3 in belief:Guard\n")
    f_conf   = compile_parse_result("fact enemy_at = 3 in belief:Guard conf 73\n")

    print_line("view   ok/target/trigger (want true / alive / $derive):")
    print_line(f_view.ok)
    print_line(setvar_name(f_view.rules[0], 0))
    print_line(f_view.rules[0].trigger)
    print_line("goal   ok/target (want true / goal:reach):")
    print_line(f_goal.ok)
    print_line(setvar_name(f_goal.rules[0], 0))
    print_line("broken ok/target (want true / constraint:wet):")
    print_line(f_broken.ok)
    print_line(setvar_name(f_broken.rules[0], 0))
    print_line("belief ok/target (want true / belief:Guard:enemy_at):")
    print_line(f_belief.ok)
    print_line(setvar_name(f_belief.rules[0], 0))
    print_line("conf   ok/body-len/conf-target (want true / 2 / conf:enemy_at):")
    print_line(f_conf.ok)
    print_line(length(f_conf.rules[0].body))
    print_line(setvar_name(f_conf.rules[0], 1))

    v_view = compile_parse_result("view alive = health > 0\n")
    same = setvar_name(f_view.rules[0], 0) is setvar_name(v_view.rules[0], 0) and f_view.rules[0].trigger is v_view.rules[0].trigger
    print_line("fact == view alias identical (want true):")
    print_line(same)
    print_line("=== done ===")
    0
